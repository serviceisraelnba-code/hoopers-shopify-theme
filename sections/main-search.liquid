<script>
  (function() {
    var sections = document.querySelectorAll('[data-hh-search-recent-section]');
    if (!sections.length) return;

    function escapeHtml(value) {
      return String(value || '').replace(/[&<>"']/g, function(character) {
        return {
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#039;'
        }[character];
      });
    }

    function readRecent() {
      try {
        var items = JSON.parse(window.localStorage.getItem('hoopers_recently_viewed_products') || '[]');
        return Array.isArray(items) ? items : [];
      } catch (error) {
        return [];
      }
    }

    function renderRecent() {
      var items = readRecent().filter(function(item) {
        return item && item.url && item.title;
      }).slice(0, 4);

      sections.forEach(function(section) {
        var target = section.querySelector('[data-hh-search-recent-items]');
        if (!target || !items.length) {
          section.hidden = true;
          return;
        }

        target.innerHTML = items.map(function(item) {
          var title = escapeHtml(item.title);
          var image = item.image
            ? '<span class="hh-search-recent-card__image"><img src="' + escapeHtml(item.image) + '" alt="' + title + '" loading="lazy"></span>'
            : '<span class="hh-search-recent-card__image"></span>';
          return '<a class="hh-search-recent-card" href="' + escapeHtml(item.url) + '" data-search-action="recently-viewed">' +
            image +
            '<span class="hh-search-recent-card__title">' + title + '</span>' +
            '<span class="hh-search-recent-card__price">' + escapeHtml(item.price || '') + '</span>' +
          '</a>';
        }).join('');

        section.hidden = false;
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', renderRecent);
    } else {
      renderRecent();
    }
  })();
</script>

