{%- liquid
  assign search_terms = search.terms | default: ''
  assign has_search = search.performed
  assign result_count = search.results_count | default: 0
  assign paginate_by = section.settings.per_row | times: section.settings.rows_per_page
  assign query_downcase = search_terms | downcase
  assign active_filter_count = 0

  for filter in search.filters
    assign filter_param_name = filter.param_name | default: ''
    assign filter_label_downcase = filter.label | downcase
    assign skip_filter_count = false

    if filter_param_name == 'filter.v.availability' or filter_label_downcase contains 'availability' or filter_label_downcase contains 'מלאי'
      assign skip_filter_count = true
    endif

    unless skip_filter_count
      assign active_filter_count = active_filter_count | plus: filter.active_values.size
      if filter.type == 'price_range'
        if filter.min_value.value != blank or filter.max_value.value != blank
          assign active_filter_count = active_filter_count | plus: 1
        endif
      endif
    endunless
  endfor

  assign intent_title = ''
  assign intent_text = ''
  assign intent_link = ''
  assign intent_button = ''

  if has_search and search_terms != blank
    if query_downcase contains 'jordan'
      assign intent_title = 'Looking for Jordan?'
      assign intent_text = 'עברו ישירות לקולקציית Jordan כדי לראות את כל הדגמים במקום אחד.'
      assign intent_link = '/collections/jordan'
      assign intent_button = 'View Jordan Collection'
    elsif query_downcase contains 'fear' or query_downcase contains 'fog'
      assign intent_title = 'Looking for Fear Of God?'
      assign intent_text = 'כל פריטי Fear Of God מחכים לכם בקולקציה אחת נקייה.'
      assign intent_link = '/collections/fog'
      assign intent_button = 'View Fear Of God'
    elsif query_downcase contains 'world' or query_downcase contains 'מונדיאל'
      assign intent_title = 'Looking for World Cup?'
      assign intent_text = 'עברו לקולקציית המונדיאל לכל הנבחרות והחולצות.'
      assign intent_link = '/collections/מונדיאל'
      assign intent_button = 'View World Cup'
    elsif query_downcase contains 'kids' or query_downcase contains 'ילדים'
      assign intent_title = 'Looking for Kids?'
      assign intent_text = 'כל פריטי הילדים של HOOPERS מרוכזים כאן.'
      assign intent_link = '/collections/ילדים'
      assign intent_button = 'View Kids Collection'
    elsif query_downcase contains 'lakers' or query_downcase contains 'לייקרס'
      assign intent_title = 'Looking for Lakers?'
      assign intent_text = 'מצאו את כל פריטי Los Angeles Lakers בקולקציה אחת.'
      assign intent_link = '/collections/לוס-אנגלס-לייקרס'
      assign intent_button = 'View Lakers'
    elsif query_downcase contains 'golden' or query_downcase contains 'warriors' or query_downcase contains 'גולדן'
      assign intent_title = 'Looking for Golden State?'
      assign intent_text = 'עברו ישירות לקולקציית Golden State Warriors.'
      assign intent_link = '/collections/גולדן-סטייט-ווריוס'
      assign intent_button = 'View Warriors'
    endif
  endif

  assign best_sellers_collection = collections['הנמכרים-ביותר']
  if best_sellers_collection == blank
    assign best_sellers_collection = collections['best-sellers']
  endif

  assign show_best_sellers = false
  if best_sellers_collection != blank and best_sellers_collection.products_count > 0
    if result_count == 0 or result_count < 4
      assign show_best_sellers = true
    endif
  endif
-%}

<section class="hh-search-results-page" data-section-id="{{ section.id }}" data-section-type="collection-grid">
  <div class="hh-search-results-page__hero">
    <div class="page-width">
      {%- render 'breadcrumbs' -%}

      <div class="hh-search-results-page__header">
        <p class="hh-search-results-page__kicker">{{ section.settings.kicker }}</p>
        <h1 class="hh-search-results-page__title">
          {%- if has_search and search_terms != blank -%}
            {{ section.settings.results_title }}
          {%- else -%}
            {{ section.settings.default_title }}
          {%- endif -%}
        </h1>

        {%- if has_search and search_terms != blank -%}
          <p class="hh-search-results-page__summary">
            {{ result_count }} תוצאות עבור <span>{{ search_terms | escape }}</span>
          </p>
        {%- else -%}
          <p class="hh-search-results-page__summary">{{ section.settings.intro_text }}</p>
        {%- endif -%}

        <form class="hh-search-results-page__form" action="{{ routes.search_url }}" method="get" role="search">
          <label class="hidden-label" for="SearchPageInput-{{ section.id }}">{{ 'general.search.placeholder' | t }}</label>
          <input
            id="SearchPageInput-{{ section.id }}"
            class="hh-search-results-page__input"
            type="search"
            name="q"
            value="{{ search_terms | escape }}"
            placeholder="{{ section.settings.search_placeholder }}"
            autocorrect="off"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
          >
          <input type="hidden" name="type" value="product">
          <button class="hh-search-results-page__button" type="submit">
            {{ section.settings.search_button_text }}
          </button>
        </form>

        <nav class="hh-search-results-page__popular" aria-label="Popular searches">
          <span>חיפושים פופולריים</span>
          <a href="{{ routes.search_url }}?q={{ 'דני אבדיה' | url_encode }}&type=product">דני אבדיה</a>
          <a href="/collections/jordan">Jordan</a>
          <a href="/collections/fog">Fear Of God</a>
          <a href="/collections/מונדיאל">World Cup</a>
          <a href="/collections/ילדים">Kids</a>
          <a href="/collections/לוס-אנגלס-לייקרס">Lakers</a>
          <a href="/collections/גולדן-סטייט-ווריוס">Golden State</a>
        </nav>
      </div>
    </div>
  </div>

  <div class="hh-search-results-page__body">
    <div class="page-width">
      {%- if has_search -%}
        {%- if result_count > 0 -%}
          {%- paginate search.results by paginate_by -%}
            <div id="CollectionAjaxContent" class="hh-search-results-page__layout" data-scroll-to>
              <aside class="hh-search-results-page__sidebar">
                {%- render 'collection-grid-filters',
                  collection: search,
                  enable_sidebar: section.settings.enable_sidebar,
                  filter_style: section.settings.filter_style,
                  collapsed: section.settings.collapsed,
                  enable_color_swatches: section.settings.enable_color_swatches
                -%}
              </aside>

              <div class="hh-search-results-page__content">
                <div class="hh-search-discovery">
                  {%- if intent_link != blank -%}
                    <a class="hh-search-intent" href="{{ intent_link }}" data-search-action="intent-collection">
                      <span class="hh-search-intent__eyebrow">Suggested collection</span>
                      <strong>{{ intent_title }}</strong>
                      <span>{{ intent_text }}</span>
                      <em>{{ intent_button }} →</em>
                    </a>
                  {%- endif -%}

                  <div class="hh-search-collection-strip" aria-label="Suggested collections">
                    <span>Suggested paths</span>
                    <a href="/collections/גופיות" data-search-action="collection-suggestion">גופיות NBA</a>
                    <a href="/collections/המכנסיים-שלנו" data-search-action="collection-suggestion">מכנסיים</a>
                    <a href="/collections/מונדיאל" data-search-action="collection-suggestion">World Cup</a>
                    <a href="/collections/fog" data-search-action="collection-suggestion">Fear Of God</a>
                    <a href="/collections/jordan" data-search-action="collection-suggestion">Jordan</a>
                    <a href="/collections/ילדים" data-search-action="collection-suggestion">Kids</a>
                  </div>

                  <div class="hh-search-team-strip" aria-label="NBA team shortcuts">
                    <span>Shop by team</span>
                    <a href="/collections/לוס-אנגלס-לייקרס" data-search-action="team-shortcut">Lakers</a>
                    <a href="/collections/גולדן-סטייט-ווריוס" data-search-action="team-shortcut">Golden State</a>
                    <a href="/collections/בוסטון-סלטיקס" data-search-action="team-shortcut">Boston</a>
                    <a href="/collections/ניו-יורק-ניקס" data-search-action="team-shortcut">New York</a>
                    <a href="/collections/שיקגו-בולס" data-search-action="team-shortcut">Chicago</a>
                  </div>

                  {%- capture search_filter_base_url -%}{{ routes.search_url }}?q={{ search_terms | url_encode }}&type=product{%- endcapture -%}
                  {%- render 'hoopers-product-type-chips',
                    filter_source: search,
                    context: 'search',
                    fallback_base_url: search_filter_base_url
                  -%}

                  {%- if active_filter_count > 0 -%}
                    <div class="hh-search-active-filters" aria-label="Active filters">
                      <span>מסננים פעילים</span>
                      {%- for filter in search.filters -%}
                        {%- liquid
                          assign filter_param_name = filter.param_name | default: ''
                          assign filter_label_downcase = filter.label | downcase
                          assign skip_filter_chip = false

                          if filter_param_name == 'filter.v.availability' or filter_label_downcase contains 'availability' or filter_label_downcase contains 'מלאי'
                            assign skip_filter_chip = true
                          endif
                        -%}

                        {%- unless skip_filter_chip -%}
                          {%- for filter_value in filter.active_values -%}
                            <a href="{{ filter_value.url_to_remove }}" data-search-action="remove-filter">
                              {{ filter_value.label | escape }} <b aria-hidden="true">×</b>
                            </a>
                          {%- endfor -%}

                          {%- if filter.type == 'price_range' -%}
                            {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
                              <a href="{{ filter.url_to_remove }}" data-search-action="remove-filter">
                                {%- if filter.min_value.value != blank -%}{{ filter.min_value.value | money_without_trailing_zeros }}{%- else -%}₪0{%- endif -%}
                                –
                                {%- if filter.max_value.value != blank -%}{{ filter.max_value.value | money_without_trailing_zeros }}{%- else -%}{{ filter.range_max | money_without_trailing_zeros }}{%- endif -%}
                                <b aria-hidden="true">×</b>
                              </a>
                            {%- endif -%}
                          {%- endif -%}
                        {%- endunless -%}
                      {%- endfor -%}
                      <a class="hh-search-active-filters__clear" href="{{ routes.search_url }}?q={{ search_terms | url_encode }}&type=product" data-search-action="clear-filters">
                        Clear all
                      </a>
                    </div>
                  {%- endif -%}
                </div>

                {% render 'collection-grid',
                  collection: search,
                  items: search.results,
                  enable_sidebar: section.settings.enable_sidebar,
                  filter_style: section.settings.filter_style,
                  enable_sort: true,
                  enable_collection_count: true,
                  per_row: section.settings.per_row,
                  mobile_flush_grid: section.settings.mobile_flush_grid,
                  quick_shop_enable: false
                %}

                {%- if paginate.pages > 1 -%}
                  {%- render 'pagination', paginate: paginate -%}
                {%- endif -%}

                {%- if show_best_sellers -%}
                  <section class="hh-search-recovery" aria-label="Best sellers">
                    <div class="hh-search-recovery__header">
                      <span>Still browsing?</span>
                      <h2>HOOPERS Best Sellers</h2>
                      <a href="{{ best_sellers_collection.url }}">View all</a>
                    </div>
                    <div class="grid grid--uniform">
                      {%- for product in best_sellers_collection.products limit: 4 -%}
                        {%- render 'product-grid-item',
                          product: product,
                          per_row: 4,
                          quick_shop_enable: false
                        -%}
                      {%- endfor -%}
                    </div>
                  </section>
                {%- endif -%}

                <section
                  class="hh-search-recent"
                  data-hh-search-recent-section
                  hidden
                >
                  <div class="hh-search-recovery__header">
                    <span>Recently viewed</span>
                    <h2>להמשיך מאיפה שעצרתם</h2>
                  </div>
                  <div class="hh-search-recent__grid" data-hh-search-recent-items></div>
                </section>
              </div>
            </div>
          {%- endpaginate -%}
        {%- else -%}
          <div class="hh-search-results-page__empty">
            <p class="hh-search-results-page__empty-kicker">{{ section.settings.empty_kicker }}</p>
            <h2>לא מצאנו תוצאות עבור "{{ search_terms | escape }}"</h2>
            <p>נסו חיפוש אחר או עברו לאחת הקולקציות הפופולריות.</p>
            <div class="hh-search-results-page__quick-links" aria-label="Suggested searches">
              <a href="{{ routes.search_url }}?q={{ 'דני אבדיה' | url_encode }}&type=product">דני אבדיה</a>
              <a href="/collections/לוס-אנגלס-לייקרס">Lakers</a>
              <a href="/collections/גולדן-סטייט-ווריוס">Golden State</a>
              <a href="/collections/all">SHOP ALL</a>
              <a href="/collections/jordan">JORDAN</a>
              <a href="/collections/fog">FEAR OF GOD</a>
              <a href="/collections/מונדיאל">WORLD CUP</a>
              <a href="/collections/ילדים">KIDS</a>
            </div>

            {%- if show_best_sellers -%}
              <section class="hh-search-recovery hh-search-recovery--empty" aria-label="Best sellers">
                <div class="hh-search-recovery__header">
                  <span>Try these instead</span>
                  <h2>HOOPERS Best Sellers</h2>
                  <a href="{{ best_sellers_collection.url }}">View all</a>
                </div>
                <div class="grid grid--uniform">
                  {%- for product in best_sellers_collection.products limit: 4 -%}
                    {%- render 'product-grid-item',
                      product: product,
                      per_row: 4,
                      quick_shop_enable: false
                    -%}
                  {%- endfor -%}
                </div>
              </section>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="hh-search-results-page__empty">
          <p class="hh-search-results-page__empty-kicker">{{ section.settings.empty_kicker }}</p>
          <h2>{{ section.settings.default_title }}</h2>
          <p>{{ section.settings.intro_text }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- if section.settings.enable_sidebar == false or section.settings.filter_style == 'drawer' -%}
  <style>
    .hh-search-results-page .hh-search-results-page__sidebar { display: none; }
    .hh-search-results-page .hh-search-results-page__content { min-width: 0; width: 100%; }
  </style>
{%- endif -%}

<style>
  .hh-search-results-page {
    --hh-bg: #ece7df;
    --hh-card: #f5f3ee;
    --hh-black: #050505;
    --hh-text: #111111;
    --hh-muted: rgba(17, 17, 17, 0.62);
    --hh-border: rgba(17, 17, 17, 0.12);
    --hh-gold: #c8a56a;

    background: var(--hh-bg);
    color: var(--hh-text);
    direction: rtl;
  }

  .hh-search-results-page .page-width {
    max-width: 1840px;
    padding-left: clamp(10px, 1.5vw, 26px);
    padding-right: clamp(10px, 1.5vw, 26px);
  }

  .hh-search-results-page__hero {
    background:
      radial-gradient(circle at 18% 0%, rgba(200, 165, 106, 0.16), transparent 32%),
      linear-gradient(135deg, #050505 0%, #12100d 100%);
    color: #fff;
    padding: clamp(28px, 4vw, 56px) 0 clamp(34px, 5vw, 72px);
  }

  .hh-search-results-page__hero .breadcrumb,
  .hh-search-results-page__hero .breadcrumb a {
    color: rgba(255, 255, 255, 0.66);
  }

  .hh-search-results-page__header {
    display: grid;
    gap: 15px;
    max-width: 1080px;
    margin: clamp(18px, 4vw, 44px) auto 0;
    text-align: center;
  }

  .hh-search-results-page__kicker,
  .hh-search-results-page__empty-kicker {
    margin: 0;
    color: var(--hh-gold);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .hh-search-results-page__title {
    margin: 0;
    color: #fff;
    font-size: clamp(38px, 6vw, 86px);
    line-height: 0.98;
    font-weight: 950;
    letter-spacing: 0;
  }

  .hh-search-results-page__summary {
    max-width: 720px;
    margin: 0 auto;
    color: rgba(255, 255, 255, 0.76);
    font-size: clamp(15px, 1.5vw, 18px);
    font-weight: 700;
    line-height: 1.7;
  }

  .hh-search-results-page__summary span {
    color: #fff;
    font-weight: 900;
  }

  .hh-search-results-page__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
    width: min(840px, 100%);
    margin: 12px auto 0;
    padding: 7px;
    border: 1px solid rgba(200, 165, 106, 0.42);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.09);
    backdrop-filter: blur(10px);
    box-shadow: 0 18px 52px rgba(0, 0, 0, 0.28);
  }

  .hh-search-results-page__input {
    min-height: 50px;
    width: 100%;
    padding: 0 18px 0 10px;
    border: 0;
    background: transparent;
    color: #fff;
    font-size: 16px;
    font-weight: 800;
    outline: none;
  }

  .hh-search-results-page__input::placeholder {
    color: rgba(255, 255, 255, 0.48);
  }

  .hh-search-results-page__button {
    min-height: 50px;
    padding: 0 28px;
    border: 1px solid rgba(200, 165, 106, 0.72);
    border-radius: 999px;
    background: var(--hh-gold);
    color: #050505;
    font-size: 12px;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 180ms ease, background 180ms ease, color 180ms ease;
  }

  .hh-search-results-page__button:hover {
    transform: translateY(-1px);
    background: #fff;
    color: #050505;
  }

  .hh-search-results-page__popular {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    width: min(980px, 100%);
    margin: 3px auto 0;
  }

  .hh-search-results-page__popular span {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    color: rgba(255, 255, 255, 0.5);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hh-search-results-page__popular a {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    padding: 0 12px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.82);
    font-size: 12px;
    font-weight: 850;
    line-height: 1;
    text-decoration: none;
    transition: border-color 180ms ease, color 180ms ease, background 180ms ease;
  }

  .hh-search-results-page__popular a:hover {
    border-color: rgba(200, 165, 106, 0.68);
    background: rgba(200, 165, 106, 0.12);
    color: #fff;
  }

  .hh-search-results-page__body {
    padding: clamp(24px, 3vw, 44px) 0 clamp(48px, 6vw, 86px);
  }

  .hh-search-results-page__layout {
    display: grid;
    grid-template-columns: minmax(214px, 232px) minmax(0, 1fr);
    gap: clamp(14px, 1.7vw, 26px);
    align-items: start;
  }

  html[dir="rtl"] .hh-search-results-page__layout,
  .hh-search-results-page__layout {
    direction: rtl;
  }

  .hh-search-results-page__sidebar {
    min-width: 0;
  }

  .hh-search-results-page__content {
    min-width: 0;
  }

  .hh-search-results-page .collection-filter {
    margin-bottom: clamp(16px, 1.8vw, 24px);
    padding: 12px 14px;
    border: 1px solid var(--hh-border);
    border-color: var(--hh-border);
    background: var(--hh-card);
    color: var(--hh-text);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hh-search-results-page .collection-filter__item,
  .hh-search-results-page .collection-filter select,
  .hh-search-results-page .collection-filter button {
    color: var(--hh-text);
  }

  .hh-search-results-page .collection-filter__item--count {
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--hh-muted);
  }

  .hh-search-results-page .collection-filter__item--sort {
    margin-inline-start: auto;
  }

  .hh-search-results-page .collection-filter__item--drawer .btn {
    min-height: 42px;
    padding: 0 16px;
    border: 1px solid rgba(17, 17, 17, 0.14);
    background: var(--hh-black);
    color: #fff;
    font-size: 11px;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hh-search-results-page .collection-filter__item--drawer .btn .icon {
    color: var(--hh-gold);
  }

  .hh-search-results-page .collection-filter__sort-container {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hh-search-results-page .collection-filter__sort-container::before {
    content: "SORT";
    color: var(--hh-muted);
    font-size: 10px;
    font-weight: 950;
    letter-spacing: 0.16em;
  }

  .hh-search-results-page .collection-filter__sort-container::after {
    content: "";
    position: absolute;
    left: 12px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-left: 2px solid var(--hh-gold);
    border-bottom: 2px solid var(--hh-gold);
    pointer-events: none;
    transform: translateY(-64%) rotate(-45deg);
  }

  .hh-search-results-page .collection-filter__sort-container select {
    appearance: none;
    -webkit-appearance: none;
    border-color: var(--hh-border);
    background-color: var(--hh-card);
    color: var(--hh-text);
    font-weight: 800;
    min-height: 42px;
    min-width: 188px;
    padding: 0 14px 0 34px;
    border-radius: 0;
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  .hh-search-results-page .collection-sidebar {
    position: sticky;
    top: 94px;
    padding: 16px;
    border: 1px solid var(--hh-border);
    background: var(--hh-card);
    box-shadow: 0 18px 50px rgba(17, 17, 17, 0.05);
  }

  .hh-search-results-page .collection-sidebar__group {
    border-color: var(--hh-border);
  }

  .hh-search-results-page .tag-list__header,
  .hh-search-results-page .collapsible-trigger-btn {
    color: var(--hh-text);
    font-size: 11px;
    font-weight: 950;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hh-search-results-page .tag__text,
