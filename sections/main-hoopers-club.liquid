{%- liquid
  assign section_id = 'hoopers-club-' | append: section.id
-%}

<style>
  #{{ section_id }} {
    --club-black: #050505;
    --club-ink: #111111;
    --club-cream: #f7f2e8;
    --club-white: #ffffff;
    --club-muted: rgba(17, 17, 17, 0.62);
    --club-muted-dark: rgba(255, 255, 255, 0.68);
    --club-gold: #c8a56a;
    --club-border: rgba(5, 5, 5, 0.1);
    background: var(--club-cream);
    color: var(--club-ink);
    direction: rtl;
  }

  #{{ section_id }} * {
    box-sizing: border-box;
  }

  #{{ section_id }} .club-page-width {
    width: min(100%, 1320px);
    margin: 0 auto;
    padding: 0 18px;
  }

  #{{ section_id }} .club-hero {
    position: relative;
    min-height: clamp(520px, 70vh, 720px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--club-black);
    color: var(--club-white);
  }

  #{{ section_id }} .club-hero__media {
    position: relative;
    z-index: 2;
    min-height: clamp(360px, 48vw, 560px);
    overflow: hidden;
    border: 1px solid rgba(200, 165, 106, 0.26);
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02)),
      #111;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.34);
  }

  #{{ section_id }} .club-hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(5, 5, 5, 0.08), rgba(5, 5, 5, 0.58));
    pointer-events: none;
  }

  #{{ section_id }} .club-hero__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #{{ section_id }} .club-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(5, 5, 5, 0.16), rgba(5, 5, 5, 0.92)),
      radial-gradient(circle at 18% 18%, rgba(200, 165, 106, 0.16), transparent 34%);
    pointer-events: none;
  }

  #{{ section_id }} .club-hero__grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(320px, 0.72fr);
    gap: clamp(22px, 4vw, 62px);
    align-items: center;
    width: 100%;
    padding: clamp(64px, 9vw, 112px) 0 clamp(44px, 6vw, 76px);
  }

  #{{ section_id }} .club-hero__grid--text-only {
    grid-template-columns: 1fr;
  }

  #{{ section_id }} .club-hero__content {
    position: relative;
    z-index: 2;
    width: min(100%, 780px);
  }

  #{{ section_id }} .club-kicker {
    margin: 0 0 16px;
    color: var(--club-gold);
    font-size: 11px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  #{{ section_id }} .club-hero__title {
    margin: 0;
    color: var(--club-white);
    font-size: clamp(48px, 8vw, 104px);
    line-height: 0.88;
    font-weight: 950;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  #{{ section_id }} .club-hero__subtitle {
    max-width: 740px;
    margin: 22px 0 0;
    color: var(--club-muted-dark);
    font-size: clamp(16px, 2.3vw, 23px);
    line-height: 1.55;
    font-weight: 650;
  }

  #{{ section_id }} .club-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    margin-top: 28px;
    padding: 0 22px;
    border: 1px solid rgba(200, 165, 106, 0.72);
    background: var(--club-white);
    color: var(--club-black);
    font-size: 12px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 180ms ease, background 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  #{{ section_id }} .club-button:hover,
  #{{ section_id }} .club-button:focus-visible {
    transform: translateY(-2px);
    border-color: var(--club-gold);
    background: var(--club-gold);
    color: var(--club-black);
  }

  #{{ section_id }} .club-button--dark {
    background: var(--club-black);
    color: var(--club-white);
  }

  #{{ section_id }} .club-section {
    padding: clamp(42px, 6vw, 76px) 0;
  }

  #{{ section_id }} .club-section--dark {
    background: var(--club-black);
    color: var(--club-white);
  }

  #{{ section_id }} .club-section__head {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: 24px;
    align-items: end;
    margin-bottom: 26px;
  }

  #{{ section_id }} .club-section__title {
    margin: 0;
    font-size: clamp(30px, 5vw, 58px);
    line-height: 0.95;
    font-weight: 950;
    letter-spacing: 0.02em;
  }

  #{{ section_id }} .club-section__text {
    margin: 0;
    color: var(--club-muted);
    font-size: 15px;
    line-height: 1.65;
    font-weight: 700;
  }

  #{{ section_id }} .club-section--dark .club-section__text {
    color: var(--club-muted-dark);
  }

  #{{ section_id }} .club-benefits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  #{{ section_id }} .club-benefit {
    min-height: 190px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid var(--club-border);
    background: var(--club-white);
    padding: 22px;
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }

  #{{ section_id }} .club-benefit:hover {
    transform: translateY(-4px);
    border-color: rgba(200, 165, 106, 0.58);
    box-shadow: 0 18px 44px rgba(5, 5, 5, 0.08);
  }

  #{{ section_id }} .club-benefit__label {
    margin: 0;
    color: var(--club-gold);
    font-size: 10px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  #{{ section_id }} .club-benefit__title {
    margin: 18px 0 0;
    color: var(--club-ink);
    font-size: clamp(21px, 2.4vw, 30px);
    line-height: 1.04;
    font-weight: 950;
  }

  #{{ section_id }} .club-benefit__text {
    margin: 14px 0 0;
    color: var(--club-muted);
    font-size: 14px;
    line-height: 1.55;
    font-weight: 650;
  }

  #{{ section_id }} .club-tiers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  #{{ section_id }} .club-tier {
    position: relative;
    overflow: hidden;
    min-height: 330px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.015)),
      #0d0d0d;
    padding: 26px;
    isolation: isolate;
  }

  #{{ section_id }} .club-tier--rookie {
    border-color: rgba(5, 5, 5, 0.1);
    background:
      linear-gradient(155deg, rgba(255, 255, 255, 0.96), rgba(247, 242, 232, 0.92)),
      var(--club-white);
    color: var(--club-ink);
  }

  #{{ section_id }} .club-tier::before {
    content: "";
    position: absolute;
    inset: auto -18% -38% auto;
    width: 220px;
    height: 220px;
    border: 1px solid rgba(200, 165, 106, 0.16);
    border-radius: 50%;
    pointer-events: none;
  }

  #{{ section_id }} .club-tier--featured {
    border-color: rgba(200, 165, 106, 0.54);
    background:
      linear-gradient(155deg, rgba(200, 165, 106, 0.18), rgba(255, 255, 255, 0.03)),
      #0b0b0b;
  }

  #{{ section_id }} .club-tier--mvp {
    border-color: rgba(200, 165, 106, 0.72);
    background:
      linear-gradient(145deg, rgba(200, 165, 106, 0.28), rgba(255, 255, 255, 0.035) 42%, rgba(200, 165, 106, 0.08)),
      #070707;
  }

  #{{ section_id }} .club-tier__top,
  #{{ section_id }} .club-tier__bottom {
    position: relative;
    z-index: 2;
  }

  #{{ section_id }} .club-tier__icon {
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    margin-bottom: 18px;
    padding: 0 12px;
    border: 1px solid rgba(200, 165, 106, 0.48);
    color: var(--club-gold);
    font-size: 11px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  #{{ section_id }} .club-tier__title {
    margin: 0;
    color: var(--club-white);
    font-size: clamp(28px, 4vw, 44px);
    line-height: 0.95;
    font-weight: 950;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  #{{ section_id }} .club-tier--rookie .club-tier__title,
  #{{ section_id }} .club-tier--rookie .club-tier__rule {
    color: var(--club-ink);
  }

  #{{ section_id }} .club-tier--rookie .club-tier__text {
    color: rgba(17, 17, 17, 0.66);
  }

  #{{ section_id }} .club-tier--rookie .club-tier__icon {
    border-color: rgba(5, 5, 5, 0.2);
    color: var(--club-ink);
  }

  #{{ section_id }} .club-tier__rule {
    margin: 16px 0 0;
    color: var(--club-white);
    font-size: 17px;
    line-height: 1.45;
    font-weight: 850;
  }

  #{{ section_id }} .club-tier__text {
    margin: 16px 0 0;
    color: var(--club-muted-dark);
    font-size: 14px;
    line-height: 1.55;
    font-weight: 650;
  }

  #{{ section_id }} .club-tier-progress {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid rgba(200, 165, 106, 0.2);
  }

  #{{ section_id }} .club-tier-progress__bar {
    position: relative;
    height: 6px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.12);
  }

  #{{ section_id }} .club-tier--rookie .club-tier-progress__bar {
    background: rgba(5, 5, 5, 0.12);
  }

  #{{ section_id }} .club-tier-progress__bar span {
    display: block;
    width: 38%;
    height: 100%;
    background: var(--club-gold);
  }

  #{{ section_id }} .club-tier-progress__text {
    margin: 10px 0 0;
    color: rgba(255, 255, 255, 0.62);
    font-size: 12px;
    line-height: 1.45;
    font-weight: 750;
  }

  #{{ section_id }} .club-tier--rookie .club-tier-progress__text {
    color: rgba(17, 17, 17, 0.58);
  }

  #{{ section_id }} .club-join {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    gap: 18px;
    align-items: stretch;
  }

  #{{ section_id }} .club-join__panel {
    border: 1px solid var(--club-border);
    background: var(--club-white);
    padding: clamp(24px, 4vw, 38px);
  }

  #{{ section_id }} .club-join__panel--dark {
    background: var(--club-black);
    color: var(--club-white);
    border-color: rgba(200, 165, 106, 0.24);
  }

  #{{ section_id }} .club-join__title {
    margin: 0;
    font-size: clamp(30px, 4vw, 52px);
    line-height: 0.96;
    font-weight: 950;
  }

  #{{ section_id }} .club-join__text {
    margin: 16px 0 0;
    color: var(--club-muted-dark);
    font-size: 15px;
    line-height: 1.7;
    font-weight: 650;
  }

  #{{ section_id }} .club-join__note {
    margin: 24px 0 0;
    color: var(--club-gold);
    font-size: 11px;
    line-height: 1.5;
    font-weight: 950;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #{{ section_id }} .club-why {
    margin-top: 24px;
    padding-top: 22px;
    border-top: 1px solid rgba(200, 165, 106, 0.24);
  }

  #{{ section_id }} .club-why__title {
    margin: 0 0 12px;
    color: var(--club-white);
    font-size: 18px;
    line-height: 1.2;
    font-weight: 950;
  }

  #{{ section_id }} .club-why__list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #{{ section_id }} .club-why__list li {
    position: relative;
    padding-right: 18px;
    color: var(--club-muted-dark);
    font-size: 14px;
    line-height: 1.45;
    font-weight: 750;
  }

  #{{ section_id }} .club-why__list li::before {
    content: "";
    position: absolute;
    top: 0.62em;
    right: 0;
    width: 6px;
    height: 6px;
    background: var(--club-gold);
  }

  #{{ section_id }} .club-form {
    display: grid;
    gap: 14px;
  }

  #{{ section_id }} .club-form__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  #{{ section_id }} .club-form__row {
    display: grid;
    gap: 8px;
  }

  #{{ section_id }} .club-form label {
    color: var(--club-ink);
    font-size: 11px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #{{ section_id }} .club-form input {
    width: 100%;
    min-height: 52px;
    border: 1px solid rgba(5, 5, 5, 0.16);
    background: #fdfaf4;
    color: var(--club-ink);
    padding: 13px 15px;
    font: inherit;
    font-size: 16px;
    line-height: 1.35;
    border-radius: 0;
    box-shadow: none;
    outline: none;
    direction: rtl;
  }

  #{{ section_id }} .club-form input:focus {
    border-color: rgba(200, 165, 106, 0.9);
    background: var(--club-white);
  }

  #{{ section_id }} .club-form__message {
    margin: 0 0 4px;
    font-size: 14px;
    line-height: 1.5;
    font-weight: 800;
  }

  #{{ section_id }} .club-form__message--success {
    color: #236b34;
  }

  #{{ section_id }} .club-form__message--error {
    color: #9c2424;
  }

  #{{ section_id }} .club-faq {
    display: grid;
    gap: 10px;
  }

  #{{ section_id }} .club-faq details {
    border: 1px solid var(--club-border);
    background: var(--club-white);
  }

  #{{ section_id }} .club-faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px;
    color: var(--club-ink);
    cursor: pointer;
    list-style: none;
    font-size: 16px;
    line-height: 1.35;
    font-weight: 950;
  }

  #{{ section_id }} .club-faq summary::-webkit-details-marker {
    display: none;
  }

  #{{ section_id }} .club-faq summary::after {
    content: "+";
    flex: 0 0 auto;
    color: var(--club-gold);
    font-size: 24px;
    line-height: 1;
    transition: transform 180ms ease;
  }

  #{{ section_id }} .club-faq details[open] summary::after {
    transform: rotate(45deg);
  }

  #{{ section_id }} .club-faq__answer {
    padding: 0 20px 18px;
    color: var(--club-muted);
    font-size: 15px;
    line-height: 1.65;
    font-weight: 650;
  }

  #{{ section_id }} .club-faq__answer p {
    margin: 0;
  }

  @media screen and (max-width: 900px) {
    #{{ section_id }} .club-section__head,
    #{{ section_id }} .club-hero__grid,
    #{{ section_id }} .club-join {
      grid-template-columns: 1fr;
    }

    #{{ section_id }} .club-hero__media {
      order: -1;
      min-height: 310px;
    }

    #{{ section_id }} .club-benefits,
    #{{ section_id }} .club-tiers {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 640px) {
    #{{ section_id }} .club-page-width {
      padding: 0 14px;
    }

    #{{ section_id }} .club-hero {
      min-height: auto;
    }

    #{{ section_id }} .club-hero__grid {
      padding: 36px 0 42px;
      gap: 24px;
    }

    #{{ section_id }} .club-hero__media {
      min-height: 270px;
    }

    #{{ section_id }} .club-hero__title {
      font-size: clamp(46px, 16vw, 72px);
    }

    #{{ section_id }} .club-button {
      width: 100%;
    }

    #{{ section_id }} .club-section {
      padding: 42px 0;
    }

    #{{ section_id }} .club-section__head {
      gap: 12px;
      margin-bottom: 18px;
    }

    #{{ section_id }} .club-benefit,
    #{{ section_id }} .club-tier,
    #{{ section_id }} .club-join__panel {
      padding: 20px;
    }

    #{{ section_id }} .club-form__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<section id="{{ section_id }}">
  <div class="club-hero">
    <div class="club-page-width">
      <div class="club-hero__grid{% if section.settings.hero_image == blank %} club-hero__grid--text-only{% endif %}">
        <div class="club-hero__content">
          <p class="club-kicker">{{ section.settings.hero_kicker }}</p>
          <h1 class="club-hero__title">{{ section.settings.hero_title }}</h1>
          <p class="club-hero__subtitle">{{ section.settings.hero_subtitle }}</p>
          <a class="club-button" href="#{{ section_id }}-join">{{ section.settings.hero_button_text }}</a>
        </div>

        {%- if section.settings.hero_image != blank -%}
          <div class="club-hero__media">
            {{ section.settings.hero_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '480, 720, 980, 1400', alt: section.settings.hero_title }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="club-section">
    <div class="club-page-width">
      <div class="club-section__head">
        <div>
          <p class="club-kicker">{{ section.settings.benefits_kicker }}</p>
          <h2 class="club-section__title">{{ section.settings.benefits_title }}</h2>
        </div>
        <p class="club-section__text">{{ section.settings.benefits_text }}</p>
      </div>

      <div class="club-benefits">
        {%- assign benefit_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            {%- assign benefit_count = benefit_count | plus: 1 -%}
            {%- if benefit_count <= 6 -%}
              <article class="club-benefit" {{ block.shopify_attributes }}>
                <div>
                  <p class="club-benefit__label">{{ block.settings.label }}</p>
                  <h3 class="club-benefit__title">{{ block.settings.title }}</h3>
                </div>
                <p class="club-benefit__text">{{ block.settings.text }}</p>
              </article>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="club-section club-section--dark">
    <div class="club-page-width">
      <div class="club-section__head">
        <div>
          <p class="club-kicker">{{ section.settings.tiers_kicker }}</p>
          <h2 class="club-section__title">{{ section.settings.tiers_title }}</h2>
        </div>
        <p class="club-section__text">{{ section.settings.tiers_text }}</p>
      </div>

      <div class="club-tiers">
        {%- assign tier_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'tier' -%}
            {%- assign tier_count = tier_count | plus: 1 -%}
            {%- if tier_count <= 3 -%}
            {%- liquid
              assign tier_title_handle = block.settings.title | handle
              assign tier_class = ''
              if tier_title_handle contains 'rookie'
                assign tier_class = ' club-tier--rookie'
              elsif tier_title_handle contains 'mvp'
                assign tier_class = ' club-tier--mvp'
              elsif block.settings.featured
                assign tier_class = ' club-tier--featured'
              endif
            -%}
            <article class="club-tier{{ tier_class }}" {{ block.shopify_attributes }}>
              <div class="club-tier__top">
                <span class="club-tier__icon">{{ block.settings.badge }}</span>
                <h3 class="club-tier__title">{{ block.settings.title }}</h3>
                <p class="club-tier__rule">{{ block.settings.rule }}</p>
              </div>
              <div class="club-tier__bottom">
                <p class="club-tier__text">{{ block.settings.text }}</p>
                <div class="club-tier-progress">
                  <div class="club-tier-progress__bar" aria-hidden="true"><span></span></div>
                  <p class="club-tier-progress__text">{{ block.settings.progress_text | default: section.settings.tier_progress_text }}</p>
                </div>
              </div>
            </article>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div id="{{ section_id }}-join" class="club-section">
    <div class="club-page-width">
      <div class="club-join">
        <div class="club-join__panel club-join__panel--dark">
          <p class="club-kicker">{{ section.settings.form_kicker }}</p>
          <h2 class="club-join__title">{{ section.settings.form_title }}</h2>
          <p class="club-join__text">{{ section.settings.form_text }}</p>
          <p class="club-join__note">{{ section.settings.form_note }}</p>
          <div class="club-why">
            <h3 class="club-why__title">{{ section.settings.why_title }}</h3>
            <ul class="club-why__list">
              <li>{{ section.settings.why_item_1 }}</li>
              <li>{{ section.settings.why_item_2 }}</li>
              <li>{{ section.settings.why_item_3 }}</li>
            </ul>
          </div>
        </div>

        <div class="club-join__panel">
          {%- form 'contact', class: 'club-form' -%}
            <input type="hidden" name="contact[Source]" value="HOOPERS CLUB">

            {%- if form.posted_successfully? -%}
              <p class="club-form__message club-form__message--success">{{ section.settings.success_message }}</p>
            {%- endif -%}

            {%- if form.errors -%}
              <div class="club-form__message club-form__message--error">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <div class="club-form__grid">
              <div class="club-form__row">
                <label for="ClubName-{{ section.id }}">{{ section.settings.name_label }}</label>
                <input id="ClubName-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" required>
              </div>

              <div class="club-form__row">
                <label for="ClubEmail-{{ section.id }}">{{ section.settings.email_label }}</label>
                <input id="ClubEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required>
              </div>

              <div class="club-form__row">
                <label for="ClubPhone-{{ section.id }}">{{ section.settings.phone_label }}</label>
                <input id="ClubPhone-{{ section.id }}" type="tel" name="contact[phone]" autocomplete="tel" required>
              </div>

              <div class="club-form__row">
                <label for="ClubBirthday-{{ section.id }}">{{ section.settings.birthday_label }}</label>
                <input id="ClubBirthday-{{ section.id }}" type="date" name="contact[Birthday]">
              </div>
            </div>

            <button class="club-button club-button--dark" type="submit">{{ section.settings.submit_text }}</button>
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>

  <div class="club-section">
    <div class="club-page-width">
      <div class="club-section__head">
        <div>
          <p class="club-kicker">{{ section.settings.faq_kicker }}</p>
          <h2 class="club-section__title">{{ section.settings.faq_title }}</h2>
        </div>
        <p class="club-section__text">{{ section.settings.faq_text }}</p>
      </div>

      <div class="club-faq">
        {%- assign faq_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            {%- assign faq_count = faq_count | plus: 1 -%}
            {%- if faq_count <= 5 -%}
              <details {{ block.shopify_attributes }}>
                <summary>{{ block.settings.question }}</summary>
                <div class="club-faq__answer">
                  {{ block.settings.answer }}
                </div>
              </details>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

