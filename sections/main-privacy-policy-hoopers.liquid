{%- liquid
  assign section_id = 'hoopers-privacy-' | append: section.id
-%}

<style>
  #{{ section_id }} {
    --hpp-black: #050505;
    --hpp-cream: #f7f2e8;
    --hpp-ink: #111111;
    --hpp-muted: rgba(17, 17, 17, 0.64);
    --hpp-gold: #c8a56a;
    --hpp-border: rgba(5, 5, 5, 0.1);
    background: var(--hpp-cream);
    color: var(--hpp-ink);
    direction: rtl;
  }

  #{{ section_id }} * {
    box-sizing: border-box;
  }

  #{{ section_id }} .hpp-page-width {
    width: min(100%, 1240px);
    margin: 0 auto;
    padding: 0 18px;
  }

  #{{ section_id }} .hpp-hero {
    position: relative;
    overflow: hidden;
    background: var(--hpp-black);
    color: #fff;
    padding: 92px 0 58px;
  }

  #{{ section_id }} .hpp-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(5, 5, 5, 0), rgba(5, 5, 5, 0.55)),
      radial-gradient(circle at 16% 16%, rgba(200, 165, 106, 0.18), transparent 34%);
    pointer-events: none;
  }

  #{{ section_id }} .hpp-hero__content {
    position: relative;
    z-index: 2;
    max-width: 900px;
  }

  #{{ section_id }} .hpp-kicker {
    margin: 0 0 16px;
    color: var(--hpp-gold);
    font-size: 11px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  #{{ section_id }} .hpp-title {
    margin: 0;
    color: #fff;
    font-size: clamp(38px, 6vw, 76px);
    line-height: 0.98;
    font-weight: 950;
    letter-spacing: 0.01em;
  }

  #{{ section_id }} .hpp-subtitle {
    max-width: 760px;
    margin: 20px 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(16px, 2vw, 22px);
    line-height: 1.55;
    font-weight: 650;
  }

  #{{ section_id }} .hpp-top-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-top: -28px;
    position: relative;
    z-index: 3;
  }

  #{{ section_id }} .hpp-card {
    min-height: 185px;
    background: #fff;
    border: 1px solid var(--hpp-border);
    padding: 22px;
    transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
  }

  #{{ section_id }} .hpp-card:hover {
    transform: translateY(-4px);
    border-color: rgba(200, 165, 106, 0.58);
    box-shadow: 0 18px 44px rgba(5, 5, 5, 0.08);
  }

  #{{ section_id }} .hpp-card__icon {
    display: block;
    margin-bottom: 14px;
    font-size: 25px;
    line-height: 1;
  }

  #{{ section_id }} .hpp-card__title {
    margin: 0;
    color: var(--hpp-ink);
    font-size: 22px;
    line-height: 1.08;
    font-weight: 950;
  }

  #{{ section_id }} .hpp-card__text {
    margin: 14px 0 0;
    color: var(--hpp-ink);
    font-size: 16px;
    line-height: 1.45;
    font-weight: 750;
  }

  #{{ section_id }} .hpp-section {
    padding: 44px 0;
  }

  #{{ section_id }} .hpp-section__title {
    margin: 0 0 24px;
    color: var(--hpp-ink);
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.015em;
  }

  #{{ section_id }} .hpp-timeline {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  #{{ section_id }} .hpp-step {
    position: relative;
    min-height: 210px;
    background: var(--hpp-black);
    color: #fff;
    padding: 24px;
    border: 1px solid rgba(200, 165, 106, 0.22);
  }

  #{{ section_id }} .hpp-step__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    margin-bottom: 18px;
    background: var(--hpp-gold);
    color: var(--hpp-black);
    font-size: 14px;
    line-height: 1;
    font-weight: 950;
  }

  #{{ section_id }} .hpp-step__title {
    margin: 0;
    color: #fff;
    font-size: 22px;
    line-height: 1.1;
    font-weight: 950;
  }

  #{{ section_id }} .hpp-step__text {
    margin: 12px 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 15px;
    line-height: 1.5;
    font-weight: 650;
  }

  #{{ section_id }} .hpp-faq {
    display: grid;
    gap: 10px;
  }

  #{{ section_id }} .hpp-faq details,
  #{{ section_id }} .hpp-legal details {
    background: #fff;
    border: 1px solid var(--hpp-border);
  }

  #{{ section_id }} .hpp-faq summary,
  #{{ section_id }} .hpp-legal summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 20px 22px;
    color: var(--hpp-ink);
    cursor: pointer;
    list-style: none;
    font-size: 18px;
    line-height: 1.25;
    font-weight: 900;
  }

  #{{ section_id }} .hpp-faq summary::-webkit-details-marker,
  #{{ section_id }} .hpp-legal summary::-webkit-details-marker {
    display: none;
  }

  #{{ section_id }} .hpp-faq summary::after,
  #{{ section_id }} .hpp-legal summary::after {
    content: "+";
    flex: 0 0 auto;
    color: var(--hpp-gold);
    font-size: 28px;
    line-height: 1;
    font-weight: 500;
    transition: transform 0.2s ease;
  }

  #{{ section_id }} .hpp-faq details[open] summary::after,
  #{{ section_id }} .hpp-legal details[open] summary::after {
    transform: rotate(45deg);
  }

  #{{ section_id }} .hpp-faq__answer {
    padding: 0 22px 20px;
    color: var(--hpp-muted);
    font-size: 16px;
    line-height: 1.65;
    font-weight: 650;
  }

  #{{ section_id }} .hpp-promise {
    background: var(--hpp-black);
    color: #fff;
    padding: 42px 0;
  }

  #{{ section_id }} .hpp-promise__inner {
    display: grid;
    grid-template-columns: minmax(180px, 0.4fr) minmax(0, 1fr);
    gap: 24px;
    align-items: center;
  }

  #{{ section_id }} .hpp-promise__title {
    margin: 0;
    color: #fff;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1;
    font-weight: 950;
  }

  #{{ section_id }} .hpp-promise__items {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  #{{ section_id }} .hpp-promise__item {
    min-height: 76px;
    display: flex;
    align-items: center;
    padding: 15px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.82);
    font-size: 14px;
    line-height: 1.35;
    font-weight: 850;
  }

  #{{ section_id }} .hpp-legal__content {
    max-width: 920px;
    padding: 0 22px 24px;
    color: var(--hpp-muted);
    font-size: 16px;
    line-height: 1.75;
    font-weight: 650;
  }

  #{{ section_id }} .hpp-legal__content p {
    margin: 0 0 18px;
  }

  #{{ section_id }} .hpp-legal__content p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 990px) {
    #{{ section_id }} .hpp-top-cards,
    #{{ section_id }} .hpp-timeline,
    #{{ section_id }} .hpp-promise__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ section_id }} .hpp-promise__inner {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 640px) {
    #{{ section_id }} .hpp-page-width {
      padding: 0 14px;
    }

    #{{ section_id }} .hpp-hero {
      padding: 74px 0 48px;
    }

    #{{ section_id }} .hpp-top-cards {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: -18px;
    }

    #{{ section_id }} .hpp-section {
      padding: 34px 0;
    }

    #{{ section_id }} .hpp-timeline,
    #{{ section_id }} .hpp-promise__items {
      grid-template-columns: 1fr;
    }

    #{{ section_id }} .hpp-card,
    #{{ section_id }} .hpp-step {
      padding: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} * {
      transition: none !important;
    }
  }
</style>

<section id="{{ section_id }}">
