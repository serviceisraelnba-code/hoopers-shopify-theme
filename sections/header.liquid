{%- liquid
  assign template_name = template | replace: '.', ' ' | truncatewords: 2, '' | handle

  assign sticky_header = false
  if section.settings.header_style == 'sticky'
    assign sticky_header = true
  endif

  assign overlay_header = false
  if template_name == 'index' and section.settings.sticky_index
    assign overlay_header = true
  endif
  if template_name contains 'collection' and collection.image and section.settings.sticky_collection
    assign overlay_header = true
  endif

  assign nba_label = section.settings.nba_label | default: 'NBA'
  assign world_label = section.settings.world_label | default: 'WORLD CUP'
  assign streetwear_label = section.settings.streetwear_label | default: 'STREETWEAR'
  assign pro_label = section.settings.pro_label | default: 'PRO GEAR'
  assign sale_label = section.settings.sale_label | default: 'SALE'
  assign new_arrivals_label = section.settings.new_arrivals_label | default: 'NEW ARRIVALS'
  assign best_sellers_label = section.settings.best_sellers_label | default: 'BEST SELLERS'
  assign kids_label = section.settings.kids_label | default: 'KIDS'
  assign care_label = section.settings.care_label | default: 'CUSTOMER CARE'

    assign nba_link = section.settings.nba_link | default: '/collections/nba'
  assign nba_retro_label = section.settings.nba_retro_label | default: 'Retro'
  assign nba_retro_link = section.settings.nba_retro_link | default: '/collections/retro'
  assign nba_winter_label = section.settings.nba_winter_label | default: 'Winter'
  assign nba_winter_link = section.settings.nba_winter_link | default: '/collections/winter'
  assign world_link = section.settings.world_link | default: '/collections/world-cup'
  assign streetwear_link = section.settings.streetwear_link | default: '/collections/streetwear'
  assign pro_link = section.settings.pro_link | default: '/collections/pro-gear'
  assign sale_link = section.settings.sale_link | default: '/collections/sale'
  assign new_arrivals_link = section.settings.new_arrivals_link | default: '/collections/new-arrivals'
  assign best_sellers_link = section.settings.best_sellers_link | default: '/collections/best-sellers'
  assign kids_link = section.settings.kids_link | default: '/collections/kids'
  assign care_link = section.settings.care_link | default: '/pages/contact'

  assign nba_secondary_visible = false
  if section.settings.nba_team_1_label != blank or section.settings.nba_team_2_label != blank or section.settings.nba_team_3_label != blank or section.settings.nba_team_4_label != blank or section.settings.nba_team_5_label != blank or section.settings.nba_team_6_label != blank or section.settings.nba_team_7_label != blank
    assign nba_secondary_visible = true
  endif

  assign world_secondary_visible = false
  if section.settings.world_secondary_1_label != blank
    assign world_secondary_visible = true
  endif

  assign streetwear_secondary_visible = false
  if section.settings.streetwear_secondary_1_label != blank
    assign streetwear_secondary_visible = true
  endif

  assign pro_secondary_visible = false
  if section.settings.pro_secondary_1_label != blank
    assign pro_secondary_visible = true
  endif

  assign sale_secondary_visible = false
  if section.settings.sale_secondary_1_label != blank
    assign sale_secondary_visible = true
  endif

  assign kids_secondary_visible = false
  if section.settings.kids_secondary_1_label != blank
    assign kids_secondary_visible = true
  endif

  assign care_secondary_visible = false
  if section.settings.care_secondary_1_label != blank
    assign care_secondary_visible = true
  endif
-%}

{%- render 'cart-drawer' -%}

<style>
  #shopify-section-{{ section.id }} {
    --hh-black: #050505;
    --hh-gold: #c8a56a;
    position: relative;
    z-index: 30;
  }

  #shopify-section-{{ section.id }} .hh-header {
    background: rgba(5, 5, 5, 0.94);
    color: #fff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(14px);
  }

  #shopify-section-{{ section.id }} .header-wrapper--sticky .hh-header,
  #shopify-section-{{ section.id }} .header-wrapper.is-light .hh-header {
    background: rgba(5, 5, 5, 0.84);
  }

  #shopify-section-{{ section.id }} .hh-header .page-width {
    max-width: none;
    padding-left: 32px;
    padding-right: 32px;
  }

  #shopify-section-{{ section.id }} .hh-header__inner {
    position: relative;
    min-height: 82px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(180px, 16vw, 260px) minmax(0, 1fr);
    align-items: center;
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .hh-header__left,
  #shopify-section-{{ section.id }} .hh-header__right {
    min-width: 0;
    display: flex;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .hh-header__left {
    justify-content: flex-end;
  }

  #shopify-section-{{ section.id }} .hh-header__right {
    justify-content: space-between;
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .hh-header__logo {
    grid-column: 2;
    justify-self: center;
    width: 100%;
    max-width: 260px;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    z-index: 3;
  }

  #shopify-section-{{ section.id }} .hh-header__logo .site-header__logo,
  #shopify-section-{{ section.id }} .hh-header__logo .site-header__logo-link {
    margin: 0 auto;
    color: #fff !important;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .hh-header__logo img,
  #shopify-section-{{ section.id }} .hh-mobile-header__logo img {
    filter: brightness(0) invert(1);
  }

  #shopify-section-{{ section.id }} .hh-header__logo a,
  #shopify-section-{{ section.id }} .hh-mobile-header__logo a {
    color: #fff !important;
  }

  #shopify-section-{{ section.id }} .hh-nav {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .hh-nav__item {
    position: static;
  }

  #shopify-section-{{ section.id }} .hh-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 82px;
    color: #fff;
    font-size: 12.5px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .hh-nav__item--mega > .hh-nav__link::after {
    content: "";
    width: 6px;
    height: 6px;
    border-right: 1.5px solid var(--hh-gold);
    border-bottom: 1.5px solid var(--hh-gold);
    transform: rotate(45deg) translateY(-2px);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .hh-nav__link:hover,
  #shopify-section-{{ section.id }} .hh-nav__item:hover .hh-nav__link {
    color: var(--hh-gold);
  }

  #shopify-section-{{ section.id }} .hh-nav__item--mega:hover > .hh-nav__link::after,
  #shopify-section-{{ section.id }} .hh-nav__item--mega:focus-within > .hh-nav__link::after {
    transform: rotate(225deg) translate(-1px, -1px);
    border-color: #fff;
  }

  #shopify-section-{{ section.id }} .hh-icons {
    flex: 0 0 auto;
  }

  #shopify-section-{{ section.id }} .hh-icons .site-nav,
  #shopify-section-{{ section.id }} .hh-mobile-header__icons .site-nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .hh-icons .site-nav__link,
  #shopify-section-{{ section.id }} .hh-icons a,
  #shopify-section-{{ section.id }} .hh-icons button,
  #shopify-section-{{ section.id }} .hh-icons .icon,
  #shopify-section-{{ section.id }} .hh-icons svg {
    color: #fff !important;
    stroke: #fff !important;
  }

  #shopify-section-{{ section.id }} .hh-mobile-header__icons .site-nav__link,
  #shopify-section-{{ section.id }} .hh-mobile-header__icons a,
  #shopify-section-{{ section.id }} .hh-mobile-header__icons button,
  #shopify-section-{{ section.id }} .hh-mobile-header__icons .icon,
  #shopify-section-{{ section.id }} .hh-mobile-header__icons svg {
    color: #fff !important;
    stroke: #fff !important;
  }

  #shopify-section-{{ section.id }} .hh-mobile-header__icons svg path {
    fill: none !important;
    stroke: currentColor !important;
  }

  #shopify-section-{{ section.id }} .hh-mobile-header__icons [class*="wishlist"],
  #shopify-section-{{ section.id }} .hh-mobile-header__icons [class*="wishlist"] svg,
  #shopify-section-{{ section.id }} .hh-mobile-header__icons [class*="wishlist"] svg path {
    color: #fff !important;
    fill: none !important;
    stroke: #fff !important;
  }

  #shopify-section-{{ section.id }} .hh-icons [class*="wishlist"],
  #shopify-section-{{ section.id }} .hh-icons [class*="wishlist"] svg,
  #shopify-section-{{ section.id }} .hh-icons [class*="wishlist"] svg path {
    color: #fff !important;
    fill: #fff !important;
    stroke: #fff !important;
  }

  #shopify-section-{{ section.id }} .hh-icons .cart-link__bubble,
  #shopify-section-{{ section.id }} .hh-mobile-header__icons .cart-link__bubble {
    background: var(--hh-gold);
    color: #050505;
  }

  #shopify-section-{{ section.id }} .hh-mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(10px);
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
    background: var(--hh-black);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.38);
  }

  #shopify-section-{{ section.id }} .hh-nav__item:hover .hh-mega,
  #shopify-section-{{ section.id }} .hh-nav__item:focus-within .hh-mega {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  #shopify-section-{{ section.id }} .hh-mega__inner {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) minmax(180px, 1fr) minmax(340px, 480px);
    gap: 46px;
    padding: 38px 0;
    color: #fff;
  }

  .hh-mega__inner--no-secondary {
  grid-template-columns: minmax(210px, 1fr) minmax(190px, 0.72fr) minmax(360px, 480px);
}

.hh-mega__inner--no-secondary .hh-mega__banner {
  grid-column: 3;
}

  #shopify-section-{{ section.id }} .hh-mega__eyebrow {
    margin: 0 0 16px;
    color: var(--hh-gold);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .hh-mega__list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .hh-mega__list a {
    color: rgba(255, 255, 255, 0.84);
    font-size: 15px;
    line-height: 1.2;
    font-weight: 750;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .hh-mega__list a:hover {
    color: #fff;
  }

  #shopify-section-{{ section.id }} .hh-mega__banner {
    position: relative;
    display: block;
    min-height: 255px;
    overflow: hidden;
    background: #111;
    color: #fff;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .hh-mega__banner img {
    width: 100%;
    height: 100%;
    min-height: 255px;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  #shopify-section-{{ section.id }} .hh-mega__banner:hover img {
    transform: scale(1.035);
  }

  #shopify-section-{{ section.id }} .hh-mega__banner::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.58));
  }

  #shopify-section-{{ section.id }} .hh-mega__banner-content {
    position: absolute;
    left: 22px;
    right: 22px;
    bottom: 20px;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .hh-mega__banner-title {
    display: block;
    margin-bottom: 12px;
    color: #fff;
    font-size: 28px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .hh-mega__banner-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 18px;
    background: #fff;
    color: #050505;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .hh-mobile-header {
    display: none;
  }

  #shopify-section-{{ section.id }} .hh-drawer {
    background: var(--hh-black);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .hh-drawer .drawer__contents {
    background: var(--hh-black);
  }

  #shopify-section-{{ section.id }} .hh-drawer .drawer__fixed-header {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  #shopify-section-{{ section.id }} .hh-drawer .drawer__header {
    min-height: 68px;
    padding: 16px 18px;
  }

  #shopify-section-{{ section.id }} .hh-drawer__title {
    display: grid;
    gap: 3px;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .hh-drawer__kicker {
    color: var(--hh-gold);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .hh-drawer__brand {
    color: #fff;
    font-size: 17px;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .hh-drawer .drawer__close-button {
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 0;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .hh-drawer .drawer__scrollable {
    padding: 22px 18px 26px;
  }

  #shopify-section-{{ section.id }} .hh-mobile-menu {
    display: grid;
    gap: 0;
  }

  #shopify-section-{{ section.id }} .hh-mobile-menu details {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  #shopify-section-{{ section.id }} .hh-mobile-menu summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    color: #fff;
    cursor: pointer;
    list-style: none;
    font-size: 18px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .hh-mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .hh-mobile-menu summary::after {
    content: "+";
    color: var(--hh-gold);
    font-size: 22px;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  #shopify-section-{{ section.id }} .hh-mobile-menu details[open] summary::after {
    transform: rotate(45deg);
  }

  #shopify-section-{{ section.id }} .hh-mobile-menu__links {
    display: grid;
    gap: 0;
    padding: 4px 0 18px;
  }

  #shopify-section-{{ section.id }} .hh-mobile-menu__links a {
    color: rgba(255, 255, 255, 0.62);
    text-decoration: none;
    font-size: 13px;
    line-height: 1.25;
    font-weight: 750;
    padding: 11px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  #shopify-section-{{ section.id }} .hh-mobile-menu__links a:first-child {
    border-top-color: rgba(200, 165, 106, 0.22);
  }

  #shopify-section-{{ section.id }} .hh-mobile-menu__secondary a,
  #shopify-section-{{ section.id }} .hh-mobile-menu__account {
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    font-size: 14px;
    line-height: 1.2;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .hh-mobile-menu__links a:hover,
  #shopify-section-{{ section.id }} .hh-mobile-menu__links a:focus,
  #shopify-section-{{ section.id }} .hh-mobile-menu__secondary a:hover,
  #shopify-section-{{ section.id }} .hh-mobile-menu__account:hover {
    color: #fff;
  }

  #shopify-section-{{ section.id }} .hh-mobile-menu__account {
    display: block;
    padding: 18px 0 0;
  }

  #shopify-section-{{ section.id }} .hh-mobile-menu__divider {
    height: 1px;
    background: rgba(200, 165, 106, 0.42);
    margin: 18px 0;
  }

  #shopify-section-{{ section.id }} .hh-mobile-menu__secondary {
    display: grid;
    gap: 18px;
    padding: 18px 0 2px;
  }

  #shopify-section-{{ section.id }} .hh-mobile-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 22px;
    padding-bottom: 26px;
  }

  #shopify-section-{{ section.id }} .hh-mobile-card {
    position: relative;
    display: block;
    min-height: 132px;
    overflow: hidden;
    background: #111;
    color: #fff;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  #shopify-section-{{ section.id }} .hh-mobile-card img {
    width: 100%;
    height: 132px;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .hh-mobile-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.68));
  }

  #shopify-section-{{ section.id }} .hh-mobile-card span {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    z-index: 2;
    color: #fff;
    font-size: 12px;
    line-height: 1.1;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media screen and (max-width: 1380px) {
    #shopify-section-{{ section.id }} .hh-nav {
      gap: 13px;
    }

    #shopify-section-{{ section.id }} .hh-nav__link {
      font-size: 11.5px;
      letter-spacing: 0.045em;
    }

    #shopify-section-{{ section.id }} .hh-header__inner {
      grid-template-columns: minmax(0, 1fr) clamp(170px, 15vw, 230px) minmax(0, 1fr);
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .hh-header .page-width {
      padding-left: 22px;
      padding-right: 22px;
    }
  }

  @media screen and (max-width: 1180px) {
    #shopify-section-{{ section.id }} .hh-desktop-header {
      display: none;
    }

    #shopify-section-{{ section.id }} .hh-mobile-header {
      display: block;
      background: rgba(5, 5, 5, 0.96);
    }

    #shopify-section-{{ section.id }} .hh-mobile-header__inner {
      min-height: 66px;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 14px;
    }

    #shopify-section-{{ section.id }} .hh-mobile-header__menu {
      justify-self: start;
    }

    #shopify-section-{{ section.id }} .hh-mobile-header__logo {
      justify-self: center;
    }

      #shopify-section-{{ section.id }} .hh-mobile-header__icons {
      justify-self: end;
      position: relative;
      z-index: 8;
      pointer-events: auto;
    }

    #shopify-section-{{ section.id }} .hh-mobile-header__icons .site-nav__link--icon,
    #shopify-section-{{ section.id }} .hh-mobile-header__icons a,
    #shopify-section-{{ section.id }} .hh-mobile-header__icons button {
      position: relative;
      z-index: 9;
      pointer-events: auto;
    }

    #shopify-section-{{ section.id }} .hh-mobile-header .site-nav__link--icon {
      color: #fff;
      padding: 8px;
    }

    #shopify-section-{{ section.id }} .hh-mobile-header__icons .site-nav {
      display: flex;
      align-items: center;
      gap: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} * {
      transition: none !important;
    }
  }
</style>

<div id="NavDrawer" class="drawer drawer--left hh-drawer" dir="rtl">
  <div class="drawer__contents">
    <div class="drawer__fixed-header">
      <div class="drawer__header">
        <div class="h2 drawer__title hh-drawer__title">
          <span class="hh-drawer__kicker">HOOPERS</span>
          <span class="hh-drawer__brand">MENU</span>
        </div>
        <div class="drawer__close">
          <button type="button" class="drawer__close-button js-drawer-close">
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewBox="0 0 64 64"><path d="m19 17.61 27.12 27.13m0-27.12L19 44.74"/></svg>
            <span class="icon__fallback-text">{{ 'general.drawers.close_menu' | t }}</span>
          </button>
        </div>
      </div>
    </div>

    <div class="drawer__scrollable">
      <nav class="hh-mobile-menu" aria-label="Mobile navigation">
        <details>
          <summary>{{ nba_label }}</summary>
          <div class="hh-mobile-menu__links">
            <a href="{{ section.settings.nba_main_1_url | default: '/collections/jerseys' }}">{{ section.settings.nba_main_1_label | default: 'גופיות' }}</a>
            <a href="{{ section.settings.nba_main_2_url | default: '/collections/shorts' }}">{{ section.settings.nba_main_2_label | default: 'מכנסים' }}</a>
            <a href="{{ section.settings.nba_main_3_url | default: '/collections/t-shirts' }}">{{ section.settings.nba_main_3_label | default: 'טישרטים' }}</a>
            <a href="{{ nba_retro_link }}">{{ nba_retro_label }}</a>
            <a href="{{ nba_winter_link }}">{{ nba_winter_label }}</a>
