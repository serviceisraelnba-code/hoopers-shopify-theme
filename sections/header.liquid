<div data-section-id="{{ section.id }}" data-section-type="header">
  <div class="header-sticky-wrapper">
    <div id="HeaderWrapper" class="header-wrapper{% if overlay_header %} header-wrapper--sticky is-light{% endif %}">
      <header
        id="SiteHeader"
        class="site-header hh-header hh-desktop-header{% if settings.type_navigation_style == 'heading' %} site-header--heading-style{% endif %}"
        data-sticky="{{ sticky_header }}"
        data-overlay="{{ overlay_header }}">

        <div class="page-width">
          <div class="hh-header__inner">
            <div class="hh-header__left">
              <nav aria-label="Primary left navigation">
                <ul class="hh-nav">
                  <li class="hh-nav__item hh-nav__item--mega"><a class="hh-nav__link" href="{{ nba_link }}">{{ nba_label }}</a>{{ nba_mega }}</li>
                  <li class="hh-nav__item hh-nav__item--mega"><a class="hh-nav__link" href="{{ world_link }}">{{ world_label }}</a>{{ world_mega }}</li>
                  <li class="hh-nav__item hh-nav__item--mega"><a class="hh-nav__link" href="{{ streetwear_link }}">{{ streetwear_label }}</a>{{ streetwear_mega }}</li>
                  <li class="hh-nav__item hh-nav__item--mega"><a class="hh-nav__link" href="{{ pro_link }}">{{ pro_label }}</a>{{ pro_mega }}</li>
                  <li class="hh-nav__item hh-nav__item--mega"><a class="hh-nav__link" href="{{ sale_link }}">{{ sale_label }}</a>{{ sale_mega }}</li>
                </ul>
              </nav>
            </div>

            <div class="hh-header__logo">
              {%- render 'header-logo-block', section: section -%}
            </div>

            <div class="hh-header__right">
              <nav aria-label="Primary right navigation">
                <ul class="hh-nav">
                  <li><a class="hh-nav__link" href="{{ new_arrivals_link }}">{{ new_arrivals_label }}</a></li>
                  <li><a class="hh-nav__link" href="{{ best_sellers_link }}">{{ best_sellers_label }}</a></li>
                  <li class="hh-nav__item hh-nav__item--mega"><a class="hh-nav__link" href="{{ kids_link }}">{{ kids_label }}</a>{{ kids_mega }}</li>
                  <li class="hh-nav__item hh-nav__item--mega"><a class="hh-nav__link" href="{{ care_link }}">{{ care_label }}</a>{{ care_mega }}</li>
                </ul>
              </nav>

              <div class="hh-icons">
                {%- render 'header-icons', section: section -%}
              </div>
            </div>
          </div>
        </div>

        <div class="site-header__search-container">
          <div class="site-header__search">
            <div class="page-width">
              {% render 'predictive-search', context: 'header' %}
            </div>
          </div>
        </div>
      </header>

      <header
        class="site-header hh-header hh-mobile-header{% if settings.type_navigation_style == 'heading' %} site-header--heading-style{% endif %}"
        data-sticky="{{ sticky_header }}"
        data-overlay="{{ overlay_header }}">
        <div class="page-width">
          <div class="hh-mobile-header__inner">
            <div class="hh-mobile-header__menu">
              <button type="button" class="site-nav__link site-nav__link--icon js-drawer-open-nav" aria-controls="NavDrawer">
                <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-hamburger" viewBox="0 0 64 64"><path d="M7 15h51M7 32h43M7 49h51"/></svg>
                <span class="icon__fallback-text">{{ 'general.drawers.navigation' | t }}</span>
              </button>
            </div>

            <div class="hh-mobile-header__logo">
              {%- render 'header-logo-block', section: section -%}
            </div>

            <div class="hh-mobile-header__icons">
              {%- render 'header-icons', section: section -%}
            </div>
          </div>
        </div>

        <div class="site-header__search-container">
          <div class="site-header__search">
            <div class="page-width">
              {% render 'predictive-search', context: 'header' %}
            </div>
          </div>
        </div>
      </header>
    </div>
  </div>
</div>

<script>
  (function() {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section || section.dataset.hhMobileSearchFix === 'true') return;
    section.dataset.hhMobileSearchFix = 'true';

    function isSearchTrigger(element) {
      if (!element) return false;

      var triggerText = [
        element.getAttribute('aria-label'),
        element.getAttribute('title'),
        element.getAttribute('data-search-trigger'),
        element.getAttribute('data-predictive-search-open'),
        element.className,
        element.getAttribute('href')
      ].join(' ').toLowerCase();

      return triggerText.indexOf('search') !== -1 || triggerText.indexOf('חיפוש') !== -1;
    }

    function openSearchFallback() {
      var mobileHeader = section.querySelector('.hh-mobile-header');
      var container = mobileHeader && mobileHeader.querySelector('.site-header__search-container');

      if (!container) {
        container = section.querySelector('.site-header__search-container');
      }

      if (!container) return;

      container.classList.add('is-active', 'is-open', 'site-header__search-container--open');
      container.removeAttribute('hidden');
      container.setAttribute('aria-hidden', 'false');

      var header = container.closest('.site-header');
      if (header) {
        header.classList.add('site-header--search-open', 'site-header--is-searching');
      }

      var input = container.querySelector('input[type="search"], input[name="q"], .site-header__search-input');
      if (input) {
        window.setTimeout(function() {
          input.focus();
        }, 80);
      }
    }

    section.addEventListener('click', function(event) {
      var mobileIcons = event.target.closest('.hh-mobile-header__icons');
      if (!mobileIcons) return;

      var trigger = event.target.closest('a, button');
      if (!isSearchTrigger(trigger)) return;

      var desktopTrigger = section.querySelector('.hh-desktop-header .hh-icons a[class*="search"], .hh-desktop-header .hh-icons button[class*="search"], .hh-desktop-header .hh-icons a[href*="search"], .hh-desktop-header .hh-icons button[aria-label*="Search"], .hh-desktop-header .hh-icons button[aria-label*="חיפוש"]');

      event.preventDefault();
      event.stopPropagation();

      if (desktopTrigger && desktopTrigger !== trigger) {
        desktopTrigger.click();
        window.setTimeout(openSearchFallback, 80);
      } else {
        openSearchFallback();
      }
    }, true);
  })();
</script>

