        { "type": "text", "id": "title", "label": "Title", "default": "מדריך חדש" },
        { "type": "textarea", "id": "description", "label": "Short description", "default": "תיאור קצר למדריך." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
