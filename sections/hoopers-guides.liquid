{%- liquid
  assign section_id = 'hoopers-guides-' | append: section.id
-%}

<style>
  #{{ section_id }} {
    --hg-black: #050505;
    --hg-ink: #111;
    --hg-cream: #f7f2e8;
    --hg-muted: rgba(247, 242, 232, 0.68);
    --hg-gold: #c8a56a;
    --hg-border: rgba(200, 165, 106, 0.24);
    background: var(--hg-black);
    color: var(--hg-cream);
    direction: rtl;
  }

  #{{ section_id }} * {
    box-sizing: border-box;
  }

  #{{ section_id }} .hg-page-width {
    width: min(100%, 1440px);
    margin: 0 auto;
    padding: 0 18px;
  }

  #{{ section_id }} .hg-hero {
    position: relative;
    min-height: 430px;
    display: flex;
    align-items: end;
    overflow: hidden;
    background: #050505;
  }

  #{{ section_id }} .hg-hero__media {
    position: absolute;
    inset: 0;
    opacity: 0.44;
  }

  #{{ section_id }} .hg-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #{{ section_id }} .hg-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(5, 5, 5, 0.28), rgba(5, 5, 5, 0.92)),
      radial-gradient(circle at 18% 20%, rgba(200, 165, 106, 0.16), transparent 34%);
  }

  #{{ section_id }} .hg-hero__content {
    position: relative;
    z-index: 2;
    width: min(100%, 900px);
    padding: 96px 0 54px;
  }

  #{{ section_id }} .hg-kicker {
    margin: 0 0 16px;
    color: var(--hg-gold);
    font-size: 11px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  #{{ section_id }} .hg-hero__title {
    margin: 0;
    color: #fff;
    font-size: clamp(44px, 8vw, 104px);
    line-height: 0.88;
    font-weight: 950;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  #{{ section_id }} .hg-hero__subtitle {
    max-width: 760px;
    margin: 22px 0 0;
    color: var(--hg-muted);
    font-size: clamp(16px, 2.4vw, 23px);
    line-height: 1.55;
    font-weight: 650;
  }

  #{{ section_id }} .hg-section {
    padding: 54px 0;
  }

  #{{ section_id }} .hg-section--cream {
    background: var(--hg-cream);
    color: var(--hg-ink);
  }

  #{{ section_id }} .hg-section__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 22px;
    margin-bottom: 24px;
  }

  #{{ section_id }} .hg-section__title {
    margin: 0;
    font-size: clamp(26px, 4vw, 48px);
    line-height: 0.96;
    font-weight: 950;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  #{{ section_id }} .hg-section__text {
    max-width: 560px;
    margin: 0;
    color: rgba(17, 17, 17, 0.66);
    font-size: 15px;
    line-height: 1.55;
    font-weight: 650;
  }

  #{{ section_id }} .hg-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  #{{ section_id }} .hg-card {
    position: relative;
    display: flex;
    min-height: 430px;
    overflow: hidden;
    background: #111;
    color: #fff;
    text-decoration: none;
    isolation: isolate;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  #{{ section_id }} .hg-section--cream .hg-card {
    border-color: rgba(5, 5, 5, 0.08);
  }

  #{{ section_id }} .hg-card__image {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #181818;
  }

  #{{ section_id }} .hg-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.01);
    transition: transform 0.42s ease, opacity 0.42s ease;
  }

  #{{ section_id }} .hg-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(5, 5, 5, 0.06), rgba(5, 5, 5, 0.88));
  }

  #{{ section_id }} .hg-card__content {
    position: relative;
    z-index: 2;
    width: 100%;
    align-self: end;
    padding: 24px;
  }

  #{{ section_id }} .hg-card__category {
    display: inline-flex;
    margin-bottom: 12px;
    color: var(--hg-gold);
    font-size: 10px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  #{{ section_id }} .hg-card__title {
    margin: 0;
    color: #fff;
    font-size: clamp(22px, 2.3vw, 32px);
    line-height: 1.02;
    font-weight: 950;
    letter-spacing: 0.02em;
  }

  #{{ section_id }} .hg-card__desc {
    margin: 13px 0 0;
    color: rgba(255, 255, 255, 0.74);
    font-size: 14px;
    line-height: 1.48;
    font-weight: 600;
  }

  #{{ section_id }} .hg-card__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    margin-top: 20px;
    padding: 0 16px;
    background: #fff;
    color: #050505;
    font-size: 11px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #{{ section_id }} .hg-card:hover .hg-card__image img,
  #{{ section_id }} .hg-card:focus-visible .hg-card__image img {
    transform: scale(1.06);
    opacity: 0.86;
  }

  #{{ section_id }} .hg-card:hover .hg-card__button,
  #{{ section_id }} .hg-card:focus-visible .hg-card__button {
    background: var(--hg-gold);
  }

  #{{ section_id }} .hg-category {
    padding: 42px 0;
    border-top: 1px solid var(--hg-border);
  }

  #{{ section_id }} .hg-category:first-child {
    border-top: 0;
    padding-top: 0;
  }

  #{{ section_id }} .hg-category__title {
    margin: 0 0 18px;
    color: #fff;
    font-size: clamp(24px, 3vw, 40px);
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  #{{ section_id }} .hg-small-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  #{{ section_id }} .hg-small-card {
    display: grid;
    grid-template-columns: 136px minmax(0, 1fr);
    min-height: 154px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.045);
    color: #fff;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.22s ease, border-color 0.22s ease, background 0.22s ease;
  }

  #{{ section_id }} .hg-small-card__image {
    background: #141414;
  }

  #{{ section_id }} .hg-small-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #{{ section_id }} .hg-small-card__content {
    padding: 16px;
  }

  #{{ section_id }} .hg-small-card__category {
    display: block;
    margin-bottom: 8px;
    color: var(--hg-gold);
    font-size: 9px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  #{{ section_id }} .hg-small-card__title {
    margin: 0;
    color: #fff;
    font-size: 17px;
    line-height: 1.14;
    font-weight: 900;
  }

  #{{ section_id }} .hg-small-card__desc {
    margin: 8px 0 0;
    color: rgba(255, 255, 255, 0.62);
    font-size: 12px;
    line-height: 1.38;
    font-weight: 600;
  }

  #{{ section_id }} .hg-small-card:hover,
  #{{ section_id }} .hg-small-card:focus-visible {
    transform: translateY(-3px);
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(200, 165, 106, 0.46);
  }

  @media screen and (max-width: 990px) {
    #{{ section_id }} .hg-grid,
    #{{ section_id }} .hg-small-grid {
      grid-template-columns: 1fr 1fr;
    }

    #{{ section_id }} .hg-section__head {
      display: grid;
    }
  }

  @media screen and (max-width: 680px) {
    #{{ section_id }} .hg-page-width {
      padding: 0 14px;
    }

    #{{ section_id }} .hg-hero {
      min-height: 390px;
    }

    #{{ section_id }} .hg-hero__content {
      padding: 82px 0 40px;
    }

    #{{ section_id }} .hg-section {
      padding: 38px 0;
    }

    #{{ section_id }} .hg-grid,
    #{{ section_id }} .hg-small-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    #{{ section_id }} .hg-card {
      min-height: 390px;
    }

    #{{ section_id }} .hg-card__content {
      padding: 20px;
    }

    #{{ section_id }} .hg-small-card {
      grid-template-columns: 118px minmax(0, 1fr);
      min-height: 132px;
    }

    #{{ section_id }} .hg-category {
      padding: 34px 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} * {
      transition: none !important;
    }
  }
</style>

<section id="{{ section_id }}">
  <div class="hg-hero">
    {%- if section.settings.hero_image != blank -%}
      <div class="hg-hero__media">
        {{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '720, 1100, 1600, 2400', alt: section.settings.hero_title }}
      </div>
    {%- endif -%}

    <div class="hg-page-width">
      <div class="hg-hero__content">
        <p class="hg-kicker">{{ section.settings.hero_kicker }}</p>
        <h1 class="hg-hero__title">{{ section.settings.hero_title }}</h1>
        <div class="hg-hero__subtitle">{{ section.settings.hero_subtitle }}</div>
      </div>
    </div>
  </div>

  <div class="hg-section hg-section--cream">
    <div class="hg-page-width">
      <div class="hg-section__head">
        <h2 class="hg-section__title">{{ section.settings.featured_heading }}</h2>
        {%- if section.settings.featured_text != blank -%}
          <p class="hg-section__text">{{ section.settings.featured_text }}</p>
        {%- endif -%}
      </div>

      <div class="hg-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'featured_guide' -%}
            <a class="hg-card" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
              <span class="hg-card__image">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 520, 760, 1000', alt: block.settings.title }}
                {%- endif -%}
              </span>
              <span class="hg-card__content">
                <span class="hg-card__category">{{ block.settings.category }}</span>
                <h3 class="hg-card__title">{{ block.settings.title }}</h3>
                {%- if block.settings.description != blank -%}
                  <span class="hg-card__desc">{{ block.settings.description }}</span>
                {%- endif -%}
                <span class="hg-card__button">{{ block.settings.button_text }}</span>
              </span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="hg-section">
    <div class="hg-page-width">
      <div class="hg-category">
        <h2 class="hg-category__title">{{ section.settings.nba_category_title }}</h2>
        <div class="hg-small-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'article_card' and block.settings.category_group == 'nba' -%}
              <a class="hg-small-card" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
                <span class="hg-small-card__image">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '180, 280, 420', alt: block.settings.title }}
                  {%- endif -%}
                </span>
                <span class="hg-small-card__content">
                  <span class="hg-small-card__category">{{ block.settings.category }}</span>
                  <h3 class="hg-small-card__title">{{ block.settings.title }}</h3>
                  {%- if block.settings.description != blank -%}<span class="hg-small-card__desc">{{ block.settings.description }}</span>{%- endif -%}
                </span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="hg-category">
        <h2 class="hg-category__title">{{ section.settings.world_category_title }}</h2>
        <div class="hg-small-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'article_card' and block.settings.category_group == 'world' -%}
              <a class="hg-small-card" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
                <span class="hg-small-card__image">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '180, 280, 420', alt: block.settings.title }}
                  {%- endif -%}
                </span>
                <span class="hg-small-card__content">
                  <span class="hg-small-card__category">{{ block.settings.category }}</span>
                  <h3 class="hg-small-card__title">{{ block.settings.title }}</h3>
                  {%- if block.settings.description != blank -%}<span class="hg-small-card__desc">{{ block.settings.description }}</span>{%- endif -%}
                </span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="hg-category">
        <h2 class="hg-category__title">{{ section.settings.streetwear_category_title }}</h2>
        <div class="hg-small-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'article_card' and block.settings.category_group == 'streetwear' -%}
              <a class="hg-small-card" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
                <span class="hg-small-card__image">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '180, 280, 420', alt: block.settings.title }}
                  {%- endif -%}
                </span>
                <span class="hg-small-card__content">
                  <span class="hg-small-card__category">{{ block.settings.category }}</span>
                  <h3 class="hg-small-card__title">{{ block.settings.title }}</h3>
                  {%- if block.settings.description != blank -%}<span class="hg-small-card__desc">{{ block.settings.description }}</span>{%- endif -%}
                </span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="hg-category">
        <h2 class="hg-category__title">{{ section.settings.buying_category_title }}</h2>
        <div class="hg-small-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'article_card' and block.settings.category_group == 'buying' -%}
              <a class="hg-small-card" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
                <span class="hg-small-card__image">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '180, 280, 420', alt: block.settings.title }}
                  {%- endif -%}
                </span>
                <span class="hg-small-card__content">
                  <span class="hg-small-card__category">{{ block.settings.category }}</span>
                  <h3 class="hg-small-card__title">{{ block.settings.title }}</h3>
                  {%- if block.settings.description != blank -%}<span class="hg-small-card__desc">{{ block.settings.description }}</span>{%- endif -%}
                </span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HOOPERS Guides",
  "settings": [
    { "type": "text", "id": "hero_kicker", "label": "Hero kicker", "default": "HOOPERS EDITORIAL" },
    { "type": "text", "id": "hero_title", "label": "Hero title", "default": "HOOPERS GUIDES" },
    { "type": "textarea", "id": "hero_subtitle", "label": "Hero subtitle", "default": "כל מה שצריך לדעת על NBA, World Cup, Streetwear וסטייל ספורטיבי." },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },

    { "type": "header", "content": "Featured guides" },
    { "type": "text", "id": "featured_heading", "label": "Featured heading", "default": "Featured Guides" },
    { "type": "textarea", "id": "featured_text", "label": "Featured text", "default": "מדריכים קצרים וברורים שיעזרו לבחור, למדוד ולשלב נכון." },

    { "type": "header", "content": "Category headings" },
    { "type": "text", "id": "nba_category_title", "label": "NBA category title", "default": "NBA" },
    { "type": "text", "id": "world_category_title", "label": "World Cup category title", "default": "WORLD CUP" },
    { "type": "text", "id": "streetwear_category_title", "label": "Streetwear category title", "default": "STREETWEAR" },
    { "type": "text", "id": "buying_category_title", "label": "Buying guides category title", "default": "BUYING GUIDES" }
  ],
  "blocks": [
    {
      "type": "featured_guide",
      "name": "Featured guide card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "category", "label": "Category label", "default": "NBA" },
        { "type": "text", "id": "title", "label": "Title", "default": "מדריך מידות לגופיות NBA" },
        { "type": "textarea", "id": "description", "label": "Short description", "default": "כל מה שצריך לדעת לפני שבוחרים גופיית NBA." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "button_text", "label": "Button text", "default": "READ GUIDE" }
