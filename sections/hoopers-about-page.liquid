{% liquid
  assign hero_overlay = section.settings.hero_overlay | divided_by: 100.0
%}

<section class="hoopers-about" dir="rtl">
  <div class="ha-hero" style="--ha-overlay: {{ hero_overlay }};">
    {% if section.settings.hero_desktop_image != blank %}
      <picture class="ha-hero__media">
        {% if section.settings.hero_mobile_image != blank %}
          <source media="(max-width: 749px)" srcset="{{ section.settings.hero_mobile_image | image_url: width: 900 }}">
        {% endif %}
        {{ section.settings.hero_desktop_image | image_url: width: 2400 | image_tag: loading: 'eager', class: 'ha-hero__image', alt: section.settings.hero_heading }}
      </picture>
    {% else %}
      <div class="ha-hero__placeholder"></div>
    {% endif %}

    <div class="ha-hero__overlay"></div>
    <div class="ha-hero__content">
      <p class="ha-kicker">{{ section.settings.hero_kicker }}</p>
      <h1>{{ section.settings.hero_heading }}</h1>
      <p>{{ section.settings.hero_subtitle }}</p>
      {% if section.settings.hero_button_text != blank and section.settings.hero_button_link != blank %}
        <a class="ha-button ha-button--light" href="{{ section.settings.hero_button_link }}">{{ section.settings.hero_button_text }}</a>
      {% endif %}
    </div>
  </div>

  <div class="ha-story ha-container">
    <div class="ha-story__text">
      <p class="ha-kicker">{{ section.settings.story_kicker }}</p>
      <h2>{{ section.settings.story_title }}</h2>
      <div class="ha-rte">{{ section.settings.story_text }}</div>
    </div>
    <div class="ha-story__media">
      {% if section.settings.story_image != blank %}
        {{ section.settings.story_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'ha-image', alt: section.settings.story_title }}
      {% endif %}
    </div>
  </div>

  <div class="ha-do">
    <div class="ha-container">
      <header class="ha-section-head">
        <p class="ha-kicker">{{ section.settings.do_kicker }}</p>
        <h2>{{ section.settings.do_title }}</h2>
      </header>

      <div class="ha-card-grid ha-card-grid--4">
        {% for i in (1..4) %}
          {% assign icon_id = 'do_' | append: i | append: '_icon' %}
          {% assign title_id = 'do_' | append: i | append: '_title' %}
          {% assign text_id = 'do_' | append: i | append: '_text' %}
          <article class="ha-card">
            <div class="ha-card__icon">{{ section.settings[icon_id] }}</div>
            <h3>{{ section.settings[title_id] }}</h3>
            <p>{{ section.settings[text_id] }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="ha-tour">
    <div class="ha-container">
      <header class="ha-section-head ha-section-head--light">
        <p class="ha-kicker">{{ section.settings.tour_kicker }}</p>
        <h2>{{ section.settings.tour_title }}</h2>
        <p>{{ section.settings.tour_text }}</p>
      </header>

      <div class="ha-tour__grid">
        {% for block in section.blocks %}
          {% if block.type == 'tour_image' %}
            <figure class="ha-tour__item" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'ha-image', alt: block.settings.caption }}
              {% endif %}
              {% if block.settings.caption != blank %}
                <figcaption>{{ block.settings.caption }}</figcaption>
              {% endif %}
            </figure>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="ha-stats">
    <div class="ha-container ha-stats__grid">
      {% for i in (1..4) %}
        {% assign value_id = 'stat_' | append: i | append: '_value' %}
        {% assign label_id = 'stat_' | append: i | append: '_label' %}
        <div class="ha-stat">
          <strong>{{ section.settings[value_id] }}</strong>
          <span>{{ section.settings[label_id] }}</span>
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="ha-why">
    <div class="ha-container">
      <header class="ha-section-head">
        <p class="ha-kicker">{{ section.settings.why_kicker }}</p>
        <h2>{{ section.settings.why_title }}</h2>
      </header>

      <div class="ha-card-grid ha-card-grid--3">
        {% for i in (1..3) %}
          {% assign icon_id = 'why_' | append: i | append: '_icon' %}
          {% assign title_id = 'why_' | append: i | append: '_title' %}
          {% assign text_id = 'why_' | append: i | append: '_text' %}
          <article class="ha-card ha-card--cream">
            <div class="ha-card__icon">{{ section.settings[icon_id] }}</div>
            <h3>{{ section.settings[title_id] }}</h3>
            <p>{{ section.settings[text_id] }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="ha-final">
    <div class="ha-final__inner">
      <p class="ha-kicker">{{ section.settings.final_kicker }}</p>
      <h2>{{ section.settings.final_title }}</h2>
      <p>{{ section.settings.final_text }}</p>
      {% if section.settings.final_button_text != blank and section.settings.final_button_link != blank %}
        <a class="ha-button ha-button--gold" href="{{ section.settings.final_button_link }}">{{ section.settings.final_button_text }}</a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .hoopers-about {
    --ha-black: #050505;
    --ha-cream: #ece7df;
    --ha-soft: #f7f4ee;
    --ha-gold: #c8a56a;
    --ha-text: #111;
    --ha-muted: rgba(17,17,17,.68);
    background: var(--ha-cream);
    color: var(--ha-text);
  }

  .ha-container {
    width: min(100%, 1480px);
    margin: 0 auto;
    padding: 0 clamp(16px, 3vw, 44px);
  }

  .ha-hero {
    position: relative;
    min-height: clamp(520px, 82vh, 820px);
    display: grid;
    align-items: end;
    overflow: hidden;
    background: var(--ha-black);
    color: #fff;
  }

  .ha-hero__media,
  .ha-hero__image,
  .ha-hero__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ha-hero__image {
    object-fit: cover;
  }

  .ha-hero__placeholder {
    background: linear-gradient(135deg, #050505, #24211b);
  }

  .ha-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0,0,0,var(--ha-overlay)), rgba(0,0,0,.18));
  }

  .ha-hero__content {
    position: relative;
    z-index: 2;
    max-width: 760px;
    padding: clamp(42px, 7vw, 92px);
  }

  .ha-kicker {
    margin: 0 0 12px;
    color: var(--ha-gold);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .18em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .ha-hero h1,
  .ha-section-head h2,
  .ha-story h2,
  .ha-final h2 {
    margin: 0;
    font-weight: 950;
    letter-spacing: 0;
    line-height: .98;
  }

  .ha-hero h1 {
    max-width: 680px;
    font-size: clamp(48px, 9vw, 118px);
  }

  .ha-hero__content p:not(.ha-kicker),
  .ha-final p,
  .ha-section-head p:not(.ha-kicker) {
    margin: 18px 0 0;
    font-size: clamp(16px, 1.7vw, 22px);
    font-weight: 650;
    line-height: 1.6;
  }

  .ha-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 28px;
    padding: 0 26px;
    text-decoration: none;
    font-size: 12px;
    font-weight: 950;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .ha-button--light {
    background: #fff;
    color: #050505;
  }

  .ha-button--gold {
    background: var(--ha-gold);
    color: #050505;
  }

  .ha-story {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(24px, 5vw, 76px);
    align-items: center;
    padding-top: clamp(56px, 8vw, 110px);
    padding-bottom: clamp(56px, 8vw, 110px);
  }

  .ha-story h2,
  .ha-section-head h2,
  .ha-final h2 {
    font-size: clamp(34px, 5vw, 72px);
  }

  .ha-rte {
    margin-top: 20px;
    color: var(--ha-muted);
    font-size: clamp(15px, 1.4vw, 18px);
    font-weight: 600;
    line-height: 1.9;
  }

  .ha-rte p {
    margin: 0;
  }

  .ha-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ha-story__media {
    min-height: 520px;
    background: #ddd5c9;
    overflow: hidden;
  }

  .ha-do,
  .ha-why {
    padding: clamp(54px, 7vw, 96px) 0;
  }

  .ha-do {
    background: var(--ha-soft);
  }

  .ha-section-head {
    max-width: 820px;
    margin: 0 auto clamp(28px, 4vw, 46px);
    text-align: center;
  }

  .ha-section-head--light {
    color: #fff;
  }

  .ha-card-grid {
    display: grid;
    gap: 14px;
  }

  .ha-card-grid--4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .ha-card-grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .ha-card {
    min-height: 230px;
    padding: clamp(22px, 2.6vw, 34px);
    background: #0b0b0b;
    color: #fff;
    border: 1px solid rgba(200,165,106,.28);
  }

  .ha-card--cream {
    background: var(--ha-soft);
    color: var(--ha-text);
    border-color: rgba(17,17,17,.1);
  }

  .ha-card__icon {
    margin-bottom: 28px;
    font-size: 28px;
  }

  .ha-card h3 {
    margin: 0 0 10px;
    font-size: clamp(19px, 2vw, 26px);
    font-weight: 950;
    line-height: 1.15;
  }

  .ha-card p {
    margin: 0;
    color: inherit;
    opacity: .72;
    font-size: 14px;
    font-weight: 650;
    line-height: 1.7;
  }

  .ha-tour {
    padding: clamp(56px, 8vw, 110px) 0;
    background: var(--ha-black);
    color: #fff;
  }

  .ha-tour__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .ha-tour__item {
    margin: 0;
    min-height: 420px;
    overflow: hidden;
    background: #111;
  }

  .ha-tour__item figcaption {
    padding: 12px 4px 0;
    color: rgba(255,255,255,.7);
    font-size: 13px;
    font-weight: 700;
  }

  .ha-stats {
    padding: clamp(34px, 5vw, 64px) 0;
    background: #111;
    color: #fff;
    border-top: 1px solid rgba(255,255,255,.1);
    border-bottom: 1px solid rgba(255,255,255,.1);
  }

  .ha-stats__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .ha-stat {
    text-align: center;
    padding: 18px;
  }

  .ha-stat strong {
    display: block;
    color: var(--ha-gold);
    font-size: clamp(26px, 3vw, 42px);
    font-weight: 950;
    line-height: 1;
  }

  .ha-stat span {
    display: block;
    margin-top: 9px;
    color: rgba(255,255,255,.78);
    font-size: 14px;
    font-weight: 750;
  }

  .ha-final {
    padding: clamp(56px, 8vw, 110px) 16px;
    background: #050505;
    color: #fff;
    text-align: center;
  }

  .ha-final__inner {
    max-width: 780px;
    margin: 0 auto;
  }

  @media screen and (max-width: 980px) {
    .ha-story,
    .ha-card-grid--4,
    .ha-card-grid--3,
    .ha-tour__grid,
    .ha-stats__grid {
      grid-template-columns: 1fr 1fr;
    }

    .ha-story {
      align-items: start;
    }
  }

  @media screen and (max-width: 640px) {
    .ha-hero {
      min-height: 620px;
    }

    .ha-hero__content {
      padding: 34px 18px;
    }

    .ha-story,
    .ha-card-grid--4,
    .ha-card-grid--3,
    .ha-tour__grid,
    .ha-stats__grid {
      grid-template-columns: 1fr;
    }

    .ha-story__media,
    .ha-tour__item {
      min-height: 360px;
    }

    .ha-card {
      min-height: auto;
    }
  }
</style>

