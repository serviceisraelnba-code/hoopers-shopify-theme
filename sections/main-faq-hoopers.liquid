{%- liquid
  assign section_id = 'hoopers-faq-' | append: section.id
-%}

<style>
  #{{ section_id }} {
    --hfq-black: #050505;
    --hfq-cream: #f7f2e8;
    --hfq-ink: #111111;
    --hfq-muted: rgba(17, 17, 17, 0.64);
    --hfq-gold: #c8a56a;
    --hfq-border: rgba(5, 5, 5, 0.1);
    background: var(--hfq-cream);
    color: var(--hfq-ink);
    direction: rtl;
  }

  #{{ section_id }} * {
    box-sizing: border-box;
  }

  #{{ section_id }} .hfq-page-width {
    width: min(100%, 1240px);
    margin: 0 auto;
    padding: 0 18px;
  }

  #{{ section_id }} .hfq-hero {
    position: relative;
    overflow: hidden;
    background: var(--hfq-black);
    color: #fff;
    padding: 92px 0 58px;
  }

  #{{ section_id }} .hfq-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(5, 5, 5, 0), rgba(5, 5, 5, 0.55)),
      radial-gradient(circle at 16% 16%, rgba(200, 165, 106, 0.18), transparent 34%);
    pointer-events: none;
  }

  #{{ section_id }} .hfq-hero__content {
    position: relative;
    z-index: 2;
    max-width: 900px;
  }

  #{{ section_id }} .hfq-kicker {
    margin: 0 0 16px;
    color: var(--hfq-gold);
    font-size: 11px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  #{{ section_id }} .hfq-title {
    margin: 0;
    color: #fff;
    font-size: clamp(38px, 6vw, 76px);
    line-height: 0.98;
    font-weight: 950;
    letter-spacing: 0.01em;
  }

  #{{ section_id }} .hfq-subtitle {
    max-width: 760px;
    margin: 20px 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(16px, 2vw, 22px);
    line-height: 1.55;
    font-weight: 650;
  }

  #{{ section_id }} .hfq-top-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-top: -28px;
    position: relative;
    z-index: 3;
  }

  #{{ section_id }} .hfq-card {
    min-height: 185px;
    background: #fff;
    border: 1px solid var(--hfq-border);
    padding: 22px;
    transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
  }

  #{{ section_id }} .hfq-card:hover {
    transform: translateY(-4px);
    border-color: rgba(200, 165, 106, 0.58);
    box-shadow: 0 18px 44px rgba(5, 5, 5, 0.08);
  }

  #{{ section_id }} .hfq-card__icon {
    display: block;
    margin-bottom: 14px;
    font-size: 25px;
    line-height: 1;
  }

  #{{ section_id }} .hfq-card__title {
    margin: 0;
    color: var(--hfq-ink);
    font-size: 22px;
    line-height: 1.08;
    font-weight: 950;
  }

  #{{ section_id }} .hfq-card__text {
    margin: 14px 0 0;
    color: var(--hfq-ink);
    font-size: 16px;
    line-height: 1.45;
    font-weight: 750;
  }

  #{{ section_id }} .hfq-section {
    padding: 44px 0;
  }

  #{{ section_id }} .hfq-category {
    padding: 34px 0;
    border-top: 1px solid rgba(5, 5, 5, 0.1);
  }

  #{{ section_id }} .hfq-category:first-child {
    border-top: 0;
    padding-top: 0;
  }

  #{{ section_id }} .hfq-section__title,
  #{{ section_id }} .hfq-category__title {
    margin: 0 0 24px;
    color: var(--hfq-ink);
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.015em;
  }

  #{{ section_id }} .hfq-accordion {
    display: grid;
    gap: 10px;
  }

  #{{ section_id }} details.hfq-item {
    background: #fff;
    border: 1px solid var(--hfq-border);
  }

  #{{ section_id }} .hfq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 20px 22px;
    color: var(--hfq-ink);
    cursor: pointer;
    list-style: none;
    font-size: 18px;
    line-height: 1.25;
    font-weight: 900;
  }

  #{{ section_id }} .hfq-item summary::-webkit-details-marker {
    display: none;
  }

  #{{ section_id }} .hfq-item summary::after {
    content: "+";
    flex: 0 0 auto;
    color: var(--hfq-gold);
    font-size: 28px;
    line-height: 1;
    font-weight: 500;
    transition: transform 0.2s ease;
  }

  #{{ section_id }} .hfq-item[open] summary::after {
    transform: rotate(45deg);
  }

  #{{ section_id }} .hfq-answer {
    padding: 0 22px 20px;
    color: var(--hfq-muted);
    font-size: 16px;
    line-height: 1.65;
    font-weight: 650;
  }

  #{{ section_id }} .hfq-seo {
    background: #fff;
    border: 1px solid var(--hfq-border);
    padding: 28px;
  }

  #{{ section_id }} .hfq-seo__title {
    margin: 0;
    color: var(--hfq-ink);
    font-size: clamp(26px, 3vw, 42px);
    line-height: 1.08;
    font-weight: 950;
  }

  #{{ section_id }} .hfq-seo__text {
    max-width: 980px;
    margin: 16px 0 0;
    color: var(--hfq-muted);
    font-size: 16px;
    line-height: 1.75;
    font-weight: 650;
  }

  #{{ section_id }} .hfq-cta {
    background: var(--hfq-black);
    color: #fff;
    padding: 42px 0;
  }

  #{{ section_id }} .hfq-cta__box {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: center;
  }

  #{{ section_id }} .hfq-cta__title {
    margin: 0;
    color: #fff;
    font-size: clamp(30px, 4vw, 54px);
    line-height: 1;
    font-weight: 950;
  }

  #{{ section_id }} .hfq-cta__text {
    max-width: 720px;
    margin: 12px 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 16px;
    line-height: 1.6;
    font-weight: 650;
  }

  #{{ section_id }} .hfq-cta__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  #{{ section_id }} .hfq-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 20px;
    background: #fff;
    color: var(--hfq-black);
    text-decoration: none;
    font-size: 12px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background 0.22s ease, color 0.22s ease;
  }

  #{{ section_id }} .hfq-button--outline {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.22);
  }

  #{{ section_id }} .hfq-button:hover,
  #{{ section_id }} .hfq-button:focus-visible {
    background: var(--hfq-gold);
    color: var(--hfq-black);
  }

  @media screen and (max-width: 990px) {
    #{{ section_id }} .hfq-top-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ section_id }} .hfq-cta__box {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 640px) {
    #{{ section_id }} .hfq-page-width {
      padding: 0 14px;
    }

    #{{ section_id }} .hfq-hero {
      padding: 74px 0 48px;
    }

    #{{ section_id }} .hfq-top-cards {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: -18px;
    }

    #{{ section_id }} .hfq-section {
      padding: 34px 0;
    }

    #{{ section_id }} .hfq-category {
      padding: 28px 0;
    }

    #{{ section_id }} .hfq-card,
    #{{ section_id }} .hfq-seo {
      padding: 22px;
    }

    #{{ section_id }} .hfq-button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} * {
      transition: none !important;
    }
  }
</style>

<section id="{{ section_id }}">
