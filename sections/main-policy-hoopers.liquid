    { "type": "header", "content": "HOOPERS Promise" },
    { "type": "text", "id": "promise_title", "label": "Promise title", "default": "למה לקוחות בוחרים HOOPERS?" },
    { "type": "text", "id": "promise_item_1", "label": "Promise item 1", "default": "משלוח חינם מעל 300₪" },
    { "type": "text", "id": "promise_item_2", "label": "Promise item 2", "default": "שירות לקוחות אישי" },
    { "type": "text", "id": "promise_item_3", "label": "Promise item 3", "default": "החלפת מידה" },
    { "type": "text", "id": "promise_item_4", "label": "Promise item 4", "default": "תשלום מאובטח" },

