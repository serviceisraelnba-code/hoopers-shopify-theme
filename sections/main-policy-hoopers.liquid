    { "type": "textarea", "id": "step_1_text", "label": "Step 1 text", "default": "בחרו מוצרים והשלימו רכישה באתר." },
    { "type": "text", "id": "step_2_title", "label": "Step 2 title", "default": "הכנת ההזמנה" },
