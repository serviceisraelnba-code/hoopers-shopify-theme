    { "type": "text", "id": "card_2_text", "label": "Card 2 text", "default": "עד 14 ימי עסקים" },
    { "type": "text", "id": "card_2_small", "label": "Card 2 small text" },

    { "type": "text", "id": "card_3_icon", "label": "Card 3 icon", "default": "🔄" },
    { "type": "text", "id": "card_3_title", "label": "Card 3 title", "default": "החלפת מידה" },
    { "type": "text", "id": "card_3_text", "label": "Card 3 text", "default": "אפשרית בהתאם למדיניות ההחלפות באתר" },
    { "type": "text", "id": "card_3_small", "label": "Card 3 small text" },

    { "type": "text", "id": "card_4_icon", "label": "Card 4 icon", "default": "📦" },
