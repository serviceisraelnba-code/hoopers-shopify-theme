<section class="hpf-section">
  {%- render 'hoopers-product-faq' -%}
</section>

<style>
  .hpf-section {
    background: #ece7df;
    color: #050505;
    padding: 64px 0;
  }

  .hpf__wrap {
    width: min(980px, calc(100% - 32px));
    margin: 0 auto;
  }

  .hpf__kicker {
    margin: 0 0 10px;
    color: #c8a56a;
    text-align: center;
    font-size: 11px;
    font-weight: 950;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .hpf__title {
    margin: 0 0 28px;
    text-align: center;
    color: #050505;
    font-size: clamp(30px, 3.4vw, 48px);
    line-height: 1.1;
    font-weight: 950;
    letter-spacing: 0;
  }

  .hpf__list {
    border-top: 1px solid rgba(5, 5, 5, 0.14);
    background: #f5f3ee;
  }

  .hpf__item {
    border-bottom: 1px solid rgba(5, 5, 5, 0.14);
  }

  .hpf__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    min-height: 64px;
    padding: 18px 22px;
    cursor: pointer;
    color: #050505;
    font-size: clamp(17px, 1.6vw, 22px);
    font-weight: 900;
    line-height: 1.35;
    list-style: none;
  }

  .hpf__item summary::-webkit-details-marker {
    display: none;
  }

  .hpf__icon {
    flex: 0 0 auto;
    color: #c8a56a;
    font-size: 20px;
    line-height: 1;
    transition: transform 0.24s ease;
  }

  .hpf__item[open] .hpf__icon {
    transform: rotate(180deg);
  }

  .hpf__content {
    padding: 0 22px 22px;
    color: rgba(5, 5, 5, 0.72);
    font-size: 16px;
    line-height: 1.85;
    animation: hpfOpen 0.24s ease;
  }

  @keyframes hpfOpen {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 749px) {
    .hpf-section {
      padding: 46px 0;
    }

    .hpf__wrap {
      width: min(100% - 24px, 640px);
    }

    .hpf__title {
      text-align: right;
      font-size: 34px;
    }

    .hpf__kicker {
      text-align: right;
    }

    .hpf__item summary {
      min-height: 58px;
      padding: 16px 14px;
      font-size: 17px;
    }

    .hpf__content {
      padding: 0 14px 18px;
      font-size: 15px;
    }
  }
</style>

{% schema %}
{
  "name": "HOOPERS Product FAQ",
  "settings": [],
  "presets": [
    {
      "name": "HOOPERS Product FAQ"
    }
  ]
}
{% endschema %}