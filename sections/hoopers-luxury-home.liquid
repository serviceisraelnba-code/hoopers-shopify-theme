x; margin-top: 30px; } .hh-button { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 26px; border: 1px solid currentColor; font-size: 13px; font-weight: 900; letter-spacing: 0.05em; text-transform: uppercase; transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease; } .hh-button--light { background: var(--hh-white); color: var(--hh-black); border-color: var(--hh-white); } .hh-button--dark { background: rgba(0, 0, 0, 0.25); color: var(--hh-white); border-color: rgba(255, 255, 255, 0.55); } .hh-button--outline-gold { background: transparent; color: var(--hh-black); border-color: var(--hh-gold); } .hh-button:hover { background: var(--hh-gold); border-color: var(--hh-gold); color: var(--hh-black); } .hh-vibes { padding: 42px 0 46px; background: var(--hh-cream); } .hh-vibe-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; } .hh-vibe-card { position: relative; display: block; min-height: 240px; overflow: hidden; background: #111; } .hh-vibe-card picture, .hh-vibe-card img { width: 100%; height: 100%; display: block; } .hh-vibe-card picture { position: absolute; inset: 0; } .hh-vibe-card img { object-fit: cover; transition: transform 0.45s ease; } .hh-vibe-card:hover img { transform: scale(1.04); } .hh-vibe-card__shade { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(0, 0, 0, 0.64), rgba(0, 0, 0, 0.08)); } .hh-vibe-card__title { position: absolute; left: 14px; right: 14px; bottom: 26px; color: var(--hh-white); text-align: center; font-size: clamp(20px, 2.1vw, 34px); font-weight: 950; line-height: 1; letter-spacing: 0.04em; text-transform: uppercase; } .hh-vibe-card__title:after { content: ""; display: block; width: 72px; height: 2px; margin: 16px auto 0; background: var(--hh-gold); } .hh-centered-cta { margin-top: 28px; text-align: center; } .hh-swipe-dots { display: none; } .hh-trust { padding: 28px 0; background: var(--hh-soft-black); color: var(--hh-wh