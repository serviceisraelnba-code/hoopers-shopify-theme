{% liquid
assign hero_desktop_image = section.settings.hero_desktop_image
if hero_desktop_image == blank
assign hero_desktop_image = section.settings.hero_image
endif
assign hero_mobile_image = section.settings.hero_mobile_image

assign editorial_desktop_image = section.settings.editorial_desktop_image
if editorial_desktop_image == blank
assign editorial_desktop_image = section.settings.editorial_image
endif
assign editorial_mobile_image = section.settings.editorial_mobile_image
%}

<section class="hoopers-home" dir="rtl"> <div class="hh-hero"> {%- if section.settings.button_1_link != blank -%} <a class="hh-hero__full-link" href="{{ section.settings.button_1_link }}" aria-label="{{ section.settings.hero_title | default: section.settings.button_1_text | default: 'HOOPERS' | escape }}"></a> {%- endif -%}
<picture class="hh-hero__media">
  {%- if hero_mobile_image != blank -%}
    <source media="(max-width: 749px)" srcset="{{ hero_mobile_image | image_url: width: 900 }}">
  {%- endif -%}
  {%- if hero_desktop_image != blank -%}
    {{ hero_desktop_image | image_url: width: 2400 | image_tag: loading: 'eager', class: 'hh-hero__image', alt: section.settings.hero_title }}
  {%- endif -%}
</picture>

<div class="hh-hero__overlay"></div>

<div class="hh-hero__content">
  {%- if section.settings.brand_text != blank -%}
    <p class="hh-hero__brand">{{ section.settings.brand_text }}</p>
  {%- endif -%}
  {%- if section.settings.hero_kicker != blank -%}
    <p class="hh-kicker">{{ section.settings.hero_kicker }}</p>
  {%- endif -%}
  {%- if section.settings.hero_title != blank -%}
    <h1>{{ section.settings.hero_title }}</h1>
  {%- endif -%}
  {%- if section.settings.hero_subtitle != blank -%}
    <div class="hh-hero__subtitle">{{ section.settings.hero_subtitle }}</div>
  {%- endif -%}

  <div class="hh-buttons">
    {%- if section.settings.button_1_text != blank and section.settings.button_1_link != blank -%}
      <a class="hh-button hh-button--light" href="{{ section.settings.button_1_link }}">{{ section.settings.button_1_text }}</a>
    {%- endif -%}
    {%- if section.settings.button_2_text != blank and section.settings.button_2_link != blank -%}
      <a class="hh-button hh-button--dark" href="{{ section.settings.button_2_link }}">{{ section.settings.button_2_text }}</a>
    {%- endif -%}
  </div>
</div>
</div> <div class="hh-vibes"> <div class="hh-wrap"> {%- if section.settings.vibe_title != blank -%} <h2 class="hh-section-title">{{ section.settings.vibe_title }}</h2> {%- endif -%}
  <div class="hh-vibe-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'vibe_card' -%}
        {% liquid
          assign vibe_desktop_image = block.settings.image
          assign vibe_mobile_image = block.settings.mobile_image
        %}
        <a class="hh-vibe-card" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
          <picture>
            {%- if vibe_mobile_image != blank -%}
              <source media="(max-width: 749px)" srcset="{{ vibe_mobile_image | image_url: width: 700 }}">
            {%- endif -%}
            {%- if vibe_desktop_image != blank -%}
              {{ vibe_desktop_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {%- endif -%}
          </picture>
          <span class="hh-vibe-card__shade"></span>
          {%- if block.settings.title != blank -%}
            <span class="hh-vibe-card__title">{{ block.settings.title }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.vibe_button_text != blank -%}
    <div class="hh-centered-cta">
      <a class="hh-button hh-button--outline-gold" href="{% if section.settings.vibe_button_link != blank %}{{ section.settings.vibe_button_link }}{% else %}#{% endif %}">
        {{ section.settings.vibe_button_text }}
      </a>
    </div>
  {%- endif -%}
</div>
</div> <div class="hh-trust"> <div class="hh-wrap hh-trust__grid"> <div class="hh-trust__item"> <span class="hh-trust__icon">▱</span> <div>{{ section.settings.benefit_1 }}</div> </div> <div class="hh-trust__item"> <span class="hh-trust__icon">↻</span> <div>{{ section.settings.benefit_2 }}</div> </div> <div class="hh-trust__item"> <span class="hh-trust__icon">☆</span> <div>{{ section.settings.benefit_3 }}</div> </div> <div class="hh-trust__item"> <span class="hh-trust__icon">▣</span> <div>{{ section.settings.benefit_4 }}</div> </div> </div> </div>
{%- if section.settings.marquee_text != blank -%}
<div class="hh-marquee" aria-hidden="true">
<div class="hh-marquee__track">
<span>{{ section.settings.marquee_text }}</span>
<span>{{ section.settings.marquee_text }}</span>
<span>{{ section.settings.marquee_text }}</span>
</div>
</div>
{%- endif -%}

<div class="hh-products"> <div class="hh-wrap"> {%- if section.settings.products_title != blank -%} <h2 class="hh-section-title">{{ section.settings.products_title }}</h2> {%- endif -%}
  {%- if section.settings.products_collection != blank -%}
    <div class="hh-product-grid">
      {%- for product in section.settings.products_collection.products limit: section.settings.products_limit -%}
        <a class="hh-product-card" href="{{ product.url }}">
          <div class="hh-product-card__image">
            {%- if product.featured_image != blank -%}
              {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}
            {%- endif -%}
          </div>
          <h3>{{ product.title }}</h3>
          <p>{{ product.price | money }}</p>
        </a>
      {%- endfor -%}
    </div>

    <div class="hh-swipe-dots hh-swipe-dots--dark" aria-hidden="true">
      {%- for product in section.settings.products_collection.products limit: section.settings.products_limit -%}
        <span></span>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.products_button_text != blank -%}
    <div class="hh-centered-cta">
      <a class="hh-button hh-button--outline-gold" href="{% if section.settings.products_button_link != blank %}{{ section.settings.products_button_link }}{% else %}#{% endif %}">
        {{ section.settings.products_button_text }}
      </a>
    </div>
  {%- endif -%}
</div>
</div> <div class="hh-why"> <div class="hh-wrap"> {%- if section.settings.why_kicker != blank -%} <p class="hh-why__kicker">{{ section.settings.why_kicker }}</p> {%- endif -%} {%- if section.settings.why_title != blank -%} <h2 class="hh-why__title">{{ section.settings.why_title }}</h2> {%- endif -%}
  <div class="hh-why__grid">
    <div class="hh-why-card">
      <span class="hh-why-card__icon">◇</span>
      <h3>{{ section.settings.why_1_title }}</h3>
      <p>{{ section.settings.why_1_text }}</p>
    </div>
    <div class="hh-why-card">
      <span class="hh-why-card__icon">↔</span>
      <h3>{{ section.settings.why_2_title }}</h3>
      <p>{{ section.settings.why_2_text }}</p>
    </div>
    <div class="hh-why-card">
      <span class="hh-why-card__icon">✦</span>
      <h3>{{ section.settings.why_3_title }}</h3>
      <p>{{ section.settings.why_3_text }}</p>
    </div>
  </div>

  <div class="hh-swipe-dots hh-swipe-dots--light" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </div>
</div>
</div> <div class="hh-editorial"> <div class="hh-editorial__inner"> {%- if section.settings.editorial_link != blank -%} <a class="hh-editorial__media hh-editorial__media--link" href="{{ section.settings.editorial_link }}" aria-label="{{ section.settings.editorial_title | default: section.settings.editorial_button | default: 'Shop The Look' | escape }}"> {%- else -%} <div class="hh-editorial__media"> {%- endif -%} <picture> {%- if editorial_mobile_image != blank -%} <source media="(max-width: 749px)" srcset="{{ editorial_mobile_image | image_url: width: 900 }}"> {%- endif -%} {%- if editorial_desktop_image != blank -%} {{ editorial_desktop_image | image_url: width: 2400 | image_tag: loading: 'lazy', class: 'hh-editorial__image', alt: section.settings.editorial_title }} {%- endif -%} </picture> {%- if section.settings.editorial_link != blank -%} </a> {%- else -%} </div> {%- endif -%}
  <div class="hh-editorial__overlay"></div>

  <div class="hh-editorial__content">
    {%- if section.settings.editorial_kicker != blank -%}
      <p class="hh-kicker">{{ section.settings.editorial_kicker }}</p>
    {%- endif -%}
    {%- if section.settings.editorial_title != blank -%}
      <h2>{{ section.settings.editorial_title }}</h2>
    {%- endif -%}
    {%- if section.settings.editorial_text != blank -%}
      <p>{{ section.settings.editorial_text }}</p>
    {%- endif -%}
    {%- if section.settings.editorial_button != blank and section.settings.editorial_link != blank -%}
      <a class="hh-button hh-button--light hh-editorial__button" href="{{ section.settings.editorial_link }}">{{ section.settings.editorial_button }}</a>
    {%- endif -%}
  </div>
</div>
</div> <div class="hh-community"> <div class="hh-wrap"> {%- if section.settings.community_kicker != blank -%} <p class="hh-community__kicker">{{ section.settings.community_kicker }}</p> {%- endif -%} {%- if section.settings.community_title != blank -%} <h2 class="hh-community__title">{{ section.settings.community_title }}</h2> {%- endif -%}
  <div class="hh-community__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'community_image' -%}
        {% liquid
          assign community_media_type = block.settings.media_type | default: 'image'
          assign community_alt = block.settings.alt_text | default: block.settings.alt
        %}
        <div class="hh-community-card" {{ block.shopify_attributes }}>
          {%- if community_media_type == 'video' and block.settings.video != blank -%}
            {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, poster: block.settings.video_poster_image, class: 'hh-community-card__media' }}
            <span class="hh-community-card__play">▶</span>
          {%- elsif block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', class: 'hh-community-card__media', alt: community_alt }}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
</div> <div class="hh-tour"> <div class="hh-wrap"> {%- if section.settings.tour_kicker != blank -%} <p class="hh-tour__kicker">{{ section.settings.tour_kicker }}</p> {%- endif -%} {%- if section.settings.tour_title != blank -%} <h2 class="hh-tour__title">{{ section.settings.tour_title }}</h2> {%- endif -%} {%- if section.settings.tour_text != blank -%} <div class="hh-tour__text">{{ section.settings.tour_text | newline_to_br }}</div> {%- endif -%}
  <div class="hh-tour__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'tour_image' -%}
        <div class="hh-tour-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.alt_text }}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.tour_button_text != blank -%}
    <div class="hh-tour__cta">
      <a class="hh-button hh-button--light" href="{% if section.settings.tour_button_link != blank %}{{ section.settings.tour_button_link }}{% else %}#{% endif %}">
        {{ section.settings.tour_button_text }}
      </a>
    </div>
  {%- endif -%}
</div>
</div> <div class="hh-faq"> <div class="hh-wrap"> {%- if section.settings.faq_kicker != blank -%} <p class="hh-faq__kicker">{{ section.settings.faq_kicker }}</p> {%- endif -%} {%- if section.settings.faq_title != blank -%} <h2 class="hh-faq__title">{{ section.settings.faq_title }}</h2> {%- endif -%}
  <div class="hh-faq__list">
    {%- for i in (1..5) -%}
      {% liquid
        assign question_key = 'faq_' | append: i | append: '_question'
        assign answer_key = 'faq_' | append: i | append: '_answer'
        assign question = section.settings[question_key]
        assign answer = section.settings[answer_key]
      %}
      {%- if question != blank or answer != blank -%}
        <details class="hh-faq__item">
          <summary>{{ question }}</summary>
          <div>{{ answer }}</div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
