{%- liquid
  assign section_id = 'hoopers-footer-' | append: section.id
-%}

<style>
  #{{ section_id }} {
    --hf-black: #050505;
    --hf-white: #ffffff;
    --hf-cream: #f7f2e8;
    --hf-muted: rgba(255, 255, 255, 0.62);
    --hf-soft: rgba(255, 255, 255, 0.1);
    --hf-gold: #c8a56a;
    --hf-gold-soft: rgba(200, 165, 106, 0.34);
    background: var(--hf-black);
    color: var(--hf-white);
    direction: rtl;
  }

  #{{ section_id }} * {
    box-sizing: border-box;
  }

  #{{ section_id }} .hf-page-width {
    width: min(100%, 1440px);
    margin: 0 auto;
    padding: 0 22px;
  }

  #{{ section_id }} .hf-main {
    padding: 54px 0 34px;
    border-top: 1px solid var(--hf-gold-soft);
  }

  #{{ section_id }} .hf-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr 1.1fr 1fr;
    gap: 34px;
    align-items: start;
  }

  #{{ section_id }} .hf-brand__title {
    margin: 0;
    color: var(--hf-white);
    font-size: clamp(34px, 4vw, 58px);
    line-height: 0.92;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #{{ section_id }} .hf-brand__subtitle {
    margin: 12px 0 0;
    color: var(--hf-gold);
    font-size: 13px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  #{{ section_id }} .hf-brand__text,
  #{{ section_id }} .hf-community__text,
  #{{ section_id }} .hf-newsletter__text {
    max-width: 390px;
    margin: 18px 0 0;
    color: var(--hf-muted);
    font-size: 15px;
    line-height: 1.6;
    font-weight: 650;
  }

  #{{ section_id }} .hf-title {
    margin: 0 0 18px;
    color: var(--hf-gold);
    font-size: 11px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  #{{ section_id }} .hf-links {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #{{ section_id }} .hf-links a {
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    font-size: 15px;
    line-height: 1.25;
    font-weight: 750;
    transition: color 0.18s ease, transform 0.18s ease;
  }

  #{{ section_id }} .hf-links a:hover,
  #{{ section_id }} .hf-links a:focus-visible {
    color: var(--hf-gold);
    transform: translateX(-3px);
  }

  #{{ section_id }} .hf-socials {
    display: flex;
    gap: 10px;
    margin-top: 18px;
  }

  #{{ section_id }} .hf-social {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--hf-white);
    border: 1px solid var(--hf-soft);
    text-decoration: none;
    transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease;
  }

  #{{ section_id }} .hf-social svg {
    width: 18px;
    height: 18px;
    display: block;
    fill: currentColor;
  }

  #{{ section_id }} .hf-social:hover,
  #{{ section_id }} .hf-social:focus-visible {
    color: var(--hf-black);
    background: var(--hf-gold);
    border-color: var(--hf-gold);
  }

  #{{ section_id }} .hf-newsletter {
    margin-top: 34px;
    padding-top: 28px;
    border-top: 1px solid var(--hf-gold-soft);
  }

  #{{ section_id }} .hf-newsletter__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 0.7fr);
    gap: 24px;
    align-items: end;
  }

  #{{ section_id }} .hf-newsletter__title {
    margin: 0;
    color: var(--hf-white);
    font-size: clamp(26px, 3vw, 42px);
    line-height: 1;
    font-weight: 950;
  }

  #{{ section_id }} .hf-form {
    display: flex;
    gap: 10px;
    width: 100%;
  }

  #{{ section_id }} .hf-form input[type="email"] {
    min-width: 0;
    flex: 1 1 auto;
    min-height: 52px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.06);
    color: var(--hf-white);
    padding: 0 16px;
    font: inherit;
    font-size: 15px;
    border-radius: 0;
    outline: none;
    direction: rtl;
  }

  #{{ section_id }} .hf-form input[type="email"]::placeholder {
    color: rgba(255, 255, 255, 0.46);
  }

  #{{ section_id }} .hf-form input[type="email"]:focus {
    border-color: var(--hf-gold);
    background: rgba(255, 255, 255, 0.09);
  }

  #{{ section_id }} .hf-form button {
    flex: 0 0 auto;
    min-height: 52px;
    border: 0;
    background: var(--hf-white);
    color: var(--hf-black);
    padding: 0 22px;
    cursor: pointer;
    font-size: 12px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 0;
    transition: background 0.18s ease;
  }

  #{{ section_id }} .hf-form button:hover,
  #{{ section_id }} .hf-form button:focus-visible {
    background: var(--hf-gold);
  }

  #{{ section_id }} .hf-form-message {
    margin: 12px 0 0;
    color: var(--hf-gold);
    font-size: 13px;
    line-height: 1.45;
    font-weight: 750;
  }

  #{{ section_id }} .hf-mobile-accordions {
    display: none;
  }

  #{{ section_id }} .hf-bottom {
    border-top: 1px solid var(--hf-gold-soft);
    padding: 18px 0;
  }

  #{{ section_id }} .hf-bottom__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  #{{ section_id }} .hf-copy {
    color: rgba(255, 255, 255, 0.64);
    font-size: 13px;
    line-height: 1.35;
    font-weight: 750;
  }

  #{{ section_id }} .hf-bottom__links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  #{{ section_id }} .hf-bottom__links a {
    color: rgba(255, 255, 255, 0.68);
    text-decoration: none;
    font-size: 13px;
    line-height: 1.35;
    font-weight: 750;
  }

  #{{ section_id }} .hf-bottom__links a:hover,
  #{{ section_id }} .hf-bottom__links a:focus-visible {
    color: var(--hf-gold);
  }

  @media screen and (max-width: 900px) {
    #{{ section_id }} .hf-main {
      padding: 40px 0 28px;
    }

    #{{ section_id }} .hf-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    #{{ section_id }} .hf-desktop-column {
      display: none;
    }

    #{{ section_id }} .hf-mobile-accordions {
      display: grid;
      gap: 0;
      margin-top: 28px;
      border-top: 1px solid var(--hf-gold-soft);
    }

    #{{ section_id }} .hf-mobile-accordions details {
      border-bottom: 1px solid var(--hf-gold-soft);
    }

    #{{ section_id }} .hf-mobile-accordions summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 18px 0;
      color: var(--hf-gold);
      cursor: pointer;
      list-style: none;
      font-size: 12px;
      line-height: 1;
      font-weight: 950;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    #{{ section_id }} .hf-mobile-accordions summary::-webkit-details-marker {
      display: none;
    }

    #{{ section_id }} .hf-mobile-accordions summary::after {
      content: "+";
      color: var(--hf-white);
      font-size: 24px;
      line-height: 1;
      font-weight: 400;
      transition: transform 0.18s ease;
    }

    #{{ section_id }} .hf-mobile-accordions details[open] summary::after {
      transform: rotate(45deg);
    }

    #{{ section_id }} .hf-mobile-panel {
      padding: 0 0 18px;
    }

    #{{ section_id }} .hf-links {
      gap: 14px;
    }

    #{{ section_id }} .hf-links a {
      font-size: 16px;
      display: inline-flex;
      padding: 2px 0;
    }

    #{{ section_id }} .hf-newsletter__inner {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    #{{ section_id }} .hf-bottom__inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media screen and (max-width: 560px) {
    #{{ section_id }} .hf-page-width {
      padding: 0 16px;
    }

    #{{ section_id }} .hf-form {
      display: grid;
      gap: 10px;
    }

    #{{ section_id }} .hf-form button {
      width: 100%;
    }

    #{{ section_id }} .hf-bottom__links {
      display: grid;
      gap: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} * {
      transition: none !important;
    }
  }
</style>

<footer id="{{ section_id }}" class="hf-footer">
  <div class="hf-main">
    <div class="hf-page-width">
      <div class="hf-grid">
        <div class="hf-brand">
          <h2 class="hf-brand__title">{{ section.settings.brand_title }}</h2>
          <p class="hf-brand__subtitle">{{ section.settings.brand_subtitle }}</p>
          <p class="hf-brand__text">{{ section.settings.brand_description }}</p>
        </div>

        <div class="hf-desktop-column">
          <h3 class="hf-title">{{ section.settings.shop_title }}</h3>
          <ul class="hf-links">
            <li><a href="{{ section.settings.shop_link_1_url }}">{{ section.settings.shop_link_1_label }}</a></li>
            <li><a href="{{ section.settings.shop_link_2_url }}">{{ section.settings.shop_link_2_label }}</a></li>
            <li><a href="{{ section.settings.shop_link_3_url }}">{{ section.settings.shop_link_3_label }}</a></li>
            <li><a href="{{ section.settings.shop_link_4_url }}">{{ section.settings.shop_link_4_label }}</a></li>
            <li><a href="{{ section.settings.shop_link_5_url }}">{{ section.settings.shop_link_5_label }}</a></li>
            <li><a href="{{ section.settings.shop_link_6_url }}">{{ section.settings.shop_link_6_label }}</a></li>
          </ul>
        </div>

        <div class="hf-desktop-column">
          <h3 class="hf-title">{{ section.settings.care_title }}</h3>
          <ul class="hf-links">
            <li><a href="{{ section.settings.care_link_1_url }}">{{ section.settings.care_link_1_label }}</a></li>
            <li><a href="{{ section.settings.care_link_2_url }}">{{ section.settings.care_link_2_label }}</a></li>
            <li><a href="{{ section.settings.care_link_3_url }}">{{ section.settings.care_link_3_label }}</a></li>
            <li><a href="{{ section.settings.care_link_4_url }}">{{ section.settings.care_link_4_label }}</a></li>
            <li><a href="{{ section.settings.care_link_5_url }}">{{ section.settings.care_link_5_label }}</a></li>
            <li><a href="{{ section.settings.care_link_6_url }}">{{ section.settings.care_link_6_label }}</a></li>
          </ul>
        </div>

        <div class="hf-desktop-column">
          <h3 class="hf-title">{{ section.settings.community_title }}</h3>
          <p class="hf-community__text">{{ section.settings.community_text }}</p>
          <div class="hf-socials">
            {%- if section.settings.instagram_url != blank -%}
              <a class="hf-social" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.75 2h8.5A5.76 5.76 0 0 1 22 7.75v8.5A5.76 5.76 0 0 1 16.25 22h-8.5A5.76 5.76 0 0 1 2 16.25v-8.5A5.76 5.76 0 0 1 7.75 2Zm0 2A3.75 3.75 0 0 0 4 7.75v8.5A3.75 3.75 0 0 0 7.75 20h8.5A3.75 3.75 0 0 0 20 16.25v-8.5A3.75 3.75 0 0 0 16.25 4h-8.5Zm8.75 2.1a1.4 1.4 0 1 1 0 2.8 1.4 1.4 0 0 1 0-2.8ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"/></svg>
              </a>
            {%- endif -%}

            {%- if section.settings.facebook_url != blank -%}
              <a class="hf-social" href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8.25V6.6c0-.8.53-.99.9-.99h2.28V2.13L14.04 2.1c-3.48 0-4.27 2.6-4.27 4.27v1.88H7v3.58h2.77V22H14V11.83h2.86l.38-3.58H14Z"/></svg>
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="hf-mobile-accordions">
        <details>
          <summary>{{ section.settings.shop_title }}</summary>
          <div class="hf-mobile-panel">
            <ul class="hf-links">
              <li><a href="{{ section.settings.shop_link_1_url }}">{{ section.settings.shop_link_1_label }}</a></li>
              <li><a href="{{ section.settings.shop_link_2_url }}">{{ section.settings.shop_link_2_label }}</a></li>
              <li><a href="{{ section.settings.shop_link_3_url }}">{{ section.settings.shop_link_3_label }}</a></li>
              <li><a href="{{ section.settings.shop_link_4_url }}">{{ section.settings.shop_link_4_label }}</a></li>
              <li><a href="{{ section.settings.shop_link_5_url }}">{{ section.settings.shop_link_5_label }}</a></li>
              <li><a href="{{ section.settings.shop_link_6_url }}">{{ section.settings.shop_link_6_label }}</a></li>
            </ul>
          </div>
        </details>

        <details>
          <summary>{{ section.settings.care_title }}</summary>
          <div class="hf-mobile-panel">
            <ul class="hf-links">
              <li><a href="{{ section.settings.care_link_1_url }}">{{ section.settings.care_link_1_label }}</a></li>
              <li><a href="{{ section.settings.care_link_2_url }}">{{ section.settings.care_link_2_label }}</a></li>
              <li><a href="{{ section.settings.care_link_3_url }}">{{ section.settings.care_link_3_label }}</a></li>
              <li><a href="{{ section.settings.care_link_4_url }}">{{ section.settings.care_link_4_label }}</a></li>
              <li><a href="{{ section.settings.care_link_5_url }}">{{ section.settings.care_link_5_label }}</a></li>
              <li><a href="{{ section.settings.care_link_6_url }}">{{ section.settings.care_link_6_label }}</a></li>
            </ul>
          </div>
        </details>

        <details>
          <summary>{{ section.settings.community_title }}</summary>
          <div class="hf-mobile-panel">
            <p class="hf-community__text">{{ section.settings.community_text }}</p>
            <div class="hf-socials">
              {%- if section.settings.instagram_url != blank -%}
                <a class="hf-social" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.75 2h8.5A5.76 5.76 0 0 1 22 7.75v8.5A5.76 5.76 0 0 1 16.25 22h-8.5A5.76 5.76 0 0 1 2 16.25v-8.5A5.76 5.76 0 0 1 7.75 2Zm0 2A3.75 3.75 0 0 0 4 7.75v8.5A3.75 3.75 0 0 0 7.75 20h8.5A3.75 3.75 0 0 0 20 16.25v-8.5A3.75 3.75 0 0 0 16.25 4h-8.5Zm8.75 2.1a1.4 1.4 0 1 1 0 2.8 1.4 1.4 0 0 1 0-2.8ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"/></svg>
                </a>
              {%- endif -%}

              {%- if section.settings.facebook_url != blank -%}
                <a class="hf-social" href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8.25V6.6c0-.8.53-.99.9-.99h2.28V2.13L14.04 2.1c-3.48 0-4.27 2.6-4.27 4.27v1.88H7v3.58h2.77V22H14V11.83h2.86l.38-3.58H14Z"/></svg>
                </a>
              {%- endif -%}
            </div>
          </div>
        </details>
      </div>

      <div class="hf-newsletter">
        <div class="hf-newsletter__inner">
          <div>
            <h3 class="hf-newsletter__title">{{ section.settings.newsletter_title }}</h3>
            <p class="hf-newsletter__text">{{ section.settings.newsletter_text }}</p>
          </div>

          <div>
            {%- form 'customer', id: 'HoopersFooterNewsletter', class: 'hf-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <input
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="{{ section.settings.newsletter_placeholder }}"
                required>
              <button type="submit">{{ section.settings.newsletter_button }}</button>
            {%- endform -%}

            {%- if form.posted_successfully? -%}
              <p class="hf-form-message">{{ section.settings.newsletter_success }}</p>
            {%- endif -%}

            {%- if form.errors -%}
              <div class="hf-form-message">{{ form.errors | default_errors }}</div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="hf-bottom">
    <div class="hf-page-width">
      <div class="hf-bottom__inner">
        <div class="hf-copy">{{ section.settings.copyright_text }}</div>

        <div class="hf-bottom__links">
          <a href="{{ section.settings.bottom_link_1_url }}">{{ section.settings.bottom_link_1_label }}</a>
          <a href="{{ section.settings.bottom_link_2_url }}">{{ section.settings.bottom_link_2_label }}</a>
          <a href="{{ section.settings.bottom_link_3_url }}">{{ section.settings.bottom_link_3_label }}</a>
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "SS - Footer #3",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "text", "id": "brand_title", "label": "Brand title", "default": "HOOPERS" },
    { "type": "text", "id": "brand_subtitle", "label": "Brand subtitle", "default": "BORN TO PLAY" },
    { "type": "textarea", "id": "brand_description", "label": "Brand description", "default": "מותג ספורט ולייף סטייל בהשראת NBA, Streetwear וכדורגל עולמי." },

    { "type": "header", "content": "Shop column" },
    { "type": "text", "id": "shop_title", "label": "Shop title", "default": "SHOP" },
    { "type": "text", "id": "shop_link_1_label", "label": "Shop link 1 label", "default": "NBA" },
    { "type": "url", "id": "shop_link_1_url", "label": "Shop link 1 URL" },
    { "type": "text", "id": "shop_link_2_label", "label": "Shop link 2 label", "default": "World Cup" },
    { "type": "url", "id": "shop_link_2_url", "label": "Shop link 2 URL" },
    { "type": "text", "id": "shop_link_3_label", "label": "Shop link 3 label", "default": "Jordan" },
    { "type": "url", "id": "shop_link_3_url", "label": "Shop link 3 URL" },
    { "type": "text", "id": "shop_link_4_label", "label": "Shop link 4 label", "default": "Fear Of God" },
    { "type": "url", "id": "shop_link_4_url", "label": "Shop link 4 URL" },
    { "type": "text", "id": "shop_link_5_label", "label": "Shop link 5 label", "default": "New Arrivals" },
    { "type": "url", "id": "shop_link_5_url", "label": "Shop link 5 URL" },
    { "type": "text", "id": "shop_link_6_label", "label": "Shop link 6 label", "default": "Sale" },
    { "type": "url", "id": "shop_link_6_url", "label": "Shop link 6 URL" },

    { "type": "header", "content": "Customer care column" },
    { "type": "text", "id": "care_title", "label": "Customer care title", "default": "CUSTOMER CARE" },
    { "type": "text", "id": "care_link_1_label", "label": "Care link 1 label", "default": "צור קשר" },
    { "type": "url", "id": "care_link_1_url", "label": "Care link 1 URL" },
    { "type": "text", "id": "care_link_2_label", "label": "Care link 2 label", "default": "מדריכים וטיפים" },
    { "type": "url", "id": "care_link_2_url", "label": "Care link 2 URL" },
    { "type": "text", "id": "care_link_3_label", "label": "Care link 3 label", "default": "מדיניות משלוחים" },
    { "type": "url", "id": "care_link_3_url", "label": "Care link 3 URL" },
    { "type": "text", "id": "care_link_4_label", "label": "Care link 4 label", "default": "מדיניות החזרות" },
    { "type": "url", "id": "care_link_4_url", "label": "Care link 4 URL" },
    { "type": "text", "id": "care_link_5_label", "label": "Care link 5 label", "default": "FAQ" },
    { "type": "url", "id": "care_link_5_url", "label": "Care link 5 URL" },
    { "type": "text", "id": "care_link_6_label", "label": "Care link 6 label", "default": "מדריך מידות" },
    { "type": "url", "id": "care_link_6_url", "label": "Care link 6 URL" },

    { "type": "header", "content": "Community" },
    { "type": "text", "id": "community_title", "label": "Community title", "default": "COMMUNITY" },
    { "type": "text", "id": "community_text", "label": "Community text", "default": "FOLLOW THE MOVEMENT" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },

    { "type": "header", "content": "Newsletter" },
    { "type": "text", "id": "newsletter_title", "label": "Newsletter title", "default": "הצטרפו למשפחת HOOPERS" },
    { "type": "textarea", "id": "newsletter_text", "label": "Newsletter text", "default": "קבלו עדכונים על דרופים חדשים, מדריכים ומבצעים." },
    { "type": "text", "id": "newsletter_placeholder", "label": "Email placeholder", "default": "האימייל שלכם" },
    { "type": "text", "id": "newsletter_button", "label": "Submit button", "default": "JOIN" },
