    .hoopers-collection-catalog .hh-search-collection-strip a,
    .hoopers-collection-catalog .hh-search-team-strip a,
    .hoopers-collection-catalog .hh-filter-refinement a,
    .hoopers-collection-catalog .hh-search-active-filters a {
