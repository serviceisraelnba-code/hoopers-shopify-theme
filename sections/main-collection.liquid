{%- liquid
  assign current_filter_size = 0

  for filter in collection.filters
    assign current_filter_size = current_filter_size | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign current_filter_size = current_filter_size | plus: 1
      endif
    endif
  endfor
-%}

<div
  class="collection-content hoopers-collection-catalog"
  data-section-id="{{ section.id }}"
  data-section-type="collection-grid"
>
  <div id="CollectionAjaxContent">
    <div class="page-width">
      <header class="hh-collection-title-block">
        <p class="hh-collection-title-block__eyebrow">HOOPERS COLLECTION</p>
        <h1 class="hh-collection-title-block__heading">{{ collection.title }}</h1>
      </header>
    </div>

    <div class="page-width">
      <div class="hh-search-results-page__layout" data-scroll-to>
        <aside class="hh-search-results-page__sidebar">
          {%- render 'collection-grid-filters',
            collection: collection,
            enable_sidebar: section.settings.enable_sidebar,
            filter_style: section.settings.filter_style,
            collapsed: section.settings.collapsed,
            enable_color_swatches: section.settings.enable_color_swatches
          -%}
        </aside>

        <div class="hh-search-results-page__content">
          {%- liquid
            for block in section.blocks
              case block.type
              when 'product_grid'
                assign paginate_by = block.settings.per_row | times: block.settings.rows_per_page
              endcase
            endfor
          -%}

          {%- paginate collection.products by paginate_by -%}
            {%- for block in section.blocks -%}
              <div {{ block.shopify_attributes }} {%- if block.type == 'product-grid' -%}data-scroll-to{%- endif -%}>
                {%- case block.type -%}
                  {%- when 'collection_description' -%}
                    {%- if collection.description != blank and current_filter_size == 0 -%}
                      <div class="rte collection__description">
                        {{ collection.description }}
                      </div>
                    {%- endif -%}

                  {%- when 'subcollections' -%}
                    {%- if paginate.current_page == 1 and current_filter_size == 0 -%}
                      {%- render 'subcollections', per_row: block.settings.subcollections_per_row -%}
                    {%- endif -%}

                  {%- when 'product_grid' -%}
                    <div data-scroll-to>
                      {%- render 'hoopers-filter-experience',
                        filter_source: collection,
                        context: 'collection'
                      -%}

                      {% render 'collection-grid',
                        collection: collection,
                        items: collection.products,
                        enable_sidebar: section.settings.enable_sidebar,
                        filter_style: section.settings.filter_style,
                        enable_sort: true,
                        enable_collection_count: block.settings.enable_collection_count,
                        per_row: block.settings.per_row,
                        mobile_flush_grid: block.settings.mobile_flush_grid,
                        quick_shop_enable: settings.quick_shop_enable
                      %}

                      {%- if collection.products.size == 0 and current_filter_size > 0 -%}
                        <div class="hh-collection-filter-empty">
                          <p class="hh-collection-filter-empty__kicker">FILTERS</p>
                          <h2>לא נמצאו מוצרים שמתאימים לסינון שבחרת</h2>
                          <p>נסו להסיר מסנן, לבחור סוג מוצר אחר או לעבור לאחת הקולקציות הפופולריות.</p>

                          <div class="hh-collection-filter-empty__actions">
                            <a href="{{ collection.url }}" data-search-action="clear-filters">Clear filters</a>
                            <a href="/collections/all" data-search-action="shop-all">SHOP ALL</a>
                          </div>

                          <div class="hh-collection-filter-empty__links" aria-label="Suggested product types and collections">
                            <span>Suggested product types</span>
                            <a href="/collections/גופיות">גופיות</a>
                            <a href="/collections/המכנסיים-שלנו">מכנסיים</a>
                            <a href="/collections/ילדים">ילדים</a>
                            <a href="/collections/jordan">Jordan</a>
                            <a href="/collections/fog">Fear Of God</a>
                            <a href="/collections/מונדיאל">World Cup</a>
                          </div>
                        </div>
                      {%- endif -%}

                      {%- if paginate.pages > 1 -%}
                        {%- render 'pagination', paginate: paginate -%}
                      {%- endif -%}
                    </div>
                {%- endcase -%}
              </div>
            {%- endfor -%}
          {%- endpaginate -%}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .hoopers-collection-catalog {
    --hh-bg: #ece7df;
    --hh-card: #f5f3ee;
    --hh-black: #050505;
    --hh-text: #111111;
    --hh-muted: rgba(17, 17, 17, 0.58);
    --hh-border: rgba(17, 17, 17, 0.1);
    --hh-gold: #c8a56a;

    background: var(--hh-bg);
    color: var(--hh-text);
    padding-bottom: clamp(38px, 5vw, 72px);
  }

  .hoopers-collection-catalog .page-width {
    max-width: 1560px;
  }

  .hoopers-collection-catalog .hh-collection-title-block {
    max-width: 940px;
    margin: 0 auto;
    padding: clamp(24px, 3.4vw, 42px) 0 clamp(18px, 2.6vw, 30px);
    text-align: center;
    background: transparent;
  }

  .hoopers-collection-catalog .hh-collection-title-block__eyebrow {
    margin: 0 0 10px;
    color: var(--hh-gold) !important;
    font-size: 10px !important;
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hoopers-collection-catalog .hh-collection-title-block__heading {
    margin: 0;
    color: var(--hh-black) !important;
    font-size: clamp(34px, 4.4vw, 62px) !important;
    line-height: 0.96;
    font-weight: 950 !important;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-align: center;
  }

  .hoopers-collection-catalog .grid__item--content {
    color: var(--hh-text);
  }

  .hoopers-collection-catalog .collection__description {
    max-width: 900px;
    margin: 0 auto 32px;
    color: var(--hh-muted);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.8;
    text-align: center;
  }

  .hoopers-collection-catalog .collection-filter,
  .hoopers-collection-catalog .collection-filter__item,
  .hoopers-collection-catalog .collection-filter__sort-container,
  .hoopers-collection-catalog .collection-filter select,
  .hoopers-collection-catalog .collection-filter button,
  .hoopers-collection-catalog .collection-filter__button {
    color: var(--hh-text);
  }

  .hoopers-collection-catalog .collection-filter {
    border-color: var(--hh-border);
    margin-bottom: clamp(18px, 2vw, 28px);
  }

  .hoopers-collection-catalog .hh-search-results-page__layout {
    display: grid;
    grid-template-columns: minmax(214px, 232px) minmax(0, 1fr);
    gap: clamp(14px, 1.7vw, 26px);
    align-items: start;
    direction: rtl;
  }

  .hoopers-collection-catalog .hh-search-results-page__sidebar,
  .hoopers-collection-catalog .hh-search-results-page__content {
    min-width: 0;
  }

  .hoopers-collection-catalog .collection-filter {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid var(--hh-border);
    background: var(--hh-card);
    color: var(--hh-text);
  }

  .hoopers-collection-catalog .collection-filter__item--count {
    color: var(--hh-muted);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hoopers-collection-catalog .collection-filter__item--sort {
    margin-inline-start: auto;
  }

  .hoopers-collection-catalog .collection-filter__item--drawer .btn {
    min-height: 42px;
    padding: 0 16px;
    border: 1px solid rgba(17, 17, 17, 0.14);
    background: var(--hh-black);
    color: #fff;
    font-size: 11px;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hoopers-collection-catalog .collection-filter__item--drawer .btn .icon {
    color: var(--hh-gold);
  }

  .hoopers-collection-catalog .collection-filter__sort-container {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hoopers-collection-catalog .collection-filter__sort-container::before {
    content: "SORT";
    color: var(--hh-muted);
    font-size: 10px;
    font-weight: 950;
    letter-spacing: 0.16em;
  }

  .hoopers-collection-catalog .collection-filter__sort-container::after {
    content: "";
    position: absolute;
    left: 12px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-left: 2px solid var(--hh-gold);
    border-bottom: 2px solid var(--hh-gold);
    transform: translateY(-65%) rotate(-45deg);
    pointer-events: none;
  }

  .hoopers-collection-catalog .collection-filter__sort-container select {
    min-width: 188px;
    min-height: 42px;
    padding-inline-end: 16px;
    padding-inline-start: 34px;
    appearance: none;
    -webkit-appearance: none;
    border-color: var(--hh-border);
    background-color: var(--hh-card);
    color: var(--hh-text);
    font-weight: 800;
  }

  .hoopers-collection-catalog .collection-sidebar {
    position: sticky;
    top: 94px;
    padding: 16px;
    border: 1px solid var(--hh-border);
    background: var(--hh-card);
  }

  .hoopers-collection-catalog .collection-sidebar__group {
    border-color: var(--hh-border);
  }

  .hoopers-collection-catalog .tag-list__header,
  .hoopers-collection-catalog .collapsible-trigger-btn {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    color: var(--hh-text);
    font-size: 12px;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hoopers-collection-catalog .tag__checkbox-wrapper,
  .hoopers-collection-catalog .tag__text {
    color: rgba(17, 17, 17, 0.72);
    font-weight: 750;
  }

  .hoopers-collection-catalog .tag--active .tag__text {
    color: var(--hh-text);
  }

  .hoopers-collection-catalog .tag__checkbox {
    border-color: rgba(200, 165, 106, 0.48);
  }

  .hoopers-collection-catalog .tag__input:checked + .tag__checkbox,
  .hoopers-collection-catalog .tag__input:checked ~ .tag__checkbox {
    background: var(--hh-gold);
    border-color: var(--hh-gold);
  }

  .hoopers-collection-catalog .hh-search-discovery {
    display: grid;
    gap: 12px;
    margin-bottom: clamp(16px, 2vw, 26px);
  }

  .hoopers-collection-catalog .hh-search-collection-strip,
  .hoopers-collection-catalog .hh-search-team-strip,
  .hoopers-collection-catalog .hh-filter-refinement,
  .hoopers-collection-catalog .hh-search-active-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 12px;
    border: 1px solid var(--hh-border);
    background: var(--hh-card);
  }

  .hoopers-collection-catalog .hh-search-collection-strip span,
  .hoopers-collection-catalog .hh-search-team-strip span,
  .hoopers-collection-catalog .hh-filter-refinement span,
  .hoopers-collection-catalog .hh-search-active-filters > span {
    color: var(--hh-gold);
    font-size: 10px;
    font-weight: 950;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hoopers-collection-catalog .hh-search-collection-strip a,
  .hoopers-collection-catalog .hh-search-team-strip a,
  .hoopers-collection-catalog .hh-filter-refinement a,
  .hoopers-collection-catalog .hh-filter-refinement span.hh-filter-refinement__chip,
  .hoopers-collection-catalog .hh-search-active-filters a {
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    gap: 7px;
    padding: 0 12px;
    border: 1px solid rgba(17, 17, 17, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.34);
    color: var(--hh-text);
    font-size: 12px;
    font-weight: 850;
    line-height: 1;
    text-decoration: none;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .hoopers-collection-catalog .hh-search-collection-strip a:hover,
  .hoopers-collection-catalog .hh-search-team-strip a:hover,
  .hoopers-collection-catalog .hh-filter-refinement a:hover,
  .hoopers-collection-catalog .hh-search-active-filters a:hover,
  .hoopers-collection-catalog .hh-filter-refinement__chip.is-active {
    transform: translateY(-1px);
    border-color: rgba(200, 165, 106, 0.68);
    background: var(--hh-black);
    color: #fff;
  }

  .hoopers-collection-catalog .hh-search-active-filters {
    border-color: rgba(200, 165, 106, 0.3);
  }

  .hoopers-collection-catalog .hh-search-active-filters a {
    background: #050505;
    color: #fff;
  }

  .hoopers-collection-catalog .hh-search-active-filters a b,
  .hoopers-collection-catalog .hh-filter-refinement__chip.is-active b {
    color: var(--hh-gold);
    font-size: 14px;
  }

  .hoopers-collection-catalog .hh-search-active-filters__clear {
    border-color: rgba(200, 165, 106, 0.56) !important;
    background: transparent !important;
    color: var(--hh-text) !important;
  }

  .hoopers-collection-catalog #FilterDrawer {
    z-index: 9999;
  }

  .hoopers-collection-catalog #FilterDrawer .drawer__contents,
  .hoopers-collection-catalog #FilterDrawer .drawer__fixed-header {
    background: #050505;
    color: #fff;
  }

  .hoopers-collection-catalog #FilterDrawer .drawer__fixed-header {
    border-bottom: 1px solid rgba(200, 165, 106, 0.24);
  }

  .hoopers-collection-catalog #FilterDrawer .drawer__header {
    color: #fff;
    direction: rtl;
    text-align: right;
  }

  .hoopers-collection-catalog #FilterDrawer .drawer__title {
    color: #fff;
    font-size: 18px;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hoopers-collection-catalog #FilterDrawer .drawer__close-button,
  .hoopers-collection-catalog #FilterDrawer .drawer__close-button .icon {
    color: var(--hh-gold);
    stroke: currentColor;
  }

  .hoopers-collection-catalog #FilterDrawer .drawer__scrollable {
    padding: 18px;
  }

  .hoopers-collection-catalog #FilterDrawer .tag-list--active-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .hoopers-collection-catalog #FilterDrawer .tag--remove .btn {
    background: rgba(200, 165, 106, 0.14);
    border-color: rgba(200, 165, 106, 0.34);
    color: #fff;
  }

  .hoopers-collection-catalog #FilterDrawer .collection-sidebar__group {
    border-color: rgba(255, 255, 255, 0.12);
  }

  .hoopers-collection-catalog #FilterDrawer .collapsible-trigger-btn,
  .hoopers-collection-catalog #FilterDrawer .tag-list__header {
    color: #fff;
  }

  .hoopers-collection-catalog #FilterDrawer .tag__checkbox-wrapper,
  .hoopers-collection-catalog #FilterDrawer .tag__text,
  .hoopers-collection-catalog #FilterDrawer .price-range__display-wrapper,
  .hoopers-collection-catalog #FilterDrawer .price-range__input {
    color: rgba(255, 255, 255, 0.72);
  }

  .hoopers-collection-catalog #FilterDrawer .tag--active .tag__text {
    color: #fff;
  }

  .hoopers-collection-catalog .hh-filter-refinement {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: clamp(16px, 2vw, 24px);
    padding: 12px;
    border: 1px solid var(--hh-border);
    background: var(--hh-card);
  }

  .hoopers-collection-catalog .hh-filter-refinement span {
    color: var(--hh-gold);
    font-size: 10px;
    font-weight: 950;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hoopers-collection-catalog .hh-filter-refinement a,
  .hoopers-collection-catalog .hh-filter-refinement span.hh-filter-refinement__chip {
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    gap: 7px;
    padding: 0 12px;
    border: 1px solid rgba(17, 17, 17, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.34);
    color: var(--hh-text);
    font-size: 12px;
    font-weight: 850;
    line-height: 1;
    text-decoration: none;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .hoopers-collection-catalog .hh-filter-refinement span.hh-filter-refinement__chip.is-disabled {
    cursor: not-allowed;
    opacity: 0.42;
    background: rgba(255, 255, 255, 0.22);
    color: rgba(17, 17, 17, 0.48);
  }

  .hoopers-collection-catalog .hh-filter-refinement a:hover,
  .hoopers-collection-catalog .hh-filter-refinement__chip.is-active {
    transform: translateY(-1px);
    border-color: rgba(200, 165, 106, 0.68);
    background: var(--hh-black);
    color: #fff;
  }

  .hoopers-collection-catalog .hh-filter-refinement__chip.is-active b {
    color: var(--hh-gold);
    font-size: 14px;
  }

  .hoopers-collection-catalog .hh-collection-filter-empty {
    display: grid;
    gap: 14px;
    margin: clamp(18px, 3vw, 34px) 0;
    padding: clamp(28px, 4vw, 54px);
    border: 1px solid rgba(200, 165, 106, 0.34);
    background: linear-gradient(135deg, #f5f3ee 0%, #ece7df 100%);
    text-align: center;
  }

  .hoopers-collection-catalog .hh-collection-filter-empty__kicker,
  .hoopers-collection-catalog .hh-collection-filter-empty__links span {
    margin: 0;
    color: var(--hh-gold);
    font-size: 10px;
    font-weight: 950;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hoopers-collection-catalog .hh-collection-filter-empty h2 {
    margin: 0;
    color: var(--hh-text);
    font-size: clamp(28px, 3.4vw, 48px);
    font-weight: 950;
    line-height: 1.05;
  }

  .hoopers-collection-catalog .hh-collection-filter-empty p {
    max-width: 680px;
    margin: 0 auto;
    color: var(--hh-muted);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.8;
  }

  .hoopers-collection-catalog .hh-collection-filter-empty__actions,
  .hoopers-collection-catalog .hh-collection-filter-empty__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 9px;
  }

  .hoopers-collection-catalog .hh-collection-filter-empty__actions a,
  .hoopers-collection-catalog .hh-collection-filter-empty__links a {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    justify-content: center;
    padding: 0 14px;
    border: 1px solid var(--hh-border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.34);
    color: var(--hh-text);
    font-size: 12px;
    font-weight: 900;
    text-decoration: none;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .hoopers-collection-catalog .hh-collection-filter-empty__actions a:first-child {
    border-color: rgba(200, 165, 106, 0.72);
    background: var(--hh-black);
    color: #fff;
  }

  .hoopers-collection-catalog .hh-collection-filter-empty__actions a:hover,
  .hoopers-collection-catalog .hh-collection-filter-empty__links a:hover {
    transform: translateY(-1px);
    border-color: rgba(200, 165, 106, 0.72);
    background: var(--hh-gold);
    color: var(--hh-black);
  }

  .hoopers-collection-catalog .grid,
  .hoopers-collection-catalog .grid--uniform {
    display: flex;
    flex-wrap: wrap;
  }

  .hoopers-collection-catalog .grid-product {
    padding-left: clamp(8px, 1.2vw, 16px);
    padding-right: clamp(8px, 1.2vw, 16px);
    margin-bottom: clamp(24px, 3vw, 44px);
  }

  @media screen and (min-width: 769px) {
    .hoopers-collection-catalog .grid-product {
      width: 33.333333% !important;
      flex: 0 0 33.333333% !important;
      max-width: 33.333333% !important;
    }
  }

  .hoopers-collection-catalog .grid-product__content,
  .hoopers-collection-catalog .grid-product__link {
    position: relative;
    display: block;
    color: var(--hh-text);
    text-decoration: none;
  }

  .hoopers-collection-catalog .grid-product__image-mask,
  .hoopers-collection-catalog .image-wrap,
  .hoopers-collection-catalog .grid-product__image-wrapper {
    position: relative;
    overflow: hidden;
    background: #ded8cd;
    border: 1px solid var(--hh-border);
  }

  .hoopers-collection-catalog .grid-product__image-mask::after,
  .hoopers-collection-catalog .image-wrap::after,
  .hoopers-collection-catalog .grid-product__image-wrapper::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 58%, rgba(0, 0, 0, 0.16) 100%);
    opacity: 0;
    transition: opacity 240ms ease;
  }

  .hoopers-collection-catalog .grid-product__image,
  .hoopers-collection-catalog .grid-product__secondary-image,
  .hoopers-collection-catalog .grid-product__image-mask img,
  .hoopers-collection-catalog .image-wrap img,
  .hoopers-collection-catalog .grid-product__image-wrapper img {
    transition: transform 420ms ease, opacity 260ms ease, filter 260ms ease;
    will-change: transform;
  }

  .hoopers-collection-catalog .grid-product:hover .grid-product__image,
  .hoopers-collection-catalog .grid-product:hover .grid-product__image-mask img,
  .hoopers-collection-catalog .grid-product:hover .image-wrap img,
  .hoopers-collection-catalog .grid-product:hover .grid-product__image-wrapper img {
    transform: scale(1.035);
    filter: contrast(1.03);
  }

  .hoopers-collection-catalog .grid-product:hover .grid-product__image-mask::after,
  .hoopers-collection-catalog .grid-product:hover .image-wrap::after,
  .hoopers-collection-catalog .grid-product:hover .grid-product__image-wrapper::after {
    opacity: 1;
  }

  .hoopers-collection-catalog .grid-product__meta {
    padding: 13px 0 0;
    text-align: right;
    color: var(--hh-text);
  }

  .hoopers-collection-catalog .grid-product__vendor {
    margin: 0 0 5px;
    color: var(--hh-muted);
    font-size: 10px;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hoopers-collection-catalog .grid-product__title,
  .hoopers-collection-catalog .grid-product__title a {
    color: var(--hh-text);
    font-size: clamp(13px, 1.05vw, 15px);
    font-weight: 850;
    line-height: 1.35;
