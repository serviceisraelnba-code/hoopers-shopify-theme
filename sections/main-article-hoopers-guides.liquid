{%- liquid
  assign section_id = 'hoopers-article-' | append: section.id
  assign article_category = section.settings.category_label
  if article_category == blank and article.tags.size > 0
    assign article_category = article.tags.first
  endif
  if article_category == blank
    assign article_category = blog.title
  endif
-%}

<style>
  #{{ section_id }} {
    --ha-black: #050505;
    --ha-cream: #f7f2e8;
    --ha-ink: #111111;
    --ha-muted: rgba(17, 17, 17, 0.62);
    --ha-gold: #c8a56a;
    --ha-border: rgba(5, 5, 5, 0.1);
    background: var(--ha-cream);
    color: var(--ha-ink);
    direction: rtl;
  }

  #{{ section_id }} * {
    box-sizing: border-box;
  }

  #{{ section_id }} .ha-page-width {
    width: min(100%, 1440px);
    margin: 0 auto;
    padding: 0 18px;
  }

  #{{ section_id }} .ha-hero {
    position: relative;
    min-height: 520px;
    display: flex;
    align-items: end;
    overflow: hidden;
    background: var(--ha-black);
    color: #fff;
  }

  #{{ section_id }} .ha-hero__image {
    position: absolute;
    inset: 0;
    opacity: 0.72;
  }

  #{{ section_id }} .ha-hero__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #{{ section_id }} .ha-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(5, 5, 5, 0.18), rgba(5, 5, 5, 0.9)),
      radial-gradient(circle at 18% 18%, rgba(200, 165, 106, 0.18), transparent 34%);
  }

  #{{ section_id }} .ha-hero__content {
    position: relative;
    z-index: 2;
    width: min(100%, 980px);
    padding: 110px 0 58px;
  }

  #{{ section_id }} .ha-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-bottom: 18px;
    color: var(--ha-gold);
    font-size: 11px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  #{{ section_id }} .ha-meta__date {
    color: rgba(255, 255, 255, 0.72);
  }

  #{{ section_id }} .ha-title {
    margin: 0;
    color: #fff;
    font-size: clamp(42px, 7vw, 96px);
    line-height: 0.92;
    font-weight: 950;
    letter-spacing: 0.025em;
  }

  #{{ section_id }} .ha-excerpt {
    max-width: 760px;
    margin: 22px 0 0;
    color: rgba(255, 255, 255, 0.74);
    font-size: clamp(16px, 2vw, 22px);
    line-height: 1.55;
    font-weight: 650;
  }

  #{{ section_id }} .ha-article-wrap {
    padding: 54px 0 42px;
  }

  #{{ section_id }} .ha-article {
    max-width: 900px;
    margin: 0 auto;
    color: var(--ha-ink);
    font-size: 18px;
    line-height: 1.86;
    font-weight: 500;
  }

  #{{ section_id }} .ha-article > *:first-child {
    margin-top: 0;
  }

  #{{ section_id }} .ha-article p,
  #{{ section_id }} .ha-article ul,
  #{{ section_id }} .ha-article ol,
  #{{ section_id }} .ha-article blockquote {
    margin: 0 0 26px;
  }

  #{{ section_id }} .ha-article h2 {
    margin: 54px 0 18px;
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.05;
    font-weight: 950;
    letter-spacing: 0.01em;
  }

  #{{ section_id }} .ha-article h3 {
    margin: 40px 0 14px;
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.12;
    font-weight: 900;
  }

  #{{ section_id }} .ha-article h4 {
    margin: 32px 0 12px;
    font-size: 22px;
    line-height: 1.2;
    font-weight: 900;
  }

  #{{ section_id }} .ha-article a {
    color: var(--ha-ink);
    text-decoration-color: var(--ha-gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  #{{ section_id }} .ha-article img {
    width: 100%;
    height: auto;
    display: block;
    margin: 38px 0;
  }

  #{{ section_id }} .ha-article blockquote {
    border-right: 4px solid var(--ha-gold);
    padding: 18px 22px;
    background: rgba(5, 5, 5, 0.045);
    font-size: 21px;
    line-height: 1.65;
    font-weight: 750;
  }

  #{{ section_id }} .ha-section {
    padding: 54px 0;
  }

  #{{ section_id }} .ha-section--dark {
    background: var(--ha-black);
    color: #fff;
  }

  #{{ section_id }} .ha-section__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  #{{ section_id }} .ha-section__title {
    margin: 0;
    font-size: clamp(28px, 4vw, 50px);
    line-height: 0.96;
    font-weight: 950;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  #{{ section_id }} .ha-products {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  #{{ section_id }} .ha-product {
    display: block;
    color: var(--ha-ink);
    text-decoration: none;
    background: #fff;
    overflow: hidden;
    border: 1px solid var(--ha-border);
    transition: transform 0.22s ease, border-color 0.22s ease;
  }

  #{{ section_id }} .ha-product__image {
    aspect-ratio: 1 / 1.18;
    background: #eee;
    overflow: hidden;
  }

  #{{ section_id }} .ha-product__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.36s ease;
  }

  #{{ section_id }} .ha-product__content {
    padding: 14px;
  }

  #{{ section_id }} .ha-product__title {
    margin: 0;
    font-size: 15px;
    line-height: 1.25;
    font-weight: 850;
  }

  #{{ section_id }} .ha-product__price {
    display: block;
    margin-top: 8px;
    color: rgba(17, 17, 17, 0.68);
    font-size: 13px;
    font-weight: 750;
  }

  #{{ section_id }} .ha-product:hover {
    transform: translateY(-3px);
    border-color: rgba(200, 165, 106, 0.55);
  }

  #{{ section_id }} .ha-product:hover img {
    transform: scale(1.045);
  }

  #{{ section_id }} .ha-guides {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  #{{ section_id }} .ha-guide {
    position: relative;
    min-height: 390px;
    display: flex;
    overflow: hidden;
    background: #111;
    color: #fff;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.08);
    isolation: isolate;
  }

  #{{ section_id }} .ha-guide__image {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #151515;
  }

  #{{ section_id }} .ha-guide__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.01);
    transition: transform 0.42s ease, opacity 0.42s ease;
  }

  #{{ section_id }} .ha-guide::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(5, 5, 5, 0.08), rgba(5, 5, 5, 0.9));
  }

  #{{ section_id }} .ha-guide__content {
    position: relative;
    z-index: 2;
    align-self: end;
    width: 100%;
    padding: 22px;
  }

  #{{ section_id }} .ha-guide__category {
    display: block;
    margin-bottom: 11px;
    color: var(--ha-gold);
    font-size: 10px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  #{{ section_id }} .ha-guide__title {
    margin: 0;
    color: #fff;
    font-size: clamp(22px, 2.5vw, 31px);
    line-height: 1.04;
    font-weight: 950;
  }

  #{{ section_id }} .ha-guide__desc {
    display: block;
    margin-top: 12px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 14px;
    line-height: 1.45;
    font-weight: 600;
  }

  #{{ section_id }} .ha-guide:hover img {
    transform: scale(1.06);
    opacity: 0.84;
  }

  #{{ section_id }} .ha-cta {
    background: var(--ha-black);
    color: #fff;
    padding: 64px 0;
    text-align: center;
    border-top: 1px solid rgba(200, 165, 106, 0.22);
  }

  #{{ section_id }} .ha-cta__brand {
    margin: 0 0 10px;
    color: var(--ha-gold);
    font-size: 13px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  #{{ section_id }} .ha-cta__title {
    margin: 0;
    color: #fff;
    font-size: clamp(44px, 7vw, 90px);
    line-height: 0.9;
    font-weight: 950;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  #{{ section_id }} .ha-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 26px;
    padding: 0 24px;
    background: #fff;
    color: #050505;
    text-decoration: none;
    font-size: 12px;
    font-weight: 950;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background 0.22s ease;
  }

  #{{ section_id }} .ha-cta__button:hover {
    background: var(--ha-gold);
  }

  @media screen and (max-width: 990px) {
    #{{ section_id }} .ha-products,
    #{{ section_id }} .ha-guides {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ section_id }} .ha-section__head {
      display: block;
    }
  }

  @media screen and (max-width: 680px) {
    #{{ section_id }} .ha-page-width {
      padding: 0 14px;
    }

    #{{ section_id }} .ha-hero {
      min-height: 430px;
    }

    #{{ section_id }} .ha-hero__content {
      padding: 88px 0 42px;
    }

    #{{ section_id }} .ha-article-wrap,
    #{{ section_id }} .ha-section {
      padding: 38px 0;
    }

    #{{ section_id }} .ha-article {
      font-size: 16px;
      line-height: 1.78;
    }

    #{{ section_id }} .ha-products,
    #{{ section_id }} .ha-guides {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    #{{ section_id }} .ha-guide {
      min-height: 360px;
    }

    #{{ section_id }} .ha-cta {
      padding: 48px 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} * {
      transition: none !important;
    }
  }
</style>

<article id="{{ section_id }}">
  <header class="ha-hero">
    {%- if article.image != blank -%}
      <div class="ha-hero__image">
        {{ article.image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '720, 1100, 1600, 2400', alt: article.title }}
      </div>
    {%- endif -%}

    <div class="ha-page-width">
      <div class="ha-hero__content">
        <div class="ha-meta">
          <span>{{ article_category }}</span>
          {%- if section.settings.show_date -%}
            <span class="ha-meta__date">{{ article.published_at | date: section.settings.date_format }}</span>
          {%- endif -%}
        </div>
        <h1 class="ha-title">{{ article.title }}</h1>
        {%- if article.excerpt != blank and section.settings.show_excerpt -%}
          <div class="ha-excerpt">{{ article.excerpt }}</div>
        {%- endif -%}
      </div>
    </div>
  </header>

  <div class="ha-article-wrap">
    <div class="ha-page-width">
      <div class="ha-article rte">
        {{ article.content }}
      </div>
    </div>
  </div>

  {%- assign product_count = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'product' and block.settings.product != blank -%}
      {%- assign product_count = product_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if product_count > 0 -%}
    <section class="ha-section">
      <div class="ha-page-width">
        <div class="ha-section__head">
          <h2 class="ha-section__title">{{ section.settings.products_title }}</h2>
        </div>

        <div class="ha-products">
          {%- for block in section.blocks limit: 4 -%}
            {%- if block.type == 'product' and block.settings.product != blank -%}
              {%- assign product = block.settings.product -%}
              <a class="ha-product" href="{{ product.url }}" {{ block.shopify_attributes }}>
                <div class="ha-product__image">
                  {%- if product.featured_image != blank -%}
                    {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '260, 420, 700', alt: product.title }}
                  {%- endif -%}
                </div>
                <div class="ha-product__content">
                  <h3 class="ha-product__title">{{ product.title }}</h3>
                  <span class="ha-product__price">{{ product.price | money }}</span>
                </div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  <section class="ha-section ha-section--dark">
    <div class="ha-page-width">
      <div class="ha-section__head">
        <h2 class="ha-section__title">{{ section.settings.related_guides_title }}</h2>
      </div>

      <div class="ha-guides">
        {%- for block in section.blocks -%}
          {%- if block.type == 'guide' -%}
            <a class="ha-guide" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
              <span class="ha-guide__image">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 520, 760, 1000', alt: block.settings.title }}
                {%- endif -%}
              </span>
              <span class="ha-guide__content">
                <span class="ha-guide__category">{{ block.settings.category }}</span>
                <h3 class="ha-guide__title">{{ block.settings.title }}</h3>
                {%- if block.settings.description != blank -%}
                  <span class="ha-guide__desc">{{ block.settings.description }}</span>
                {%- endif -%}
              </span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="ha-cta">
    <div class="ha-page-width">
      <p class="ha-cta__brand">{{ section.settings.cta_brand }}</p>
      <h2 class="ha-cta__title">{{ section.settings.cta_title }}</h2>
      {%- if section.settings.cta_button_link != blank -%}
        <a class="ha-cta__button" href="{{ section.settings.cta_button_link }}">{{ section.settings.cta_button_text }}</a>
      {%- endif -%}
    </div>
  </section>
</article>

{% schema %}
{
  "name": "HOOPERS Guide Article",
  "settings": [
    { "type": "text", "id": "category_label", "label": "Category label override" },
    { "type": "checkbox", "id": "show_date", "label": "Show publication date", "default": true },
    { "type": "text", "id": "date_format", "label": "Date format", "default": "%d.%m.%Y" },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show article excerpt", "default": true },

    { "type": "header", "content": "Related products" },
    { "type": "text", "id": "products_title", "label": "Products title", "default": "מוצרים מומלצים" },

    { "type": "header", "content": "Related guides" },
    { "type": "text", "id": "related_guides_title", "label": "Related guides title", "default": "Related Guides" },

    { "type": "header", "content": "Final CTA" },
    { "type": "text", "id": "cta_brand", "label": "CTA brand", "default": "HOOPERS" },
    { "type": "text", "id": "cta_title", "label": "CTA title", "default": "BORN TO PLAY" },
    { "type": "text", "id": "cta_button_text", "label": "CTA button text", "default": "SHOP NOW" },
    { "type": "url", "id": "cta_button_link", "label": "CTA button link" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Related product",
      "limit": 4,
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    },
    {
      "type": "guide",
      "name": "Related guide card",
      "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "category", "label": "Category label", "default": "NBA" },
        { "type": "text", "id": "title", "label": "Guide title", "default": "מדריך נוסף" },
        { "type": "textarea", "id": "description", "label": "Short description", "default": "תיאור קצר למדריך קשור." },
        { "type": "url", "id": "link", "label": "Guide link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "HOOPERS Guide Article",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        {
          "type": "guide",
          "settings": {
            "category": "NBA",
            "title": "מדריך מידות לגופיות NBA",
            "description": "איך לבחור גופייה שיושבת נכון."
          }
        },
        {
          "type": "guide",
          "settings": {
            "category": "STREETWEAR",
            "title": "איך לשלב מכנסי Jordan",
            "description": "רעיונות לסטייל ספורטיבי יומיומי."
          }
        },
        {
          "type": "guide",
          "settings": {
            "category": "BUYING GUIDE",
            "title": "איך לבחור את המידה הנכונה?",
            "description": "טיפים לפני הזמנה אונליין."
          }
        }
      ]
    }
  ]
}
{% endschema %}