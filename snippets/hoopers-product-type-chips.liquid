{% comment %}
  Renders product refinement chips from real Shopify filter values only.

  Each chip stays visible for UX consistency, but it becomes clickable only when
  collection.filters/search.filters contains a matching value with Shopify's
  native url_to_add/url_to_remove. No guessed filter URLs are generated here.

  Arguments:
  - filter_source: collection or search object
  - context: 'collection' or 'search'
{% endcomment %}

{%- liquid
  assign chip_definitions = 'גופיות::גופיות,גופיה,Jerseys,Jersey,NBA Jerseys|מכנסיים::מכנסיים,מכנסי,מכנס,Shorts,Pants|חולצות::חולצות,חולצה,Shirts,T-Shirts,T Shirt,טישרטים|ג׳קטים::ג׳קטים,גקטים,Jackets,Jacket,Winter,חורף,הודיז,Hoodies|כדורים::כדורים,כדור,Basketballs,Basketball|ילדים::ילדים,ילד,ילדות,Kids,Kids NBA' | split: '|'
-%}

<div class="hh-filter-refinement hh-filter-refinement--{{ context | default: 'catalog' }}" aria-label="Product type filters">
  <span>Filter by type</span>

  {%- for chip_definition in chip_definitions -%}
    {%- liquid
      assign chip_parts = chip_definition | split: '::'
      assign chip_label = chip_parts[0]
      assign aliases = chip_parts[1] | split: ','
      assign matched_value = blank
      assign matched_filter_label = blank
      assign matched_param_name = blank
      assign matched_value_raw = blank
      assign is_active = false
      assign is_available = false

      for filter in filter_source.filters
        for filter_value in filter.values
          assign value_downcase = filter_value.label | downcase

          for alias in aliases
            assign alias_clean = alias | strip
            assign alias_downcase = alias_clean | downcase

            if value_downcase == alias_downcase or value_downcase contains alias_downcase
              assign matched_value = filter_value
              assign matched_filter_label = filter.label
              assign matched_param_name = filter_value.param_name
              assign matched_value_raw = filter_value.value

              if filter_value.active
                assign is_active = true
                assign is_available = true
              elsif filter_value.count > 0
                assign is_available = true
              endif

              break
            endif
          endfor

          if matched_value != blank
            break
          endif
        endfor

        if matched_value != blank
          break
        endif
      endfor

      assign chip_url = ''
      if matched_value != blank and is_available
        if is_active
          assign chip_url = matched_value.url_to_remove
        else
          assign chip_url = matched_value.url_to_add
        endif
      endif
    -%}

    {%- if chip_url != blank -%}
      <a
        class="hh-filter-refinement__chip{% if is_active %} is-active{% endif %}"
        href="{{ chip_url }}"
        data-search-action="{% if is_active %}remove-type-filter{% else %}add-type-filter{% endif %}"
        data-hh-native-filter-chip
        data-hh-filter-label="{{ matched_filter_label | escape }}"
        data-hh-filter-param="{{ matched_param_name | escape }}"
        data-hh-filter-value="{{ matched_value_raw | escape }}"
      >
        {{ chip_label }}
        {%- if is_active -%}<b aria-hidden="true">×</b>{%- endif -%}
      </a>
    {%- else -%}
      <span
        class="hh-filter-refinement__chip is-disabled"
        aria-disabled="true"
        data-hh-native-filter-chip-disabled
        title="No native Shopify filter value is available for {{ chip_label | escape }}"
      >
        {{ chip_label }}
      </span>
    {%- endif -%}
  {%- endfor -%}
</div>
