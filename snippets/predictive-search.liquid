{%- liquid
  assign dark_search_bg = false
  assign lightness = settings.color_header_search | color_brightness

  if lightness <= 100
    assign dark_search_bg = true
  endif

  assign trending_collection = collections['הנמכרים-ביותר']
  assign new_collection = collections['חדש-באתר']
  assign best_collection = collections['הנמכרים-ביותר']
-%}

{%- if context == 'search-page' -%}
  <predictive-search data-context="{{ context }}" data-enabled="{{ settings.predictive_search_enabled }}" data-dark="{{ dark_search_bg }}">
    <div class="predictive__screen" data-screen></div>
    <form action="{{ routes.search_url }}" method="get" role="search">
      <label for="Search" class="hidden-label">Search</label>
      <div class="search__input-wrap">
        <input
          class="search__input"
          id="Search"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          role="combobox"
          aria-expanded="false"
          aria-owns="predictive-search-results"
          aria-controls="predictive-search-results"
          aria-haspopup="listbox"
          aria-autocomplete="list"
          autocorrect="off"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          placeholder="{{ 'general.search.placeholder' | t }}"
          tabindex="0"
        >
        <input name="options[prefix]" type="hidden" value="last">
        <button class="btn--search" type="submit">
          <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-search" viewBox="0 0 64 64"><defs><style>.cls-1{fill:none;stroke:#000;stroke-miterlimit:10;stroke-width:2px}</style></defs><path class="cls-1" d="M47.16 28.58A18.58 18.58 0 1 1 28.58 10a18.58 18.58 0 0 1 18.58 18.58zM54 54L41.94 42"/></svg>
          <span class="icon__fallback-text">{{ 'general.search.submit' | t }}</span>
        </button>
      </div>

      <button class="btn--close-search">
        <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewBox="0 0 64 64"><defs><style>.cls-1{fill:none;stroke:#000;stroke-miterlimit:10;stroke-width:2px}</style></defs><path class="cls-1" d="M19 17.61l27.12 27.13m0-27.13L19 44.74"/></svg>
      </button>
      <div id="predictive-search" class="search__results" tabindex="-1"></div>
    </form>
  </predictive-search>
{%- else -%}

<style>
  .hh-native-search {
    position: fixed !important;
    top: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    left: 0 !important;
    z-index: 2147483000 !important;
    display: block !important;
    width: 100vw !important;
    max-width: none !important;
    height: 100vh !important;
    height: 100dvh !important;
    margin: 0 !important;
    overflow: hidden !important;
    background: #050505 !important;
    opacity: 0;
    pointer-events: none;
    color: #f7f3ea;
    direction: rtl;
    transform: none !important;
    transition: opacity 220ms ease;
  }

  .hh-native-search.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .hh-native-search.hh-native-search--inactive-duplicate {
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .hh-native-search.is-active form,
  .hh-native-search.is-active .hh-native-search__inner,
  .hh-native-search.is-active .hh-native-search__top,
  .hh-native-search.is-active .search__input-wrap,
  .hh-native-search.is-active .hh-search-empty {
    visibility: visible !important;
    opacity: 1 !important;
  }

  html.hh-native-search-lock,
  body.hh-native-search-lock,
  body.predictive-overflow-hidden {
    overflow: hidden !important;
    height: 100% !important;
    touch-action: none;
  }

  .hh-native-search-container {
    overflow: visible !important;
  }

  .site-header__search-container.hh-native-search-container:not(.is-active) {
    display: none !important;
    height: 0 !important;
    overflow: hidden !important;
    visibility: hidden !important;
  }

  .hh-native-search-container.is-active {
    position: fixed !important;
    inset: 0 !important;
    bottom: auto !important;
    display: block !important;
    width: 100vw !important;
    height: 100vh !important;
    height: 100dvh !important;
    overflow: visible !important;
    z-index: 999999 !important;
  }

  .hh-native-search-container .hh-native-search-shell {
    position: fixed !important;
    inset: 0 !important;
    display: block !important;
    width: 100vw !important;
    height: 100vh !important;
    height: 100dvh !important;
    background: transparent !important;
    box-shadow: none !important;
    color: inherit !important;
    transform: none !important;
  }

  .hh-native-search-container .hh-native-search-page {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    height: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .hh-native-search .predictive__screen {
    position: fixed !important;
    inset: 0 !important;
    z-index: 1 !important;
    background: #050505;
    backdrop-filter: blur(8px);
  }

  .hh-native-search form {
    position: fixed !important;
    top: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    left: 0 !important;
    z-index: 2 !important;
    display: flex !important;
    flex-direction: column;
    width: 100vw !important;
    max-width: none !important;
    height: 100vh !important;
    height: 100dvh !important;
    margin: 0 !important;
    padding: clamp(22px, 4vw, 48px);
    overflow-y: auto;
    overflow-x: hidden;
    background:
      radial-gradient(circle at 18% 0%, rgba(200, 165, 106, 0.14), transparent 30%),
      linear-gradient(180deg, #070707 0%, #12100d 100%);
    border: 0;
    box-shadow: none;
    overscroll-behavior: contain;
  }

  .hh-native-search__inner {
    position: relative;
    z-index: 3;
    display: flex !important;
    flex-direction: column;
    width: min(1180px, 100%);
    height: 100%;
    min-height: 0;
    margin: 0 auto;
    padding-top: 10px;
    overflow: hidden;
  }

  .hh-native-search__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    flex: 0 0 auto;
    margin-bottom: 22px;
  }

  .hh-native-search__kicker {
    margin: 0 0 8px;
    color: #c8a56a;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .hh-native-search__heading {
    margin: 0;
    color: #fff;
    font-size: clamp(30px, 4vw, 52px);
    line-height: 1.03;
    font-weight: 900;
    letter-spacing: 0;
  }

  .hh-native-search .btn--close-search {
    position: fixed !important;
    top: clamp(16px, 3vw, 30px);
    right: clamp(16px, 3vw, 34px);
    z-index: 5 !important;
    flex: 0 0 auto;
    display: grid;
    width: 48px;
    height: 48px;
    min-width: 48px;
    padding: 0;
    place-items: center;
    border: 1px solid rgba(200, 165, 106, 0.55);
    border-radius: 999px;
    background: rgba(5, 5, 5, 0.82);
    color: #fff;
    cursor: pointer;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
  }

  .hh-native-search .btn--close-search svg,
  .hh-native-search .btn--close-search path {
    width: 18px;
    height: 18px;
    stroke: #fff !important;
  }

  .hh-native-search .search__input-wrap {
    position: relative;
    display: flex !important;
    align-items: center;
    gap: 10px;
    flex: 0 0 auto;
    margin: 0 0 30px;
    padding: 10px 10px 10px 18px;
    border: 1px solid rgba(200, 165, 106, 0.34);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
  }

  .hh-native-search .search__input {
    width: 100%;
    min-height: 56px;
    padding: 0 14px;
    border: 0;
    background: transparent;
    color: #fff !important;
    -webkit-text-fill-color: #fff !important;
    caret-color: #fff !important;
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 700;
    line-height: 1.2;
    text-align: right;
    outline: none;
  }

  .hh-native-search .search__input::placeholder {
    color: rgba(255, 255, 255, 0.55) !important;
    -webkit-text-fill-color: rgba(255, 255, 255, 0.55) !important;
  }

  .hh-native-search .btn--search {
    display: grid;
    width: 54px;
    height: 54px;
    min-width: 54px;
    padding: 0;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: #c8a56a;
    color: #050505;
    cursor: pointer;
  }

  .hh-native-search .btn--search svg,
  .hh-native-search .btn--search path {
    width: 20px;
    height: 20px;
    stroke: #050505 !important;
  }

  .hh-search-empty {
    display: grid !important;
    gap: clamp(28px, 4vw, 46px);
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0 2px 44px;
    scrollbar-width: thin;
    scrollbar-color: rgba(200, 165, 106, 0.55) rgba(255, 255, 255, 0.08);
  }

  .hh-search-section {
    display: grid;
    gap: 16px;
    padding-top: clamp(20px, 3vw, 30px);
    border-top: 1px solid rgba(255, 255, 255, 0.09);
  }

  .hh-search-section:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .hh-search-section__title {
    margin: 0;
    color: #fff;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hh-search-chips,
  .hh-search-links {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hh-search-chip,
  .hh-search-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 0 14px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.84);
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .hh-search-chip:hover,
  .hh-search-link:hover {
    transform: translateY(-1px);
    border-color: rgba(200, 165, 106, 0.7);
    background: rgba(200, 165, 106, 0.12);
    color: #fff;
  }

  .hh-search-rail {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 1.8vw, 18px);
    overflow: visible;
    scrollbar-width: none;
  }

  .hh-search-rail::-webkit-scrollbar {
    display: none;
  }

  .hh-search-product {
    min-width: 0;
    color: #fff;
    text-decoration: none;
  }

  .hh-search-product__media {
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 8px;
    background: #1a1a1a;
  }

  .hh-search-product__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 260ms ease;
  }

  .hh-search-product:hover img {
    transform: scale(1.045);
  }

  .hh-search-product__title {
    display: -webkit-box;
    min-height: 36px;
    margin: 10px 0 5px;
    overflow: hidden;
    color: #fff;
    font-size: 13px;
    line-height: 1.35;
    font-weight: 850;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .hh-search-product__price {
    color: #c8a56a;
    font-size: 13px;
    font-weight: 900;
  }

  .hh-native-search .search__results {
    display: none;
    min-height: 0 !important;
    max-height: none !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    padding: 6px 2px 44px !important;
    border: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    color: #fff !important;
    scrollbar-width: thin;
    scrollbar-color: rgba(200, 165, 106, 0.55) rgba(255, 255, 255, 0.08);
  }

  .hh-native-search .search__results * {
    color: inherit;
  }

  .hh-native-search .search__results[style*="block"] ~ .hh-search-empty {
    display: none;
  }

  .hh-native-search.hh-search-has-query .hh-search-empty {
    display: none !important;
  }

  .hh-native-search .predictive-search-results {
    display: grid;
    gap: 24px;
    color: #fff;
  }

  .hh-native-search-results {
    display: grid;
    gap: 28px;
    background: transparent !important;
    color: #fff;
  }

  .hh-native-search-results__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 1.8vw, 18px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hh-native-search-results__links {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hh-native-search-results__empty,
  .hh-native-search-results__loading {
    padding: 18px 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 15px;
    font-weight: 700;
  }

  .hh-native-search .predictive-search-results h3,
  .hh-native-search .predictive-search-results .h4 {
    color: #c8a56a;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hh-native-search .predictive-search-results ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 1.8vw, 18px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hh-native-search .predictive-search-results a {
    color: #fff;
    text-decoration: none;
  }

  .hh-native-search .predictive-result__layout,
  .hh-native-search .predictive-search__list-item a {
    border-color: rgba(255, 255, 255, 0.1) !important;
    background: rgba(255, 255, 255, 0.05);
  }

  .hh-native-search .grid-product__price,
  .hh-native-search .predictive-search__item-price {
    color: #c8a56a !important;
    font-weight: 900;
  }

  .hh-native-search .predictive-search__no-results,
  .hh-native-search .results__search-btn {
    color: #fff !important;
  }

  @media screen and (max-width: 749px) {
    .hh-native-search form {
      width: 100vw;
      height: 100vh;
      height: 100dvh;
      padding: 72px 16px 18px;
      border-inline-start: 0;
      overflow: hidden;
    }

    .hh-native-search__inner {
      padding-top: 0;
    }

    .hh-native-search__top {
      align-items: center;
      margin-bottom: 18px;
    }

    .hh-native-search__heading {
      font-size: 34px;
    }

    .hh-native-search .search__input {
      min-height: 46px;
      font-size: 16px;
    }

    .hh-native-search .search__input-wrap {
      position: relative;
      z-index: 4;
      margin-bottom: 22px;
      padding: 8px;
      background: rgba(14, 14, 14, 0.96);
      backdrop-filter: blur(12px);
    }

    .hh-native-search .search__results,
    .hh-search-empty {
      padding-bottom: 28px !important;
    }

    .hh-native-search .btn--close-search {
      top: 16px;
      right: 16px;
      width: 44px;
      height: 44px;
      min-width: 44px;
    }

    .hh-native-search .btn--search {
      width: 46px;
      height: 46px;
      min-width: 46px;
    }

    .hh-search-rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .hh-native-search .predictive-search-results ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .hh-native-search-results__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .hh-search-section {
      gap: 14px;
      padding-top: 24px;
    }
  }
</style>

<predictive-search class="hh-native-search" data-context="{{ context }}" data-enabled="false" data-dark="{{ dark_search_bg }}">
  <div class="predictive__screen" data-screen></div>

  <form action="{{ routes.search_url }}" method="get" role="search">
    <div class="hh-native-search__inner">
      <div class="hh-native-search__top">
        <div>
          <p class="hh-native-search__kicker">HOOPERS SEARCH</p>
          <h2 class="hh-native-search__heading">מה אתם מחפשים?</h2>
        </div>

        <button class="btn--close-search" type="button" aria-label="סגירת חיפוש">
          <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewBox="0 0 64 64"><path d="M19 17.61l27.12 27.13m0-27.13L19 44.74"/></svg>
        </button>
      </div>

      <label for="Search-{{ context }}" class="hidden-label">Search</label>
      <div class="search__input-wrap">
        <input
          class="search__input"
          id="Search-{{ context }}"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          role="combobox"
          aria-expanded="false"
          aria-owns="predictive-search-results"
          aria-controls="predictive-search-results"
          aria-haspopup="listbox"
          aria-autocomplete="list"
          autocorrect="off"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          placeholder="חפשו קבוצה, שחקן, גופיה או מותג..."
          tabindex="0"
        >
        <input name="options[prefix]" type="hidden" value="last">
        <button class="btn--search" type="submit" aria-label="חיפוש">
          <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-search" viewBox="0 0 64 64"><path d="M47.16 28.58A18.58 18.58 0 1 1 28.58 10a18.58 18.58 0 0 1 18.58 18.58zM54 54L41.94 42"/></svg>
          <span class="icon__fallback-text">{{ 'general.search.submit' | t }}</span>
        </button>
      </div>

      <div id="predictive-search" class="search__results" tabindex="-1"></div>

      <div class="hh-search-empty" data-hh-search-empty>
      <section class="hh-search-section" aria-labelledby="hh-popular-searches-{{ context }}">
        <h3 class="hh-search-section__title" id="hh-popular-searches-{{ context }}">Popular Searches</h3>
        <ul class="hh-search-chips">
          <li><a class="hh-search-chip" href="{{ routes.search_url }}?q={{ 'דני אבדיה' | url_encode }}">דני אבדיה</a></li>
          <li><a class="hh-search-chip" href="/collections/לוס-אנגלס-לייקרס">לייקרס</a></li>
          <li><a class="hh-search-chip" href="/collections/גולדן-סטייט-ווריוס">גולדן סטייט</a></li>
          <li><a class="hh-search-chip" href="/collections/fog">Fear Of God</a></li>
          <li><a class="hh-search-chip" href="/collections/jordan">Jordan</a></li>
          <li><a class="hh-search-chip" href="/collections/מונדיאל">World Cup</a></li>
          <li><a class="hh-search-chip" href="/collections/ילדים">Kids</a></li>
        </ul>
      </section>

      {%- if trending_collection != blank and trending_collection.products_count > 0 -%}
        <section class="hh-search-section" aria-labelledby="hh-trending-products-{{ context }}">
          <h3 class="hh-search-section__title" id="hh-trending-products-{{ context }}">Trending Products</h3>
          <div class="hh-search-rail">
            {%- for item_product in trending_collection.products limit: 4 -%}
              <a class="hh-search-product" href="{{ item_product.url }}">
                <span class="hh-search-product__media">
                  {%- if item_product.featured_image -%}
                    {{ item_product.featured_image | image_url: width: 420 | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 42vw, 160px', alt: item_product.title }}
                  {%- endif -%}
                </span>
                <span class="hh-search-product__title">{{ item_product.title }}</span>
                <span class="hh-search-product__price">{{ item_product.price | money }}</span>
              </a>
            {%- endfor -%}
          </div>
        </section>
      {%- endif -%}

      {%- if new_collection != blank and new_collection.products_count > 0 -%}
        <section class="hh-search-section" aria-labelledby="hh-new-arrivals-{{ context }}">
          <h3 class="hh-search-section__title" id="hh-new-arrivals-{{ context }}">New Arrivals</h3>
          <div class="hh-search-rail">
            {%- for item_product in new_collection.products limit: 4 -%}
              <a class="hh-search-product" href="{{ item_product.url }}">
                <span class="hh-search-product__media">
                  {%- if item_product.featured_image -%}
                    {{ item_product.featured_image | image_url: width: 420 | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 42vw, 160px', alt: item_product.title }}
                  {%- endif -%}
                </span>
                <span class="hh-search-product__title">{{ item_product.title }}</span>
                <span class="hh-search-product__price">{{ item_product.price | money }}</span>
              </a>
            {%- endfor -%}
          </div>
        </section>
      {%- endif -%}

      {%- if best_collection != blank and best_collection.products_count > 0 -%}
        <section class="hh-search-section" aria-labelledby="hh-best-sellers-{{ context }}">
          <h3 class="hh-search-section__title" id="hh-best-sellers-{{ context }}">Best Sellers</h3>
          <div class="hh-search-rail">
            {%- for item_product in best_collection.products limit: 4 -%}
              <a class="hh-search-product" href="{{ item_product.url }}">
                <span class="hh-search-product__media">
                  {%- if item_product.featured_image -%}
                    {{ item_product.featured_image | image_url: width: 420 | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 42vw, 160px', alt: item_product.title }}
                  {%- endif -%}
                </span>
                <span class="hh-search-product__title">{{ item_product.title }}</span>
                <span class="hh-search-product__price">{{ item_product.price | money }}</span>
              </a>
            {%- endfor -%}
          </div>
        </section>
      {%- endif -%}

      <section class="hh-search-section" aria-labelledby="hh-shop-by-team-{{ context }}">
        <h3 class="hh-search-section__title" id="hh-shop-by-team-{{ context }}">Shop By Team</h3>
        <ul class="hh-search-links">
          <li><a class="hh-search-link" href="/collections/לוס-אנגלס-לייקרס">Lakers</a></li>
          <li><a class="hh-search-link" href="/collections/גולדן-סטייט-ווריוס">Warriors</a></li>
          <li><a class="hh-search-link" href="/collections/nicks">Knicks</a></li>
          <li><a class="hh-search-link" href="/collections/בוסטון-סלטיקס">Celtics</a></li>
          <li><a class="hh-search-link" href="/collections/san-antonio-spurs">Spurs</a></li>
          <li><a class="hh-search-link" href="/collections/פורטלנד-טרייל-בלייזרס">Trail Blazers</a></li>
          <li><a class="hh-search-link" href="/collections/oklahoma-city-thunder">Thunder</a></li>
          <li><a class="hh-search-link" href="/collections/שיקגו-בולס">Bulls</a></li>
        </ul>
      </section>

      <section class="hh-search-section" aria-labelledby="hh-featured-collections-{{ context }}">
        <h3 class="hh-search-section__title" id="hh-featured-collections-{{ context }}">Featured Collections</h3>
        <ul class="hh-search-links">
          <li><a class="hh-search-link" href="/collections/גופיות">NBA Jerseys</a></li>
          <li><a class="hh-search-link" href="/collections/מונדיאל">World Cup</a></li>
          <li><a class="hh-search-link" href="/collections/fog">Fear Of God</a></li>
          <li><a class="hh-search-link" href="/collections/jordan">Jordan</a></li>
          <li><a class="hh-search-link" href="/collections/ילדים">Kids</a></li>
          <li><a class="hh-search-link" href="/collections/pro-gear">Pro Gear</a></li>
        </ul>
      </section>

      <section class="hh-search-section" data-hh-recent-search-section hidden>
        <h3 class="hh-search-section__title">Recently Viewed</h3>
        <div class="hh-search-rail" data-hh-recent-search-items></div>
      </section>
      </div>
    </div>
  </form>

  {%- if product != blank -%}
    <script type="application/json" data-hh-current-product>
      {
        "title": {{ product.title | json }},
        "url": {{ product.url | json }},
        "price": {{ product.price | money | json }},
        "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 420 | json }}{% else %}""{% endif %}
      }
    </script>
  {%- endif -%}

  <script>
    if (!window.HoopersNativeSearchInit) {
      window.HoopersNativeSearchInit = true;

      (function () {
        var key = 'hoopers_recently_viewed_products';
        var currentProductScript = document.querySelector('[data-hh-current-product]');
        var allowClose = false;

        document.querySelectorAll('.hh-native-search').forEach(function (root) {
          var container = root.closest('.site-header__search-container');
          var shell = root.closest('.site-header__search');
          var page = root.closest('.page-width');

          if (container) container.classList.add('hh-native-search-container');
          if (shell) shell.classList.add('hh-native-search-shell');
          if (page) page.classList.add('hh-native-search-page');
        });

        function setSearchLock(isLocked) {
          document.documentElement.classList.toggle('hh-native-search-lock', isLocked);
          document.body.classList.toggle('hh-native-search-lock', isLocked);
        }

        function getActiveRoots() {
          return Array.prototype.slice.call(document.querySelectorAll('.hh-native-search.is-active'));
        }

        function resetNativeSearchRoots() {
          document.querySelectorAll('.hh-native-search').forEach(function (root) {
            root.classList.remove('is-active', 'hh-search-has-query', 'hh-native-search--inactive-duplicate');
            root.style.visibility = '';
            root.style.opacity = '';

            var results = root.querySelector('.search__results');
            if (results) {
              results.style.display = 'none';
              results.innerHTML = '';
            }
          });

          document.querySelectorAll('.site-header__search-container').forEach(function (container) {
            if (!container.querySelector('.hh-native-search')) return;
            container.classList.remove('is-active', 'is-open', 'site-header__search-container--open');
            container.setAttribute('aria-hidden', 'true');
          });

          document.querySelectorAll('.site-header').forEach(function (header) {
            header.classList.remove('site-header--search-open', 'site-header--is-searching');
          });
        }

        function resetOpenState(root) {
          if (!root) return;

          root.classList.remove('hh-search-has-query');

          var input = root.querySelector('input[type="search"]');
          var results = root.querySelector('.search__results');
          var emptyState = root.querySelector('[data-hh-search-empty]');

          if (input) input.value = '';

          if (results) {
            results.style.display = 'none';
            results.innerHTML = '';
          }

          if (emptyState) {
            emptyState.style.display = '';
            emptyState.scrollTop = 0;
          }
        }

        function closeNativeSearch() {
          allowClose = true;
          if (searchAbortController) searchAbortController.abort();
          window.clearTimeout(searchTimer);
          resetNativeSearchRoots();
          setSearchLock(false);
          document.body.classList.remove('predictive-overflow-hidden');
          document.documentElement.classList.remove('js-drawer-open', 'js-drawer-open--search', 'js-drawer-closing');

          window.setTimeout(function () {
            allowClose = false;
          }, 120);
        }

        function syncQueryState(root) {
          if (!root) return;
          var input = root.querySelector('input[type="search"]');
          var hasQuery = !!(input && input.value.trim());
          root.classList.toggle('hh-search-has-query', hasQuery);
        }

        function isUsableRoot(root) {
          var header = root.closest('.site-header');
          var container = root.closest('.site-header__search-container');
          var headerStyle = header ? window.getComputedStyle(header) : null;
          var containerStyle = container ? window.getComputedStyle(container) : null;

          return (!headerStyle || headerStyle.display !== 'none') && (!containerStyle || containerStyle.display !== 'none');
        }

        function isPreferredViewportRoot(root) {
          var header = root.closest('.site-header');
          var isMobile = window.matchMedia('(max-width: 768px)').matches;

          if (!header) return false;
          return isMobile ? header.classList.contains('hh-mobile-header') : header.classList.contains('hh-desktop-header');
        }

        function activateVisibleSearchRoot() {
          var roots = Array.prototype.slice.call(document.querySelectorAll('.hh-native-search'));
          var activeRoots = roots.filter(function (root) { return root.classList.contains('is-active'); });
          var chosenRoot = activeRoots.find(isPreferredViewportRoot) || activeRoots.find(isUsableRoot) || roots.find(isPreferredViewportRoot) || roots.find(isUsableRoot) || activeRoots[0] || roots[0];

          roots.forEach(function (root) {
            root.classList.toggle('hh-native-search--inactive-duplicate', !!chosenRoot && root !== chosenRoot);
          });

          if (chosenRoot) {
            var container = chosenRoot.closest('.site-header__search-container');
            var form = chosenRoot.querySelector('form');
            var input = chosenRoot.querySelector('input[type="search"]');

            if (container) {
              container.classList.add('is-active', 'is-open', 'site-header__search-container--open');
              container.removeAttribute('hidden');
              container.setAttribute('aria-hidden', 'false');
            }

            chosenRoot.classList.add('is-active');
            chosenRoot.style.visibility = 'visible';
            chosenRoot.style.opacity = '1';

            if (form) {
              form.style.visibility = 'visible';
              form.style.opacity = '1';
            }

            window.setTimeout(function () {
              if (input) input.focus();
            }, 90);
          }
        }

        function escapeHtml(value) {
          return String(value || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
        }

        function getProductImage(product) {
          if (product.image) return product.image;
          if (product.featured_image && product.featured_image.url) return product.featured_image.url;
          if (product.featured_image) return product.featured_image;
          return '';
        }

        function getProductPrice(product) {
          if (product.price) return product.price;
          if (product.price_min) return product.price_min;
          if (product.variants && product.variants[0] && product.variants[0].price) return product.variants[0].price;
          return '';
        }

        function renderProductCard(product) {
          var image = getProductImage(product);
          var price = getProductPrice(product);
          var imageMarkup = image ? '<span class="hh-search-product__media"><img src="' + escapeHtml(image) + '" loading="lazy" alt="' + escapeHtml(product.title) + '"></span>' : '<span class="hh-search-product__media"></span>';
          var priceMarkup = price ? '<span class="hh-search-product__price">' + price + '</span>' : '';

          return '<li><a class="hh-search-product" href="' + escapeHtml(product.url) + '">' + imageMarkup + '<span class="hh-search-product__title">' + escapeHtml(product.title) + '</span>' + priceMarkup + '</a></li>';
        }

        function normalizeUrl(url) {
          if (!url) return '';
          try {
            var parsed = new URL(url, window.location.origin);
            return parsed.pathname + parsed.search;
          } catch (error) {
            return url;
          }
        }

        function normalizeProductKey(url) {
          if (!url) return '';
          try {
            return new URL(url, window.location.origin).pathname;
          } catch (error) {
            return url.split('?')[0];
          }
        }

        function getCleanImageSource(image) {
          if (!image) return '';

          var srcset = image.getAttribute('data-srcset') || image.getAttribute('srcset') || '';
          var src = image.getAttribute('data-src') || image.getAttribute('data-original') || image.getAttribute('data-image') || image.getAttribute('src') || '';

          if (srcset) {
            src = srcset.split(',').pop().trim().split(' ')[0] || src;
          }

          if (src && src.indexOf('{width}') > -1) {
            src = src.replace('{width}', '540');
          }

          if (src && src.indexOf('//') === 0) src = window.location.protocol + src;
          return src || '';
        }

        function getImageFromElement(card) {
          var images = Array.prototype.slice.call(card.querySelectorAll('img'));
          if (!images.length) return '';

          for (var i = 0; i < images.length; i += 1) {
            var source = getCleanImageSource(images[i]);
            if (source && source.indexOf('placeholder') === -1 && source.indexOf('no-image') === -1) {
              return source;
            }
          }

          return getCleanImageSource(images[0]);
        }

        function getProductTitleFromCard(card, link) {
          var titleNode = card.querySelector('.grid-product__title, .grid-product__meta .grid-product__title, .spf-product-card__title a, .spf-product-card__title, .spf-product__title, [class*="product__title"], [class*="product-title"]');
          var title = titleNode ? titleNode.textContent.trim() : '';
          var image = card.querySelector('img');

          if (!title && link) title = link.getAttribute('title') || link.getAttribute('aria-label') || '';
          if (!title && image) title = image.getAttribute('alt') || '';
          if (!title && card.getAttribute('data-product-handle')) title = card.getAttribute('data-product-handle').replace(/-/g, ' ');

          return title.replace(/\s+/g, ' ').trim();
        }

        function getProductPriceFromCard(card) {
          var priceNode = card.querySelector('.grid-product__price, .grid-product__price--current, .spf-product__price, .spf-product-card__price, [class*="product__price"], [class*="product-price"], [class*="price"]');
          return priceNode ? priceNode.textContent.replace(/\s+/g, ' ').trim() : '';
        }

        function extractProductsFromSearchHtml(html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var links = Array.prototype.slice.call(doc.querySelectorAll('a[href*="/products/"]'));
          var seen = {};
          var products = [];

          links.forEach(function (link) {
            var card = link.closest('.grid-product, .spf-product-card, [data-product-card], .grid__item, li, article') || link;
            var rawUrl = link.getAttribute('href') || '';
            var url = normalizeUrl(rawUrl);
            var key = normalizeProductKey(rawUrl);

            if (!url || !key || seen[key]) return;

            var title = getProductTitleFromCard(card, link);
            if (!title) return;

            seen[key] = true;
            products.push({
              title: title,
              url: url,
              price: getProductPriceFromCard(card),
              image: getImageFromElement(card)
            });
          });

          return products.slice(0, 8);
        }

        function renderSearchPageProducts(root, searchTerm, products) {
          var results = root && root.querySelector('.search__results');
          if (!results) return;

          var html = '<div class="hh-native-search-results">';

          if (products.length) {
            html += '<section class="hh-search-section"><h3 class="hh-search-section__title">Products</h3><ul class="hh-native-search-results__grid">';
            html += products.map(renderProductCard).join('');
            html += '</ul></section>';
            html += '<section class="hh-search-section"><h3 class="hh-search-section__title">Suggested Search</h3><ul class="hh-native-search-results__links">';
            html += '<li><a class="hh-search-link" href="{{ routes.search_url }}?type=product&q=' + encodeURIComponent(searchTerm) + '">Search "' + escapeHtml(searchTerm) + '"</a></li>';
            html += '</ul></section>';
          } else {
            html += '<div class="hh-native-search-results__empty">No results found for "' + escapeHtml(searchTerm) + '".</div>';
          }

          html += '</div>';
          results.innerHTML = html;
          results.style.display = 'block';
          results.style.background = 'transparent';
          root.classList.add('hh-search-has-query');
          setSearchLock(true);
          activateVisibleSearchRoot();
        }

        var activeSearchRequestId = 0;
        var searchAbortController = null;
        var searchTimer = null;

        function clearVisibleSearchResults(root) {
          var results = root && root.querySelector('.search__results');
          if (!results) return;

          results.style.display = 'none';
          results.innerHTML = '';
          results.style.background = 'transparent';
          root.classList.remove('hh-search-has-query');
        }

        function runSearchPageAutocomplete(root, searchTerm) {
          var results = root && root.querySelector('.search__results');
          if (!root || !results || searchTerm.length < 2) return;

          if (searchAbortController) {
            searchAbortController.abort();
          }

          searchAbortController = new AbortController();
          activeSearchRequestId += 1;
          var requestId = activeSearchRequestId;
          var url = '{{ routes.search_url }}?q=' + encodeURIComponent(searchTerm) + '&type=product';

          results.innerHTML = '<div class="hh-native-search-results"><div class="hh-native-search-results__loading">Searching...</div></div>';
          results.style.display = 'block';
          results.style.background = 'transparent';
          root.classList.add('hh-search-has-query');

          fetch(url, { signal: searchAbortController.signal })
            .then(function (response) {
              if (!response.ok) throw new Error(response.status);
              return response.text();
            })
            .then(function (html) {
              if (requestId !== activeSearchRequestId) return;
              renderSearchPageProducts(root, searchTerm, extractProductsFromSearchHtml(html));
            })
            .catch(function (error) {
              if (error.name === 'AbortError') return;
              if (requestId !== activeSearchRequestId) return;
              renderSearchPageProducts(root, searchTerm, []);
            });
        }

        function handleNativeSearchInput(input) {
          var root = input && input.closest('.hh-native-search');
          var searchTerm = input ? input.value.trim() : '';

          syncQueryState(root);

          if (!root) return;

          if (searchTerm.length < 2) {
            if (searchAbortController) searchAbortController.abort();
            window.clearTimeout(searchTimer);
            clearVisibleSearchResults(root);
            setSearchLock(true);
            activateVisibleSearchRoot();
            return;
          }

          window.clearTimeout(searchTimer);
          searchTimer = window.setTimeout(function () {
            runSearchPageAutocomplete(root, searchTerm);
          }, 160);
        }

        function bindNativeSearchInputs() {
          document.querySelectorAll('.hh-native-search input[type="search"]').forEach(function (input) {
            if (input.dataset.hhNativeSearchBound === 'true') return;
            input.dataset.hhNativeSearchBound = 'true';

            input.addEventListener('input', function (event) {
              event.stopPropagation();
              event.stopImmediatePropagation();
              handleNativeSearchInput(input);
            }, true);

            input.addEventListener('keyup', function () {
              handleNativeSearchInput(input);
            });

            input.addEventListener('compositionend', function () {
              handleNativeSearchInput(input);
            });

            input.addEventListener('change', function () {
              handleNativeSearchInput(input);
            });
          });
        }
        function readRecent() {
          try {
            return JSON.parse(window.localStorage.getItem(key) || '[]');
          } catch (error) {
            return [];
          }
        }

        function writeRecent(items) {
          try {
            window.localStorage.setItem(key, JSON.stringify(items.slice(0, 8)));
          } catch (error) {}
        }

        if (currentProductScript) {
          try {
            var currentProduct = JSON.parse(currentProductScript.textContent || '{}');
            if (currentProduct && currentProduct.url) {
              var recent = readRecent().filter(function (item) { return item.url !== currentProduct.url; });
              recent.unshift(currentProduct);
              writeRecent(recent);
            }
          } catch (error) {}
        }

        function renderRecent() {
          var recent = readRecent();
          document.querySelectorAll('[data-hh-recent-search-section]').forEach(function (section) {
            var target = section.querySelector('[data-hh-recent-search-items]');
            if (!target || !recent.length) return;

            target.innerHTML = recent.slice(0, 4).map(function (item) {
              var safeTitle = String(item.title || '').replace(/"/g, '&quot;');
              var image = item.image ? '<span class="hh-search-product__media"><img src="' + item.image + '" loading="lazy" alt="' + safeTitle + '"></span>' : '<span class="hh-search-product__media"></span>';
              return '<a class="hh-search-product" href="' + item.url + '">' + image + '<span class="hh-search-product__title">' + item.title + '</span><span class="hh-search-product__price">' + item.price + '</span></a>';
            }).join('');

            section.hidden = false;
          });
        }

        document.addEventListener('predictive-search:open', function () {
          bindNativeSearchInputs();
          setSearchLock(true);
          window.setTimeout(function () {
            bindNativeSearchInputs();
            activateVisibleSearchRoot();
            var activeRoot = document.querySelector('.hh-native-search.is-active:not(.hh-native-search--inactive-duplicate)');
            resetOpenState(activeRoot);
            document.querySelectorAll('.hh-native-search').forEach(syncQueryState);
            renderRecent();
          }, 60);
        });

        document.addEventListener('click', function (event) {
          var trigger = event.target.closest('.js-search-header, a[href$="/search"], a[href*="/search?"]');
          if (!trigger || trigger.closest('.hh-native-search')) return;

          var isHeaderTrigger = !!trigger.closest('.hh-header, .site-header, .header-wrapper');
          if (!isHeaderTrigger) return;

          event.preventDefault();

          document.dispatchEvent(new CustomEvent('predictive-search:open', {
            detail: { context: 'header' },
            bubbles: true
          }));

          window.setTimeout(activateVisibleSearchRoot, 30);
        }, true);

        document.addEventListener('predictive-search:close-all', function (event) {
          if (!getActiveRoots().length || allowClose) return;

          event.preventDefault();
          event.stopPropagation();
          event.stopImmediatePropagation();
          setSearchLock(true);
          window.setTimeout(activateVisibleSearchRoot, 0);
        }, true);

        document.addEventListener('predictive-search:close', function (event) {
          if (!getActiveRoots().length || allowClose) return;

          event.preventDefault();
          event.stopPropagation();
          event.stopImmediatePropagation();
          setSearchLock(true);
          window.setTimeout(activateVisibleSearchRoot, 0);
        }, true);

        document.addEventListener('click', function (event) {
          var closeButton = event.target.closest('.hh-native-search .btn--close-search');
          if (!closeButton) return;

          event.preventDefault();
          event.stopPropagation();
          event.stopImmediatePropagation();
          closeNativeSearch();
        }, true);

        document.addEventListener('keydown', function (event) {
          if (event.key !== 'Escape' && event.key !== 'Esc') return;
          if (!getActiveRoots().length) return;

          event.preventDefault();
          closeNativeSearch();
        }, true);

        document.addEventListener('input', function (event) {
          if (!event.target.matches('.hh-native-search input[type="search"]')) return;

          event.stopPropagation();
          event.stopImmediatePropagation();

          handleNativeSearchInput(event.target);
        }, true);

        document.addEventListener('keyup', function (event) {
          if (!event.target.matches('.hh-native-search input[type="search"]')) return;
          handleNativeSearchInput(event.target);
        }, true);

        document.addEventListener('compositionend', function (event) {
          if (!event.target.matches('.hh-native-search input[type="search"]')) return;
          handleNativeSearchInput(event.target);
        }, true);

        bindNativeSearchInputs();
        document.addEventListener('DOMContentLoaded', bindNativeSearchInputs);

        if (window.MutationObserver) {
          new MutationObserver(function () {
            bindNativeSearchInputs();
          }).observe(document.documentElement, {
            childList: true,
            subtree: true
          });
        }
      })();
    }
  </script>
</predictive-search>
{%- endif -%}
